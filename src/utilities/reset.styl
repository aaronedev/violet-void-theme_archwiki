// =============================================================================
// Reset Utilities - CSS `all` property shorthand
// =============================================================================
// The `all` property is a shorthand that resets all CSS properties.
// Browser support: 97%+
// Usage:
//   .reset-all { all: unset; }
//   .reset-inherit { all: inherit; }
//   .reset-initial { all: initial; }
//   .reset-revert { all: revert; }
//   .reset-revert-layer { all: revert-layer; }
// Note: `all: unset` acts as `initial` for inherited properties and
// `inherit` for non-inherited properties (the "unset" behavior).

// Reset all properties to initial values
.all-initial
  all initial

// Reset all properties to inherited values
.all-inherit
  all inherit

// Reset all properties to user-agent stylesheet default
.all-unset
  all unset

// Reset all properties to cascade layer or user-agent stylesheet
.all-revert
  all revert

// Reset all properties to previous cascade layer
.all-revert-layer
  all revert-layer

// Common utility classes
// Use these for specific reset scenarios

// Remove all styling (start fresh)
.reset-all
  all unset
  background transparent
  border none
  outline none

// Reset for form elements
.reset-form
  all unset
  font inherit
  color inherit

// Reset for button elements
.reset-button
  all unset
  background transparent
  border none
  padding 0
  margin 0
  font inherit
  cursor pointer

// Reset for link elements
.reset-link
  all unset
  color inherit
  text-decoration inherit

// Reset for list elements
.reset-list
  all unset
  list-style none
  padding 0
  margin 0

// Reset for image elements
.reset-image
  all unset
  max-width 100%
  height auto
  display block

// Reset for table elements
.reset-table
  all unset
  border-collapse collapse
  border-spacing 0
