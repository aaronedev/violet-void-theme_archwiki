
// =============================================================================
// @FONT-FACE DESCRIPTOR UTILITY CLASSES
// =============================================================================
// Browser support: 97%+
// These utility classes provide common @font-face descriptor values
// that can be applied to @font-face rules or used directly

// Font-display descriptor utilities
// Controls how fonts are loaded and displayed
.font-display-swap
  font-display swap

.font-display-optional
  font-display optional

.font-display-block
  font-display block

.font-display-fallback
  font-display fallback

// Size-adjust descriptor utilities
// Adjusts metric compatibility between fonts
.size-adjust-95
  size-adjust 95%

.size-adjust-100
  size-adjust 100%

.size-adjust-105
  size-adjust 105%

.size-adjust-110
  size-adjust 110%

.size-adjust-auto
  size-adjust auto

// Ascent-override descriptor utilities
// Overrides the ascent metric for a font
.ascent-override-90
  ascent-override 90%

.ascent-override-95
  ascent-override 95%

.ascent-override-100
  ascent-override 100%

.ascent-override-normal
  ascent-override normal

// Descent-override descriptor utilities
// Overrides the descent metric for a font
.descent-override-20
  descent-override 20%

.descent-override-22
  descent-override 22%

.descent-override-25
  descent-override 25%

.descent-override-normal
  descent-override normal

// Line-gap-override descriptor utilities
// Overrides the line-gap metric for a font
.line-gap-override-0
  line-gap-override 0%

.line-gap-override-5
  line-gap-override 5%

.line-gap-override-normal
  line-gap-override normal

// Combined utility classes for common font metric corrections
// Use these for loading fallback fonts with better metric matching
.font-metric-matched
  size-adjust 95%
  ascent-override 95%
  descent-override 20%
  line-gap-override 0%

.font-metric-tight
  size-adjust 105%
  ascent-override 105%
  descent-override 25%
  line-gap-override 5%
