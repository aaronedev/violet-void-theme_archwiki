// Edit history styling for Violet Void ArchWiki
// Revision list, timestamps, rollback/undo buttons

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// EDIT HISTORY LIST
// =============================================================================

// Revision row styling
#pagehistory
.mw-history-list
  list-style none
  padding 0
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden

  li
    padding 0.6em 1em
    border-bottom 1px solid $border-subtle
    display flex
    flex-wrap wrap
    gap 0.5em
    align-items center
    transition background-color 0.2s ease

    &:hover
      background-color rgba($arch-blue, 0.03)

    &:last-child
      border-bottom none

// User avatar/link styling
.history-user
  a
    color $secondary-blue
    font-weight 500

    &:hover
      color $arch-blue

// Timestamp with tabular-nums
.mw-history-histlinks
.history-timestamp
  font-variant-numeric tabular-nums
  color $muted
  font-size 0.85em
  white-space nowrap

// Edit summary
.comment
.history-summary
  font-style italic
  color $light
  max-width 30em
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// Rollback/undo button styling
.mw-history-undo
.mw-rollback-link
  a
    display inline-block
    padding 0.2em 0.5em
    font-size 0.8em
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue
    border-radius $border-radius-sm
    text-decoration none

    &:hover
      background-color $arch-blue
      color $darker

// Minor edit indicator
.minor-edit
  font-size 0.75em
  padding 0.1em 0.3em
  background-color rgba($muted, 0.2)
  color $muted
  border-radius $border-radius-sm
  text-transform uppercase

// Current revision marker
.mw-history-selected
  background-color rgba($arch-blue, 0.08)

// Tag indicators
.mw-tag-markers
  font-size 0.75em

  span
    display inline-block
    padding 0.1em 0.4em
    margin 0.1em
    background-color rgba($purple, 0.15)
    color $purple
    border-radius $border-radius-sm

// History pagination
.mw-history-paginator
  display flex
  justify-content center
  gap 0.5em
  padding 1em
  background-color $darker
  border-radius $border-radius-md
  margin-top 1em

  a
    padding 0.3em 0.6em
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue
    border-radius $border-radius-sm
    text-decoration none

    &:hover
      background-color $arch-blue
      color $darker

    &.mw-prev-link
    &.mw-next-link
      font-weight 600


// =============================================================================
// ENHANCED EDIT HISTORY STYLING
// =============================================================================

// History form (revision comparison selector)
.mw-history-compareform
.history-form
  padding 1em
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.03))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  margin-bottom 1em
  display flex
  flex-wrap wrap
  gap 1em
  align-items center

  .mw-history-comparelabel
    color $muted
    font-size 0.9em

  .mw-history-comparebutton
    padding 0.5em 1em
    background-color $arch-blue
    border none
    border-radius $border-radius-sm
    color $darker
    font-weight 500
    cursor pointer
    transition all 0.2s ease

    &:hover
      background-color rgba($arch-blue, 0.8)
      transform translateY(-1px)

// Revision radio buttons for comparison
.mw-history-revisionradio
  margin-right 0.5em
  accent-color $arch-blue

// Enhanced revision row
#pagehistory li
.history-revision
  position relative
  padding-left 2.5em

  // Radio button positioning
  input[type="radio"]
    position absolute
    left 0.75em
    top 50%
    transform translateY(-50%)

// Current revision highlight
.mw-history-selected
.history-current
  background linear-gradient(135deg, rgba($arch-blue, 0.08), rgba($arch-blue, 0.03))
  border-left 3px solid $arch-blue

  &::before
    content "Current"
    position absolute
    right 0.75em
    top 0.25em
    font-size 0.65em
    text-transform uppercase
    letter-spacing 0.05em
    padding 0.2em 0.5em
    background-color $arch-blue
    color $darker
    border-radius 2px
    font-weight 600

// User info with avatar placeholder
.history-user-info
  display flex
  align-items center
  gap 0.5em

  .user-avatar
    width 20px
    height 20px
    border-radius 50%
    background-color $darker
    border 1px solid $border-subtle
    overflow hidden
    display flex
    align-items center
    justify-content center
    font-size 0.6em
    color $muted

  .user-link
    color $secondary-blue
    text-decoration none
    font-weight 500

    &:hover
      color $arch-blue
      text-decoration underline

    &.mw-anonuserlink
      color rgba($orange, 0.8)

// Enhanced timestamp
.history-datetime
  display flex
  flex-direction column
  gap 0.1em
  min-width 8em

  .history-date
    font-variant-numeric tabular-nums
    color $lighter
    font-size 0.9em

  .history-time
    font-variant-numeric tabular-nums
    color $muted
    font-size 0.8em

// Bytes changed indicator
.history-size
  font-variant-numeric tabular-nums
  font-size 0.8em
  padding 0.15em 0.4em
  border-radius 3px
  white-space nowrap

  &.mw-plusminus-pos
  &.size-positive
    background-color rgba($green, 0.15)
    color $green

    &::before
      content "+"

  &.mw-plusminus-neg
  &.size-negative
    background-color rgba($secondary-red, 0.15)
    color $secondary-red

  &.mw-plusminus-zero
  &.size-neutral
    color $muted

// Enhanced edit summary
.history-comment
.mw-comment
  flex-basis 100%
  margin-top 0.3em
  padding 0.4em 0.6em
  background-color rgba($arch-blue, 0.05)
  border-left 2px solid rgba($arch-blue, 0.3)
  border-radius 0 $border-radius-sm $border-radius-sm 0
  font-style italic
  color $light
  font-size 0.9em
  line-height 1.4

  .autocomment
    color $muted

    a
      color $secondary-blue

// Action buttons container
.history-actions
  display flex
  gap 0.5em
  margin-left auto
  flex-wrap wrap

// Enhanced rollback/undo buttons
.mw-history-undo
.mw-rollback-link
.mw-thanks-link
  a
    display inline-flex
    align-items center
    gap 0.3em
    padding 0.3em 0.6em
    font-size 0.75em
    font-weight 500
    text-transform uppercase
    letter-spacing 0.03em
    border-radius $border-radius-sm
    text-decoration none
    transition all 0.2s ease

.mw-history-undo a
  background-color rgba($secondary-red, 0.15)
  color $secondary-red

  &:hover
    background-color $secondary-red
    color $darker

.mw-rollback-link a
  background-color rgba($orange, 0.15)
  color $orange

  &:hover
    background-color $orange
    color $darker

.mw-thanks-link a
  background-color rgba($green, 0.15)
  color $green

  &:hover
    background-color $green
    color $darker

// View diff link
.mw-history-diff-link
  a
    padding 0.3em 0.6em
    font-size 0.75em
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue
    border-radius $border-radius-sm
    text-decoration none
    transition all 0.2s ease

    &:hover
      background-color $arch-blue
      color $darker

// Bot edit indicator
.bot-edit
  font-size 0.65em
  padding 0.15em 0.4em
  background-color rgba($purple, 0.2)
  color $purple
  border-radius 2px
  text-transform uppercase
  letter-spacing 0.05em
  font-weight 600

// IP edit indicator
.ip-edit
  font-size 0.65em
  padding 0.15em 0.4em
  background-color rgba($orange, 0.2)
  color $orange
  border-radius 2px
  text-transform uppercase
  letter-spacing 0.05em

// History navigation links (prev/next)
.mw-history-nav
.history-navigation
  display flex
  justify-content space-between
  align-items center
  padding 1em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  margin-top 1em

  a
    display inline-flex
    align-items center
    gap 0.5em
    padding 0.4em 0.8em
    background-color transparent
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    color $secondary-blue
    text-decoration none
    transition all 0.2s ease

    &:hover
      background-color rgba($arch-blue, 0.1)
      border-color rgba($arch-blue, 0.3)

    &.disabled
      opacity 0.4
      cursor not-allowed
      pointer-events none

// History legend
.history-legend
  display flex
  flex-wrap wrap
  gap 1em
  padding 0.75em 1em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  margin-bottom 1em
  font-size 0.85em

  .legend-item
    display flex
    align-items center
    gap 0.4em
    color $muted

  .legend-icon
    width 1em
    height 1em
    border-radius 2px

// Responsive history
@media (max-width: 768px)
  #pagehistory li
  .history-revision
    padding-left 2em
    padding-right 0.5em

    .history-actions
      flex-basis 100%
      margin-top 0.5em
      margin-left 0

  .history-datetime
    min-width auto
    flex-direction row
    gap 0.5em

  .history-comment
    padding 0.3em 0.4em
