// View Transitions API for smooth navigation
// Browser support: ~70% (Chrome 111+, Edge 111+)
// https://developer.mozilla.org/en-US/docs/Web/API/View_Transitions_API

@css {
  @view-transition {
    navigation: auto;
  }

  /* View transition container - the overlay wrapper for all transitions
     Styled to match the Violet Void dark theme
     Browser support: 85%+ (Chrome 111+, Edge 111+) */
  ::view-transition {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    background: rgba(var(--base-rgb, 24, 24, 24), 0.85);
  }

  /* Ensure each transition group creates its own stacking context
     for clean layering during the transition */
  ::view-transition-group(*) {
    isolation: isolate;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.3s;
  }

  ::view-transition-old(page-content) {
    animation: fade-out 0.2s ease-out;
  }

  ::view-transition-new(page-content) {
    animation: fade-in 0.3s ease-in;
  }

  @keyframes fade-out {
    to { opacity: 0; transform: translateY(-10px); }
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
  }
}

// =============================================================================
// VIEW-TRANSITION-CLASS - Class-based View Transition Styling (85%+ browser support)
// =============================================================================
// view-transition-class allows grouping elements for coordinated transitions
// Apply view-transition-class to elements, then style via ::view-transition-group()
// https://developer.mozilla.org/en-US/docs/Web/CSS/view-transition-class

@css {
  /* Hero image transitions - dramatic zoom effect */
  ::view-transition-group(hero) {
    z-index: 100;
  }

  ::view-transition-old(hero) {
    animation: hero-shrink 0.4s ease-in-out;
  }

  ::view-transition-new(hero) {
    animation: hero-expand 0.4s ease-in-out;
  }

  @keyframes hero-shrink {
    to {
      transform: scale(0.8);
      opacity: 0.8;
    }
  }

  @keyframes hero-expand {
    from {
      transform: scale(0.8);
      opacity: 0.8;
    }
  }

  /* Article title transitions - slide up with fade */
  ::view-transition-group(title) {
    z-index: 50;
  }

  ::view-transition-old(title) {
    animation: title-slide-up 0.3s ease-out;
  }

  ::view-transition-new(title) {
    animation: title-fade-in 0.3s ease-in;
  }

  @keyframes title-slide-up {
    to {
      transform: translateY(-20px);
      opacity: 0;
    }
  }

  @keyframes title-fade-in {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
  }

  /* Content area transitions - cross-fade */
  ::view-transition-group(content) {
    z-index: 10;
  }

  ::view-transition-old(content) {
    animation: content-fade-out 0.25s ease;
  }

  ::view-transition-new(content) {
    animation: content-fade-in 0.25s ease;
  }

  @keyframes content-fade-out {
    to { opacity: 0; }
  }

  @keyframes content-fade-in {
    from { opacity: 0; }
  }

  /* Sidebar transitions - slide from side */
  ::view-transition-group(sidebar) {
    z-index: 20;
  }

  ::view-transition-old(sidebar) {
    animation: sidebar-slide-out 0.3s ease-in-out;
  }

  ::view-transition-new(sidebar) {
    animation: sidebar-slide-in 0.3s ease-in-out;
  }

  @keyframes sidebar-slide-out {
    to {
      transform: translateX(-100%);
      opacity: 0;
    }
  }

  @keyframes sidebar-slide-in {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  /* Table of contents transitions */
  ::view-transition-group(toc) {
    z-index: 15;
  }

  ::view-transition-old(toc) {
    animation: toc-fade-out 0.2s ease;
  }

  ::view-transition-new(toc) {
    animation: toc-fade-in 0.2s ease;
  }

  @keyframes toc-fade-out {
    to { opacity: 0; transform: translateX(10px); }
  }

  @keyframes toc-fade-in {
    from { opacity: 0; transform: translateX(-10px); }
  }

  /* Infobox transitions - scale up on appear */
  ::view-transition-group(infobox) {
    z-index: 25;
  }

  ::view-transition-old(infobox) {
    animation: infobox-shrink 0.35s ease;
  }

  ::view-transition-new(infobox) {
    animation: infobox-grow 0.35s ease;
  }

  @keyframes infobox-shrink {
    to {
      transform: scale(0.95);
      opacity: 0.5;
    }
  }

  @keyframes infobox-grow {
    from {
      transform: scale(0.95);
      opacity: 0.5;
    }
  }

  /* No transition class - disable transition for specific elements */
  ::view-transition-group(none) {
    display: none;
  }

  /* Shared image-pair styling */
  ::view-transition-image-pair(hero),
  ::view-transition-image-pair(title),
  ::view-transition-image-pair(infobox) {
    isolation: isolate;
  }

  /* Generic fallback for any named transition not explicitly styled above.
     Applies isolation and a neutral cross-fade so unnamed/new transitions
     are visually consistent with the theme rather than using browser defaults. */
  ::view-transition-image-pair(*) {
    isolation: isolate;
  }

  /* Generic fallback animations for unnamed or miscellaneous named transitions.
     Simple cross-fade prevents jarring flicker for any view-transition-name
     that does not have an explicit ::view-transition-old/new rule. */
  ::view-transition-old(*) {
    animation: vt-generic-fade-out 0.25s ease-out forwards;
  }

  ::view-transition-new(*) {
    animation: vt-generic-fade-in 0.25s ease-in forwards;
  }

  @keyframes vt-generic-fade-out {
    to { opacity: 0; }
  }

  @keyframes vt-generic-fade-in {
    from { opacity: 0; }
  }
}

// Utility classes for applying view-transition-class in HTML
.view-transition-hero
  view-transition-class hero

.view-transition-title
  view-transition-class title

.view-transition-content
  view-transition-class content

.view-transition-sidebar
  view-transition-class sidebar

.view-transition-toc
  view-transition-class toc

.view-transition-infobox
  view-transition-class infobox

// Disable transitions for specific elements
.view-transition-none
  view-transition-class none

// =============================================================================
// view-transition-name PROPERTY - Name Elements for Transition Targeting
// =============================================================================
// Assigns a name to an element for view transition pseudo-element targeting
// Browser support: 85%+ (Chrome 111+, Edge 111+)
// Use with ::view-transition-group(), ::view-transition-old(), ::view-transition-new()
// These are distinct from view-transition-class utilities above - both can be used together

// Hero image/view-transition-name
.view-vt-name-hero
  view-transition-name hero

// Page title view-transition-name
.view-vt-name-title
  view-transition-name title

// Main article content view-transition-name
.view-vt-name-content
  view-transition-name content

// Sidebar view-transition-name
.view-vt-name-sidebar
  view-transition-name sidebar

// Table of contents view-transition-name
.view-vt-name-toc
  view-transition-name toc

// Infobox view-transition-name
.view-vt-name-infobox
  view-transition-name infobox

// Root/named view-transition-name for full-page transitions
.view-vt-name-root
  view-transition-name root

// =============================================================================
// :active-view-transition PSEUDO-CLASS - Style Page During Active Navigation
// =============================================================================
// Matches the root element when a view transition is actively occurring
// Browser support: 85%+ (Chrome 117+, Edge 117+)
// Note: Firefox does not yet support :active-view-transition
// @supports wrapper prevents errors in unsupported browsers

@css {
  @supports (selector(:active-view-transition)) {
    /* Subtle visual indicator that a transition is in progress */
    :root:active-view-transition {
      cursor: wait;
    }

    /* Dim non-transitioned content slightly during cross-fade transitions */
    :root:active-view-transition-type(content) {
      ::view-transition-group(content),
      ::view-transition-old(content),
      ::view-transition-new(content) {
        isolation: isolate;
      }
    }

    /* Hero transitions get full attention - disable other distractions */
    :root:active-view-transition-type(hero) {
      /* Ensure hero image-pair has maximum contrast during transition */
      ::view-transition-image-pair(hero) {
        isolation: isolate;
        z-index: 1000;
      }
    }

    /* Sidebar transitions - give sidebar priority */
    :root:active-view-transition-type(sidebar) {
      ::view-transition-group(sidebar) {
        z-index: 200;
      }
    }

    /* TOC transitions during navigation */
    :root:active-view-transition-type(toc) {
      ::view-transition-group(toc) {
        z-index: 150;
      }
    }

    /* Generic fallback for any named transition class */
    :root:active-view-transition-type(none) {
      /* No special styling needed for suppressed transitions */
    }
  }
}
