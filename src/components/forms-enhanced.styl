// Form validation, states, and enhanced form elements
// Better UX for all form interactions

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// FORM VALIDATION STATES
// =============================================================================

// Success state
input.valid
input:valid
textarea.valid
textarea:valid
select.valid
select:valid
  border-color $green
  box-shadow 0 0 0 3px rgba($green, 0.2)

  &:focus-visible
    box-shadow 0 0 0 3px rgba($green, 0.3)

// Error state
input.invalid
input:invalid
textarea.invalid
textarea:invalid
select.invalid
select:invalid
  border-color $secondary-red
  box-shadow 0 0 0 3px rgba($secondary-red, 0.2)

  &:focus-visible
    box-shadow 0 0 0 3px rgba($secondary-red, 0.3)

// Warning state
input.warning
textarea.warning
select.warning
  border-color $orange
  box-shadow 0 0 0 3px rgba($orange, 0.2)

// Field with error message
.form-field.has-error
  input
  textarea
  select
    border-color $secondary-red

  .error-message
    display block
    color $secondary-red
    font-size 0.85em
    margin-top 0.3em

.form-field.has-success
  input
  textarea
  select
    border-color $green

  .success-message
    display block
    color $green
    font-size 0.85em
    margin-top 0.3em

// =============================================================================
// FORM FIELD GROUPS
// =============================================================================

.form-group
.field-group
  margin 1em 0

  label
    display block
    color $lighter
    font-weight 600
    margin-bottom 0.4em
    font-size 0.95em

  .help-text
  .field-description
    color $light
    font-size 0.85em
    margin-top 0.3em

  input
  textarea
  select
    width 100%

// Inline form
.form-inline
.form-row
  display flex
  gap 1em
  align-items flex-end

  .form-group
    flex 1
    margin 0

// =============================================================================
// INPUT ADDONS
// =============================================================================

.input-group
  display flex
  align-items stretch

  input
    flex 1
    border-radius $border-radius-sm 0 0 $border-radius-sm

  .input-addon
  .input-group-addon
    background linear-gradient(135deg, $dark, $darker)
    border 1px solid $border-subtle
    padding 0.5em 0.75em
    color $lighter
    display flex
    align-items center
    font-size 0.9em

    &:first-child
      border-right none
      border-radius $border-radius-sm 0 0 $border-radius-sm

    &:last-child
      border-left none
      border-radius 0 $border-radius-sm $border-radius-sm 0

  button
    border-radius 0 $border-radius-sm $border-radius-sm 0
    margin-inline-start -1px

// Prefix/suffix
.input-prefix
.input-suffix
  background-color $darker
  border 1px solid $border-subtle
  padding 0.5em 0.75em
  color $lighter
  font-family $font-mono
  font-size 0.9em

// =============================================================================
// ENHANCED CHECKBOXES & RADIOS
// =============================================================================

// Checkbox group
.checkbox-group
.radio-group
  display flex
  flex-direction column
  gap 0.5em

  label
    display flex
    align-items center
    gap 0.5em
    cursor pointer
    color $light
    padding 0.3em 0

    &:hover
      color $lighter

    input
      margin 0

// Inline checkbox/radio group
.checkbox-group-inline
.radio-group-inline
  flex-flow row wrap
  gap 1.5em

// Toggle switch
.toggle-switch
  position relative
  display inline-block
  width 48px
  height 24px

  input
    opacity 0
    width 0
    height 0

  .slider
    position absolute
    cursor pointer
    inset 0
    background-color $darker
    border 1px solid $border-subtle
    border-radius 24px
    transition all $transition-fast

    &::before
      content ""
      position absolute
      height 18px
      width 18px
      left 2px
      bottom 2px
      background-color $light
      border-radius 50%
      transition all $transition-fast

  input:checked + .slider
    background-color $arch-blue
    border-color $arch-blue

    &::before
      transform translateX(24px)
      background-color $darker

  input
    &:focus-visible + .slider
      box-shadow 0 0 0 3px rgba($arch-blue, 0.3)

// =============================================================================
// MULTI-SELECT & TAGS
// =============================================================================

.tags-input
  display flex
  flex-wrap wrap
  gap 0.3em
  padding 0.4em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  min-height 2.5em

  &:focus-within
    border-color $arch-blue
    box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

  .tag
    display inline-flex
    align-items center
    gap 0.3em
    padding 0.2em 0.5em
    background-color rgba($arch-blue, 0.2)
    color $lighter
    border-radius $border-radius-sm
    font-size 0.85em

    .tag-remove
      cursor pointer
      opacity 0.6
      transition opacity $transition-fast

      &:hover
        opacity 1

  input
    flex 1
    min-width 100px
    background transparent
    border none
    outline none
    color $lighter
    padding 0.2em

// =============================================================================
// AUTOCOMPLETE
// =============================================================================

.autocomplete-wrapper
  position relative

  input
    width 100%

  .autocomplete-results
    position absolute
    top 100%
    left 0
    right 0
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.06))
    border 1px solid $border-subtle
    border-top none
    border-radius 0 0 $border-radius-md $border-radius-md
    max-height 200px
    overflow-y auto
    box-shadow $shadow-elevated
    z-index 1000

    .autocomplete-item
      padding 0.5em 0.75em
      color $light
      cursor pointer
      transition background-color $transition-fast

      &:hover
      &.active
        background-color rgba($arch-blue, 0.15)
        color $secondary-blue

      &.selected
        background-color rgba($arch-blue, 0.2)
        color $white

// =============================================================================
// DATE & TIME INPUTS
// =============================================================================

input[type="date"]
input[type="time"]
input[type="datetime-local"]
  &::-webkit-calendar-picker-indicator
    filter invert(0.8)
    cursor pointer

    &:hover
      filter invert(1)

// =============================================================================
// COLOR INPUT
// =============================================================================

input[type="color"]
  -webkit-appearance none
  width 50px
  height 35px
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  cursor pointer
  padding 2px

  &::-webkit-color-swatch-wrapper
    padding 0

  &::-webkit-color-swatch
    border none
    border-radius 3px

// =============================================================================
// SEARCH ENHANCED
// =============================================================================

.search-enhanced
  position relative
  display flex
  align-items center

  input
    padding-inline-start 2.5em

  .search-icon
    position absolute
    left 0.75em
    color $secondary-blue
    pointer-events none

  .search-clear
    position absolute
    right 0.5em
    background transparent
    border none
    color $light
    cursor pointer
    padding 0.3em
    border-radius $border-radius-sm
    transition all $transition-fast

    &:hover
      background-color rgba($arch-blue, 0.15)
      color $white

// =============================================================================
// FORM VALIDATION MESSAGES
// =============================================================================

.form-message
  padding 0.75em 1em
  border-radius $border-radius-sm
  margin 0.5em 0
  font-size 0.9em

  &.form-message-error
    background linear-gradient(135deg, rgba($secondary-red, 0.15), rgba($secondary-red, 0.08))
    border-inline-start 3px solid $secondary-red
    color $lighter

  &.form-message-success
    background linear-gradient(135deg, rgba($green, 0.15), rgba($green, 0.08))
    border-inline-start 3px solid $green
    color $lighter

  &.form-message-warning
    background linear-gradient(135deg, rgba($orange, 0.15), rgba($orange, 0.08))
    border-inline-start 3px solid $orange
    color $lighter

  &.form-message-info
    background linear-gradient(135deg, rgba($arch-blue, 0.15), rgba($arch-blue, 0.08))
    border-inline-start 3px solid $secondary-blue
    color $lighter

// =============================================================================
// REQUIRED FIELD INDICATORS
// =============================================================================

.required-indicator
  color $secondary-red
  font-weight bold
  margin-inline-start 0.2em

label.required
  &::after
    content " *"
    color $secondary-red
    font-weight bold

// =============================================================================
// CHARACTER COUNTER
// =============================================================================

.char-counter
  font-size 0.85em
  color $muted
  text-align right
  margin-top 0.2em

  &.char-limit-near
    color $orange

  &.char-limit-exceeded
    color $secondary-red
    font-weight 600

// =============================================================================
// FORM PROGRESS
// =============================================================================

.form-progress
  display flex
  gap 0.5em
  margin-bottom 1.5em

  .progress-step
    flex 1
    text-align center
    padding 0.5em
    background-color $darker
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    color $light
    font-size 0.85em
    transition all $transition-fast

    &.active
      background linear-gradient(135deg, $arch-blue, $secondary-blue)
      color $darker
      border-color $arch-blue
      font-weight 600

    &.completed
      background-color rgba($green, 0.2)
      border-color $green
      color $green

// =============================================================================
// BUTTON GROUPS
// =============================================================================

.button-group
  display flex
  gap 0.5em

  button
  .button
    border-radius 0

    &:first-child
      border-radius $border-radius-sm 0 0 $border-radius-sm

    &:last-child
      border-radius 0 $border-radius-sm $border-radius-sm 0

    &:not(:last-child)
      border-right none

// Vertical button group
.button-group-vertical
  flex-direction column

  button
  .button
    border-radius 0

    &:first-child
      border-radius $border-radius-sm $border-radius-sm 0 0

    &:last-child
      border-radius 0 0 $border-radius-sm $border-radius-sm

    &:not(:last-child)
      border-bottom none
      border-right 1px solid $border-subtle

// =============================================================================
// FORM ACTIONS
// =============================================================================

.form-actions
  display flex
  gap 0.75em
  margin-top 1.5em
  padding-top 1em
  border-top 1px solid $border-subtle

  button
    min-width 100px

  .spacer
    flex 1

// =============================================================================
// DISABLED FORM
// =============================================================================

.form-disabled
fieldset[disabled]
  opacity 0.6
  pointer-events none

// =============================================================================
// READ-ONLY FORM
// =============================================================================

input[readonly]
textarea[readonly]
select[readonly]
  background-color rgba($arch-blue, 0.05)
  border-color rgba($arch-blue, 0.2)
  cursor not-allowed

// =============================================================================
// FORM SKELETON LOADING
// =============================================================================

.form-skeleton
  .skeleton-input
    background linear-gradient(90deg, $darker 25%, rgba($arch-blue, 0.1) 50%, $darker 75%)
    background-size 200% 100%
    animation shimmer 1.5s infinite
    height 2.5em
    border-radius $border-radius-sm

  .skeleton-label
    background linear-gradient(90deg, $darker 25%, rgba($arch-blue, 0.1) 50%, $darker 75%)
    background-size 200% 100%
    animation shimmer 1.5s infinite
    height 1em
    width 60%
    border-radius 2px
    margin-bottom 0.4em

// =============================================================================
// CARET-COLOR FOR THEMED TEXT CURSOR
// =============================================================================

// Style text cursor in inputs/textareas to match theme
// Browser support: 97%+

// Themed cursor for all text inputs
input[type="text"]
input[type="search"]
input[type="email"]
input[type="password"]
input[type="url"]
input[type="number"]
input[type="tel"]
textarea
  caret-color $arch-blue

// Edit form textarea
#wpTextbox1
.mw-editfont-monospace
  caret-color $secondary-blue


// =============================================================================
// FORM ENHANCEMENTS
// =============================================================================

// Field-sizing for auto-expanding textareas (Chrome 122+ only)
// Firefox doesn't support - already wrapped in modern-css.styl, this is utility class

@supports (field-sizing: content)
  .auto-expand
    field-sizing content
    min-height 3em
    max-height 20em

// Accent-color for form controls
// Browser support: 97%+

input[type="checkbox"]
input[type="radio"]
input[type="range"]
progress
  accent-color $arch-blue

// Appearance: none for custom controls
// Browser support: 97%+

.custom-checkbox
.custom-radio
.custom-select
  appearance none
  -webkit-appearance none
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  padding 0.5em


// =============================================================================
// EDIT FORM ENHANCEMENTS (MediaWiki)
// =============================================================================

// Edit form container
.mw-editform
.edit-form
  margin 1em 0

// Main edit textarea
#wpTextbox1
.mw-editarea
  width 100%
  min-height 400px
  padding 1em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  color $lighter
  font-family $font-mono
  font-size 0.9em
  line-height 1.6
  resize vertical
  transition border-color 0.2s ease, box-shadow 0.2s ease

  &:focus
    outline none
    border-color $arch-blue
    box-shadow 0 0 0 2px rgba($arch-blue, 0.2)

  &::placeholder
    color $muted

// Edit summary input styling
#wpSummary
.mw-summary
  width 100%
  padding 0.6em 0.9em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  color $lighter
  font-size 0.95em
  transition all 0.2s ease

  &:focus
    outline none
    border-color $arch-blue
    box-shadow 0 0 0 2px rgba($arch-blue, 0.2)

  &::placeholder
    color $muted

// Summary label with character counter
.mw-summary-label
.summary-label-wrapper
  display flex
  justify-content space-between
  align-items center
  margin-bottom 0.5em

  label
    color $lighter
    font-weight 500

  .char-counter
    font-variant-numeric tabular-nums
    color $muted
    font-size 0.8em

    &.near-limit
      color $orange

    &.at-limit
      color $secondary-red

// Minor edit checkbox
.mw-editsection-checkbox
.minor-edit-wrapper
  display flex
  align-items center
  gap 0.5em
  padding 0.5em 0.75em
  background-color rgba($arch-blue, 0.05)
  border 1px solid $border-subtle
  border-radius $border-radius-sm

  input[type="checkbox"]
    accent-color $arch-blue
    width 1.1em
    height 1.1em

  label
    color $lighter
    font-size 0.9em
    cursor pointer

// Watch this page checkbox
.watch-page-wrapper
  display flex
  align-items center
  gap 0.5em
  padding 0.5em 0.75em
  background-color rgba($arch-blue, 0.05)
  border 1px solid rgba($arch-blue, 0.2)
  border-radius $border-radius-sm

  input[type="checkbox"]
    accent-color $arch-blue

  label
    color $lighter
    font-size 0.9em
    cursor pointer

// Edit checkboxes container
.mw-edit-options
.edit-options
  display flex
  flex-wrap wrap
  gap 0.75em
  margin 1em 0

// Preview/Show changes tabs
.mw-edit-tabs
.edit-tabs
  display flex
  gap 0
  margin-bottom 1em
  border-bottom 2px solid $border-subtle

  .edit-tab
    padding 0.6em 1.2em
    background-color transparent
    border 1px solid transparent
    border-bottom none
    border-radius $border-radius-sm $border-radius-sm 0 0
    color $muted
    font-size 0.9em
    font-weight 500
    cursor pointer
    transition all 0.2s ease
    margin-bottom -2px

    &:hover
      background-color rgba($arch-blue, 0.05)
      color $secondary-blue

    &.active
    &.selected
      background-color $darker
      border-color $border-subtle
      color $arch-blue
      border-bottom 2px solid $darker

// Tab content areas
.mw-preview
.mw-diff
  padding 1em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  margin-bottom 1em

// Edit toolbar button styling
.mw-editTools
.edit-toolbar
  display flex
  flex-wrap wrap
  gap 0.25em
  padding 0.5em
  background-color $darker
  border 1px solid $border-subtle
  border-bottom none
  border-radius $border-radius-md $border-radius-md 0 0
  margin-bottom 0

  .editbutton
  button
    padding 0.4em 0.6em
    background-color transparent
    border 1px solid transparent
    border-radius $border-radius-sm
    color $muted
    font-size 0.85em
    cursor pointer
    transition all 0.15s ease

    &:hover
      background-color rgba($arch-blue, 0.1)
      border-color rgba($arch-blue, 0.2)
      color $secondary-blue

    &:active
      transform scale(0.95)

  // Character insertion buttons
  .char-insert
    font-family $font-mono
    min-width 2em
    text-align center

// Toolbar groups
.toolbar-group
  display flex
  gap 0.15em
  padding-right 0.5em
  margin-right 0.5em
  border-right 1px solid $border-subtle

  &:last-child
    border-right none
    padding-right 0
    margin-right 0

// Save/Preview/Changes buttons container
.mw-edit-buttons
.edit-buttons
  display flex
  flex-wrap wrap
  gap 0.5em
  margin-top 1em

// Primary save button
#wpSave
.save-button
  padding 0.6em 1.5em
  background linear-gradient(135deg, $green, rgba($green, 0.8))
  border none
  border-radius $border-radius-md
  color $darker
  font-size 1em
  font-weight 600
  cursor pointer
  transition all 0.2s ease

  &:hover
    transform translateY(-1px)
    box-shadow 0 4px 12px rgba($green, 0.3)

  &:active
    transform translateY(0)

// Preview button
#wpPreview
.preview-button
  padding 0.6em 1.2em
  background-color $arch-blue
  border none
  border-radius $border-radius-md
  color $darker
  font-size 0.95em
  font-weight 500
  cursor pointer
  transition all 0.2s ease

  &:hover
    background-color rgba($arch-blue, 0.8)

// Show changes button
#wpDiff
.changes-button
  padding 0.6em 1.2em
  background-color transparent
  border 1px solid $arch-blue
  border-radius $border-radius-md
  color $secondary-blue
  font-size 0.95em
  font-weight 500
  cursor pointer
  transition all 0.2s ease

  &:hover
    background-color rgba($arch-blue, 0.1)

// Cancel link
.cancel-link
  padding 0.6em 1em
  color $muted
  font-size 0.9em
  text-decoration none

  &:hover
    color $secondary-red

// Copyright warning
.mw-editnotice
.edit-notice
  padding 0.75em 1em
  background-color rgba($orange, 0.1)
  border 1px solid rgba($orange, 0.3)
  border-radius $border-radius-md
  margin-bottom 1em
  font-size 0.85em
  color $lighter

  a
    color $secondary-blue

// Section edit link
.mw-editsection
  font-size 0.75em
  margin-left 0.5em

  a
    color $muted
    text-decoration none
    padding 0.2em 0.4em
    border-radius $border-radius-sm
    transition all 0.2s ease

    &:hover
      background-color rgba($arch-blue, 0.1)
      color $secondary-blue

// Edit conflict warning
.mw-editconflict
.edit-conflict
  padding 1em
  background-color rgba($secondary-red, 0.1)
  border 1px solid rgba($secondary-red, 0.3)
  border-radius $border-radius-md
  margin-bottom 1em
  color $lighter

  h2
    color $secondary-red
    margin 0 0 0.5em 0
    font-size 1.1em

// Responsive edit form
@media (max-width 768px)
  #wpTextbox1
  .mw-editarea
    min-height 250px
    font-size 0.85em

  .mw-edit-tabs
    flex-wrap wrap

    .edit-tab
      flex 1
      text-align center
      border-radius $border-radius-sm
      border 1px solid $border-subtle
      margin-bottom 0.25em

  .mw-edit-buttons
  .edit-buttons
    flex-direction column

    button
    input[type="submit"]
      width 100%

// =============================================================================
// PAGE MOVE FORM (Special:MovePage)
// =============================================================================

// Move form container
.mw-movepage
.movepage-form
  padding 1.5em
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.03))
  border 1px solid $border-subtle
  border-radius $border-radius-lg
  margin 1em 0

// Form fieldset
.mw-movepage fieldset
.movepage-fieldset
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em 1.25em
  margin 0 0 1em 0

  legend
    color $lighter
    font-weight 600
    padding 0 0.5em

// New title input section
.mw-movepage-newtitle
.new-title-section
  margin-bottom 1em

  label
    display block
    color $lighter
    font-weight 500
    margin-bottom 0.5em

  input[type="text"]
    width 100%
    padding 0.6em 0.9em
    background-color $darker
    border 1px solid $border-subtle
    border-radius $border-radius-md
    color $lighter
    font-size 1em
    transition all 0.2s ease

    &:focus
      outline none
      border-color $arch-blue
      box-shadow 0 0 0 2px rgba($arch-blue, 0.2)

// Namespace selector with title input group
.mw-movepage-namespace
.namespace-title-group
  display flex
  gap 0.5em
  align-items stretch

  select
    padding 0.6em 0.9em
    background-color $darker
    border 1px solid $border-subtle
    border-radius $border-radius-md
    color $lighter
    font-size 1em
    min-width 120px
    cursor pointer

    &:focus
      outline none
      border-color $arch-blue

  input[type="text"]
    flex 1

// Reason textarea
.mw-movepage-reason
.reason-section
  margin-bottom 1em

  label
    display block
    color $lighter
    font-weight 500
    margin-bottom 0.5em

  textarea
  input[type="text"]
    width 100%
    padding 0.6em 0.9em
    background-color $darker
    border 1px solid $border-subtle
    border-radius $border-radius-md
    color $lighter
    font-size 0.95em
    min-height 80px
    resize vertical
    transition all 0.2s ease

    &:focus
      outline none
      border-color $arch-blue
      box-shadow 0 0 0 2px rgba($arch-blue, 0.2)

// Options checkboxes
.mw-movepage-options
.move-options
  display flex
  flex-direction column
  gap 0.75em
  padding 1em
  background-color $darker
  border-radius $border-radius-md

  .option-item
    display flex
    align-items flex-start
    gap 0.5em

    input[type="checkbox"]
      margin-top 0.2em
      accent-color $arch-blue

    label
      color $light
      font-size 0.9em
      cursor pointer
      line-height 1.4

      .option-description
        display block
        color $muted
        font-size 0.85em
        margin-top 0.2em

// Talk page move option (highlighted)
.talk-move-option
  padding 0.75em
  background-color rgba($arch-blue, 0.08)
  border 1px solid rgba($arch-blue, 0.2)
  border-radius $border-radius-sm

  label
    color $lighter
    font-weight 500

// Leave redirect option
.leave-redirect-option
  padding-left 0.5em

// Watch pages option
.watch-pages-option
  padding 0.5em
  background-color rgba($green, 0.05)
  border-radius $border-radius-sm

// Submit button
.mw-movepage-submit
.move-submit
  margin-top 1.5em
  display flex
  gap 0.75em

  input[type="submit"]
  button
    padding 0.6em 1.5em
    background linear-gradient(135deg, $arch-blue, rgba($arch-blue, 0.8))
    border none
    border-radius $border-radius-md
    color $darker
    font-size 1em
    font-weight 600
    cursor pointer
    transition all 0.2s ease

    &:hover
      transform translateY(-1px)
      box-shadow 0 4px 12px rgba($arch-blue, 0.3)

    &:active
      transform translateY(0)

  .cancel-link
    padding 0.6em 1em
    background transparent
    border none
    color $muted
    font-size 0.95em
    text-decoration none
    cursor pointer

    &:hover
      color $secondary-red

// Warning messages
.mw-movepage-warning
.movepage-warning
  padding 1em
  background-color rgba($orange, 0.1)
  border 1px solid rgba($orange, 0.3)
  border-radius $border-radius-md
  margin-bottom 1em
  color $lighter

  strong
    color $orange

// Error messages
.mw-movepage-error
.movepage-error
  padding 1em
  background-color rgba($secondary-red, 0.1)
  border 1px solid rgba($secondary-red, 0.3)
  border-radius $border-radius-md
  margin-bottom 1em
  color $lighter

// Success message
.mw-movepage-success
.movepage-success
  padding 1em
  background-color rgba($green, 0.1)
  border 1px solid rgba($green, 0.3)
  border-radius $border-radius-md
  margin-bottom 1em
  color $lighter

  a
    color $secondary-blue

// Log entries display
.mw-movepage-log
.move-log
  margin-top 1.5em
  padding 1em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md

  h3
    color $lighter
    font-size 1em
    margin 0 0 0.75em 0

  .log-entry
    padding 0.5em 0
    border-bottom 1px solid $border-subtle
    font-size 0.9em
    color $light

    &:last-child
      border-bottom none

    .log-timestamp
      font-variant-numeric tabular-nums
      color $muted
      margin-right 0.75em

    a
      color $secondary-blue

// Responsive move form
@media (max-width 768px)
  .mw-movepage-namespace
  .namespace-title-group
    flex-direction column

    select
      width 100%

  .mw-movepage-submit
  .move-submit
    flex-direction column

    button
    input[type="submit"]
      width 100%
