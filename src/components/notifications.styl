// Notification Styling for Violet Void ArchWiki Theme
// Badge, panel, types, and actions for notifications
// Browser support: 97%+

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// NOTIFICATION BADGE
// =============================================================================

// Badge positioning and styling
// Browser support: 97%+

.notification-badge
  position relative
  display inline-flex
  align-items center
  justify-content center

  // The badge counter
  .badge-count
  &::after
    content attr(data-count)
    position absolute
    top -8px
    inset-inline-end -8px
    min-width 18px
    height 18px
    padding 0 5px
    background-color $secondary-red
    color $white
    font-size 0.7rem
    font-weight 600
    line-height 18px
    text-align center
    border-radius $border-radius-md
    box-shadow 0 2px 4px rgba($darker, 0.2)

    // For zero count, hide badge
    &[data-count="0"]
    &[data-count="00"]
      display none

  // Larger badge variant
  &.badge-lg .badge-count
    min-width 22px
    height 22px
    font-size 0.8rem
    line-height 22px
    border-radius $border-radius-lg

  // Small badge variant
  &.badge-sm .badge-count
    min-width 14px
    height 14px
    font-size 0.6rem
    line-height 14px
    border-radius $border-radius-sm
    padding 0 3px

  // Alert color variant
  &.badge-alert .badge-count
    background-color $orange

  // Success color variant
  &.badge-success .badge-count
    background-color $green

  // Info color variant
  &.badge-info .badge-count
    background-color $arch-blue

// Notification indicator in header
.mw-notification-area
  .notification-badge
    &::after
      top auto
      bottom -4px
      inset-inline-end -4px

// Echo notification badge
.ech-notification-badge
  position relative

  .uk-notification-count
    position absolute
    top -6px
    inset-inline-end -6px
    background $secondary-red
    color $white
    font-size 10px
    font-weight bold
    min-width 16px
    height 16px
    line-height 16px
    text-align center
    border-radius 8px
    padding 0 4px

// =============================================================================
// NOTIFICATION PANEL
// =============================================================================

// Panel container
// Browser support: 97%+

.notification-panel
  background $dark
  border 1px solid $border-subtle
  border-radius $border-radius-lg
  box-shadow $shadow-lg
  max-width 360px
  width 100%
  overflow hidden

  // Panel header
  .panel-header
    display flex
    align-items center
    justify-content space-between
    padding 1rem
    border-bottom 1px solid $border-subtle
    background rgba($arch-blue, 0.1)

    h3
      margin 0
      font-size 1rem
      font-weight 600
      color $light

    .mark-all-read
      font-size 0.85rem
      color $arch-blue
      cursor pointer

      &:hover
        text-decoration underline

  // Panel body
  .panel-body
    max-height 400px
    overflow-y auto

    // Scrollbar styling
    &::-webkit-scrollbar
      width 6px

    &::-webkit-scrollbar-track
      background rgba($dark, 0.5)

    &::-webkit-scrollbar-thumb
      background $border-subtle
      border-radius 3px

// Notification item
.notification-item
  display flex
  align-items flex-start
  gap 0.75rem
  padding 0.75rem 1rem
  border-bottom 1px solid rgba($border-subtle, 0.5)
  transition background-color 0.2s ease
  position relative // Required for unread indicator ::before with position:absolute

  &:hover
    background rgba($arch-blue, 0.05)

  &:last-child
    border-bottom none

  // Unread state
  &.unread
    background rgba($arch-blue, 0.1)

    &::before
      content ''
      position absolute
      inset-inline-start 0
      top 0
      bottom 0
      width 3px
      background $arch-blue
      border-radius 0 2px 2px 0

  // Notification icon
  .notification-icon
    flex-shrink 0
    width 32px
    height 32px
    display flex
    align-items center
    justify-content center
    background rgba($arch-blue, 0.15)
    border-radius 50%
    color $arch-blue
    font-size 0.9rem

    // Icon variants
    &.icon-edit
      background rgba($arch-blue, 0.15)
      color $arch-blue

    &.icon-talk
      background rgba($arch-blue, 0.15)
      color $arch-blue

    &.icon-alert
      background rgba($orange, 0.15)
      color $orange

    &.icon-system
      background rgba($muted, 0.15)
      color $muted

  // Notification content
  .notification-content
    flex 1
    min-width 0

    .notification-title
      font-size 0.9rem
      font-weight 500
      color $light
      margin 0 0 0.25rem 0
      line-height 1.3
      overflow-wrap break-word

    .notification-body
      font-size 0.8rem
      color $muted
      margin 0
      line-height 1.4

      // Truncate long text
      display -webkit-box
      -webkit-line-clamp 2
      -webkit-box-orient vertical
      overflow hidden

    .notification-time
      font-size 0.75rem
      color $muted
      margin-top 0.25rem
      display block

  // Notification actions
  .notification-actions
    display flex
    gap 0.5rem
    margin-top 0.5rem

    button
      font-size 0.75rem
      padding 0.25rem 0.5rem
      border-radius $border-radius-sm
      border 1px solid $border-subtle
      background transparent
      color $muted
      cursor pointer
      transition all 0.2s ease

      &:hover
        background rgba($arch-blue, 0.1)
        border-color $arch-blue
        color $arch-blue

// =============================================================================
// NOTIFICATION TYPES
// =============================================================================

// Edit notification
.notification-edit
  .notification-icon
    background rgba($arch-blue, 0.15)
    color $arch-blue

// Talk page message
.notification-talk
  .notification-icon
    background rgba($arch-blue, 0.15)
    color $arch-blue

// Mention notification
.notification-mention
  .notification-icon
    background rgba($orange, 0.15)
    color $orange

    &::before
      content '@'
      font-weight bold

// System notification
.notification-system
  .notification-icon
    background rgba($muted, 0.15)
    color $muted

// Watchlist notification
.notification-watchlist
  .notification-icon
    background rgba($green, 0.15)
    color $green

// =============================================================================
// NOTIFICATION ACTIONS
// =============================================================================

// Mark as read button
.notification-mark-read
  padding 0.25rem 0.5rem
  font-size 0.75rem
  background transparent
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  color $muted
  cursor pointer
  transition all 0.2s ease

  &:hover
    background rgba($green, 0.1)
    border-color $green
    color $green

// Dismiss button
.notification-dismiss
  padding 0.25rem 0.5rem
  font-size 0.75rem
  background transparent
  border none
  color $muted
  cursor pointer
  opacity 0.6
  transition opacity 0.2s ease

  &:hover
    opacity 1
    color $secondary-red

// View source link
.notification-view-source
  font-size 0.75rem
  color $arch-blue
  text-decoration none

  &:hover
    text-decoration underline

// Quick reply option
.notification-reply
  padding 0.25rem 0.5rem
  font-size 0.75rem
  background rgba($arch-blue, 0.1)
  border 1px solid rgba($arch-blue, 0.3)
  border-radius $border-radius-sm
  color $arch-blue
  cursor pointer
  transition all 0.2s ease

  &:hover
    background rgba($arch-blue, 0.2)
    border-color $arch-blue

// =============================================================================
// MEDIAWIKI ECHO NOTIFICATIONS
// =============================================================================

// MW Echo notification styling
.mw-echo-notification
  &.mw-echo-notification-unread
    background rgba($arch-blue, 0.1)

  .mw-echo-notification-body
    font-size 0.875rem
    color $light

  .mw-echo-notification-icon
    flex-shrink 0

// Notification popups
.mw-echo-notification-popup
  background $dark
  border 1px solid $border-subtle
  border-radius $border-radius-md
  box-shadow $shadow-lg

  .mw-echo-notification-ago
    font-size 0.75rem
    color $muted

// =============================================================================
// NOTIFICATION PREFERENCES
// =============================================================================

// Preferences panel toggles
.notification-prefs
  .pref-toggle
    display flex
    align-items center
    justify-content space-between
    padding 0.75rem 0
    border-bottom 1px solid rgba($border-subtle, 0.5)

    &:last-child
      border-bottom none

    label
      font-size 0.9rem
      color $light

    input[type="checkbox"]
      width 18px
      height 18px
      accent-color $arch-blue

  // Email digest options
  .email-digest-option
    padding 0.5rem 0

    .digest-frequency
      display flex
      gap 0.5rem
      margin-top 0.5rem

      label
        font-size 0.8rem
        color $muted
        cursor pointer

        input
          margin-inline-end 0.25rem

// Quiet hours settings
.quiet-hours
  .quiet-hours-toggle
    display flex
    align-items center
    gap 0.5rem
    margin-bottom 0.5rem

    input
      width 16px
      height 16px
      accent-color $arch-blue

  .quiet-hours-range
    display flex
    align-items center
    gap 0.5rem

    input[type="time"]
      padding 0.25rem 0.5rem
      background $darker
      border 1px solid $border-subtle
      border-radius $border-radius-sm
      color $light
      font-size 0.85rem

// =============================================================================
// MOBILE NOTIFICATIONS
// =============================================================================

@media (max-width 768px)
  .notification-panel
    max-width 100%
    border-radius 0
    border-inline-start none
    border-inline-end none

  .notification-item
    padding 0.5rem

    .notification-icon
      width 28px
      height 28px
      font-size 0.8rem
