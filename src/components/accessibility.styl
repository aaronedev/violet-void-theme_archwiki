@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/effects'

// Skip to content link
// This link is the first element in the DOM and allows keyboard users
// to skip the navigation and go straight to the main content.
// It is visually hidden by default but becomes visible when focused.
.mw-jump-link
  // Visually hidden pattern (screen readers can still see it)
  // stylelint-disable-next-line property-no-deprecated
  clip rect(1px, 1px, 1px, 1px)
  clip-path inset(50%)
  height 1px
  width 1px
  margin -1px
  overflow hidden
  padding 0
  position absolute
  white-space nowrap
  border 0

  // Visible state (on focus)
  &:focus
    // stylelint-disable-next-line property-no-deprecated
    clip auto
    clip-path none
    height auto
    width auto
    margin 0
    overflow visible
    position fixed
    top 15px
    left 15px
    z-index 1000 // Ensure it sits above the sticky header
    background-color $arch-blue
    color white
    padding 0.75em 1.25em
    border-radius $border-radius-md
    font-weight 600
    font-size 1rem
    box-shadow $shadow-elevated
    text-decoration none

    // Ensure high visibility focus ring
    outline 2px solid white
    outline-offset 2px
    transition all $transition-fast

// Utility class for screen-reader only text
// Use this for text that should be available to assistive technology
// but hidden from visual layout.
.sr-only,
.visually-hidden
  // stylelint-disable-next-line property-no-deprecated
  clip rect(1px, 1px, 1px, 1px)
  clip-path inset(50%)
  height 1px
  width 1px
  margin -1px
  overflow hidden
  padding 0
  position absolute
  white-space nowrap
  border 0
