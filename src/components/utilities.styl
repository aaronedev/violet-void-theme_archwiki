.z-10
  z-index 10

.z-20
  z-index 20

.z-30
  z-index 30

.z-40
  z-index 40

.z-50
  z-index 50

.z-auto
  z-index auto

// =============================================================================
// STATE INDICATORS
// =============================================================================

// Loading state
.is-loading
  position relative
  pointer-events none

  &::after
    content ""
    position absolute
    inset 0
    background rgba($darker, 0.8)
    display flex
    align-items center
    justify-content center

// Disabled state
.is-disabled
  opacity 0.5
  pointer-events none
  cursor not-allowed

// Active state
.is-active
  background-color rgba($arch-blue, 0.15)
  border-color $arch-blue
  color $secondary-blue

// Error state
.is-error
.has-error
  border-color $secondary-red
  color $secondary-red

  input
  textarea
  select
    border-color $secondary-red

// Success state
.is-success
.has-success
  border-color $green
  color $green

// Warning state
.is-warning
.has-warning
  border-color $orange
  color $orange

// =============================================================================
// INTERACTIVE STATES
// =============================================================================

// Interactive element base
.interactive
  cursor pointer
  transition all $transition-fast

  &:hover
    opacity 0.8

  &:active
    transform scale(0.98)

  &.is-disabled
    opacity 0.4
    cursor not-allowed
    pointer-events none

// Focusable element
.focusable
  &:focus-visible
    outline 2px solid $arch-blue
    outline-offset 2px
    border-radius $border-radius-sm

// =============================================================================
// DISPLAY ENHANCEMENTS
// =============================================================================

// flow-root: clearfix replacement
// Browser support: 97%+

.clearfix
.flow-root
  display flow-root

// contents: remove from box tree
// Browser support: 97%+

.contents-wrapper
  display contents

// =============================================================================
// VISIBILITY ENHANCEMENTS
// =============================================================================

// collapse for table rows
// Browser support: 97%+

tr.collapsed
  visibility collapse

// opacity in animations
// Browser support: 97%+

.fade-in
  animation fadeIn 0.3s ease

@keyframes fadeIn
  from
    opacity 0
  to
    opacity 1

.fade-out
  animation fadeOut 0.3s ease

@keyframes fadeOut
  from
    opacity 1
  to
    opacity 0

// =============================================================================
// INTERACTION ENHANCEMENTS
// =============================================================================

// user-select containment
// Browser support: 97%+

.no-select
  user-select none

.select-all
  user-select all

.select-contain
  user-select contain

// pointer-events for SVG
// Browser support: 97%+

.pointer-painted
  pointer-events painted

.pointer-none
  pointer-events none

// resize logical axis
// Browser support: 97%+

.resize-block
  resize block

.resize-inline
  resize inline

// cursor hints
.cursor-zoom-in
  cursor zoom-in

.cursor-zoom-out
  cursor zoom-out

.cursor-grab
  cursor grab

.cursor-grabbing
  cursor grabbing

// caret-shape - Chrome/Edge only (Firefox doesn't support)
@supports (caret-shape: block)
  .caret-block
    caret-shape block

  .caret-bar
    caret-shape bar

// =============================================================================
// SIZING KEYWORDS
// =============================================================================

// fit-content, min-content, max-content, stretch
// Browser support: 97%+

.fit-content
  width fit-content

.min-content
  width min-content

.max-content
  width max-content

.stretch-width
  width -webkit-fill-available
  width stretch

// =============================================================================
// MULTI-COLUMN LAYOUT
// =============================================================================
// column-rule, column-span, column-fill, columns shorthands
// Browser support: 97%+

// column-fill - control how column content is distributed
.column-fill-balance
  column-fill balance

.column-fill-auto
  column-fill auto

// column-span - make element span all columns
.column-span-all
  column-span all

// columns - shorthand for column-count and column-width
.columns-2
  columns 2

.columns-3
  columns 3

.columns-auto
  columns auto

// column-rule utilities
.column-rule
  column-rule 1px solid var(--border-color, #ccc)

.column-rule-thin
  column-rule 1px solid var(--border-color, #ccc)

.column-rule-medium
  column-rule 2px solid var(--border-color, #ccc)

.column-rule-thick
  column-rule 3px solid var(--border-color, #ccc)

.column-rule-dashed
  column-rule 1px dashed var(--border-color, #ccc)

.column-rule-dotted
  column-rule 1px dotted var(--border-color, #ccc)

.column-rule-double
  column-rule 3px double var(--border-color, #ccc)

.column-rule-none
  column-rule none

// =============================================================================
// GRID SHORTHANDS
// =============================================================================
// place-items, place-content, place-self shorthands
// Browser support: 97%+
// These combine align/justify properties into single properties

// place-items - shorthand for align-items + justify-items
// Example: place-items: center = align-items: center + justify-items: center
.place-items-start
  place-items start start

.place-items-end
  place-items end end

.place-items-center
  place-items center center

.place-items-stretch
  place-items stretch stretch

.place-items-baseline
  place-items baseline baseline

// place-content - shorthand for align-content + justify-content
// Example: place-content: center = align-content: center + justify-content: center
.place-content-start
  place-content start start

.place-content-end
  place-content end end

.place-content-center
  place-content center center

.place-content-stretch
  place-content stretch stretch

.place-content-space-between
  place-content space-between space-between

.place-content-space-around
  place-content space-around space-around

.place-content-space-evenly
  place-content space-evenly space-evenly

// place-self - shorthand for align-self + justify-self
// Example: place-self: center = align-self: center + justify-self: center
.place-self-start
  place-self start start

.place-self-end
  place-self end end

.place-self-center
  place-self center center

.place-self-stretch
  place-self stretch stretch

.place-self-baseline
  place-self baseline baseline

// Flexbox equivalents using place-items for flex containers
// These work in flex containers where align-items/justify-items apply to align-content
.flex-place-items-center
  display flex
  place-items center center

.flex-place-items-start
  display flex
  place-items flex-start flex-start

.flex-place-items-end
  display flex
  place-items flex-end flex-end

.flex-place-items-stretch
  display flex
  place-items stretch stretch

// =============================================================================
// CONIC-GRADIENT PATTERNS
// =============================================================================
// conic-gradient for creating pie charts, color wheels, loading spinners
// Browser support: 97%+
// Note: Use @supports for broader compatibility if needed

// Pie chart segments using conic-gradient
.conic-pie-chart
  border-radius 50%
  background conic-gradient(
    $arch-blue 0deg 120deg,
    $secondary-blue 120deg 240deg,
    $green 240deg 360deg
  )

// Loading spinner using conic-gradient
.conic-spinner
  width 24px
  height 24px
  border-radius 50%
  background conic-gradient(
    from 0deg,
    $secondary-blue 0deg 90deg,
    transparent 90deg 360deg
  )
  animation spin 1s linear infinite

// Rainbow gradient for decorative purposes
.conic-rainbow
  background conic-gradient(
    $red 0deg 60deg,
    $orange 60deg 120deg,
    $green 120deg 180deg,
    $arch-blue 180deg 240deg,
    $secondary-blue 240deg 300deg,
    $term-magenta 300deg 360deg
  )

// Neutral gradient for UI elements
.conic-neutral
  background conic-gradient(
    $dark 0deg 180deg,
    $base 180deg 360deg
  )

// Progress indicator conic gradient
.conic-progress
  border-radius 50%
  background conic-gradient(
    $arch-blue var(--progress, 50%),
    $dark var(--progress, 50%)
  )

// =============================================================================
// CROSS-FADE TRANSITIONS
// =============================================================================
// cross-fade() for smooth image transitions
// Browser support: 97%+
// Format: cross-fade(from-image, to-image, percentage)
// Percentage: 0% = fully from-image, 100% = fully to-image

// Image cross-fade utility
.cross-fade-overlay
  position relative
  width 100%
  height 100%

.cross-fade-overlay::before
.cross-fade-overlay::after
  content ''
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  background-size cover
  background-position center

.cross-fade-overlay::before
  z-index 1
  opacity 1
  transition opacity 0.5s ease-in-out

.cross-fade-overlay::after
  z-index 2
  opacity 0
  transition opacity 0.5s ease-in-out

.cross-fade-overlay:hover::before
  opacity 0

.cross-fade-overlay:hover::after
  opacity 1

// Blur-up image loading effect using cross-fade pattern
.image-blur-up
  position relative
  overflow hidden
  background $dark

.image-blur-up::before
  content ''
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  background-size cover
  background-position center
  filter blur(20px)
  transform scale(1.1)
  transition opacity 0.5s ease-out

.image-blur-up.loaded::before
  opacity 0

.image-blur-up::after
  content ''
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  background-size cover
  background-position center
  transition opacity 0.5s ease-out

.image-blur-up.loaded::after
  opacity 1

