// MediaWiki editing interface and special pages
// Complete styling for edit mode, account pages, and admin interfaces

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// EDIT INTERFACE
// =============================================================================

// Edit page wrapper
.mw-editform
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0

// Edit toolbar
.mw-editTools,
.editToolbar,
#toolbar
  background linear-gradient(135deg, $darker, rgba($arch-blue, 0.06))
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  padding 0.5em
  margin-bottom 0.75em
  display flex
  flex-wrap wrap
  gap 0.3em

  button,
  .mw-editbutton
    background-color transparent
    border 1px solid transparent
    padding 0.3em 0.5em
    color $light
    cursor pointer
    border-radius $border-radius-sm
    transition all $transition-fast
    font-size 0.9em

    &:hover
      background-color rgba($arch-blue, 0.15)
      border-color rgba($arch-blue, 0.3)
      color $secondary-blue

    &:active
      background-color rgba($arch-blue, 0.2)

// Main textarea
#wpTextbox1,
.mw-edit textarea
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em
  font-family $font-mono
  font-size 0.95em
  line-height 1.6
  min-height 400px
  resize vertical

  &:focus
    border-color $arch-blue
    box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

// Edit summary
#wpSummary,
.mw-summary
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  padding 0.5em 0.75em
  font-size 0.9em
  width 100%
  margin 0.5em 0

  &:focus
    border-color $arch-blue
    box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

// Checkbox options
.editCheckboxes,
.mw-editOptions
  margin 1em 0
  padding 0.75em
  background-color rgba($arch-blue, 0.05)
  border-radius $border-radius-sm

  label
    display flex
    align-items center
    gap 0.5em
    color $light
    margin 0.4em 0
    cursor pointer

    input
      margin 0

// Edit buttons
.editButtons,
.mw-editButtons
  display flex
  gap 0.5em
  margin-top 1em
  flex-wrap wrap

  button,
  input[type="submit"],
  input[type="button"]
    gradient-surface()

    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.5em 1em
    font-weight 600
    cursor pointer
    transition all $transition-fast

    &:hover
      background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
      border-color rgba($arch-blue, 0.3)
      color $secondary-blue

  // Primary button (Save)
  #wpSave,
  button[name="wpSave"]
    background linear-gradient(135deg, $arch-blue, $secondary-blue)
    color $darker

    &:hover
      background linear-gradient(135deg, lighten($arch-blue, 12%), $secondary-blue)
      color $darker

// =============================================================================
// PREVIEW MODE
// =============================================================================

.mw-preview,
#wikiPreview,
.preview
  background-color $dark
  border 2px solid $arch-blue
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0

  .previewnote
    background linear-gradient(135deg, rgba($orange, 0.15), rgba($orange, 0.08))
    border 1px solid rgba($orange, 0.3)
    border-radius $border-radius-sm
    padding 1em
    margin-bottom 1em

    p
      margin 0
      color $lighter
      font-weight 600

// Changes view
.mw-diff,
table.diff
  background-color $base
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden

// =============================================================================
// LOGIN / CREATE ACCOUNT
// =============================================================================

#userloginForm,
#userlogin,
.mw-ui-vform
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-lg
  padding 2em
  max-width 400px
  margin 2em auto
  box-shadow $shadow-elevated

  h2
    color $lighter
    margin-top 0
    text-align center

  .mw-ui-vform-field
    margin 1em 0

    label
      display block
      color $lighter
      font-weight 600
      margin-bottom 0.4em

    input
      width 100%
      padding 0.5em 0.75em
      background-color $darker
      color $lighter
      border 1px solid $border-subtle
      border-radius $border-radius-sm

      &:focus
        border-color $arch-blue
        box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

  .mw-ui-button
    width 100%
    gradient-surface()

    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.6em 1em
    font-weight 600
    cursor pointer
    margin-top 0.5em

    &:hover
      background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
      border-color rgba($arch-blue, 0.3)
      color $secondary-blue

  // Links below form
  p
    text-align center
    margin-top 1em

    a
      color $secondary-blue
      text-decoration none

      &:hover
        color white

// =============================================================================
// USER PREFERENCES
// =============================================================================

#preferences,
.mw-prefs
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  fieldset
    border 1px solid $border-subtle
    border-radius $border-radius-md
    padding 1em
    margin 1.5em 0

    legend
      color $lighter
      font-weight 600
      padding 0 0.5em

  label
    color $light
    display inline-block
    margin 0.3em 0

  input[type="text"],
  input[type="password"],
  input[type="email"],
  select
    background-color $darker
    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.4em 0.6em

  .mw-prefs-buttons
    margin-top 1.5em
    padding-top 1em
    border-top 1px solid $border-subtle
    display flex
    gap 0.5em

// =============================================================================
// UPLOAD INTERFACE
// =============================================================================

#mw-upload-form,
.mw-upload-form
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  .mw-upload-table
    width 100%

    td
      padding 0.6em 0.8em
      border-bottom 1px solid $border-subtle

      &:first-child
        color $lighter
        font-weight 600
        width 30%

  input[type="file"]
    background-color transparent
    border 2px dashed $border-subtle
    border-radius $border-radius-md
    padding 2em
    text-align center
    cursor pointer
    transition all $transition-fast

    &:hover
      border-color $arch-blue
      background-color rgba($arch-blue, 0.05)

// =============================================================================
// PAGE HISTORY
// =============================================================================

#pagehistory,
.mw-history
  ul
    list-style none
    padding 0
    margin 0

    li
      border-bottom 1px solid $border-subtle
      padding 0.75em
      transition background-color $transition-fast

      &:hover
        background-color rgba($arch-blue, 0.05)

      input[type="radio"]
        margin-right 0.5em

      a
        color $secondary-blue

        &:hover
          color white

      .history-user
        color $light
        font-size 0.9em

      .history-size
        color $muted
        font-size 0.85em
        margin-left 0.5em

      .comment
        color $light
        font-size 0.9em
        font-style italic

// =============================================================================
// PROTECTION / DELETE
// =============================================================================

.mw-warning-with-logexcerpt
  background linear-gradient(135deg, rgba($secondary-red, 0.15), rgba($secondary-red, 0.08))
  border 2px solid $secondary-red
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0

  p
    margin 0
    color $lighter
    font-weight 600

.mw-delete
  background linear-gradient(135deg, rgba($secondary-red, 0.1), rgba($secondary-red, 0.05))
  border 1px solid rgba($secondary-red, 0.3)
  border-radius $border-radius-md
  padding 1.5em

// =============================================================================
// MOVE / RENAME PAGE
// =============================================================================

#movepage,
.mw-movepage
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  table
    width 100%

    td
      padding 0.6em 0.8em

      &:first-child
        color $lighter
        font-weight 600

  input[type="text"]
    width 100%
    background-color $darker
    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.5em

// =============================================================================
// CONTRIBUTIONS
// =============================================================================

.mw-contributions-table
  background-color $base
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden

  th
    background linear-gradient(135deg, $darker, rgba($arch-blue, 0.08))
    color $lighter
    font-weight 600
    padding 0.75em 1em
    text-align left
    border-bottom 2px solid $secondary-blue

  td
    padding 0.6em 1em
    border-bottom 1px solid $border-subtle
    color $light

  tr:hover td
    background-color rgba($arch-blue, 0.05)

// =============================================================================
// WATCHLIST
// =============================================================================

.mw-watchlist
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em

  .mw-watchlist-items
    list-style none
    padding 0
    margin 0

    li
      padding 0.6em
      border-bottom 1px solid $border-subtle
      transition background-color $transition-fast

      &:hover
        background-color rgba($arch-blue, 0.05)

      a
        color $secondary-blue

        &:hover
          color white

// =============================================================================
// RECENT CHANGES
// =============================================================================

.mw-recentchanges
  .mw-changeslist
    list-style none
    padding 0
    margin 0

    li
      padding 0.75em
      border-bottom 1px solid $border-subtle
      display flex
      justify-content space-between
      align-items center
      transition background-color $transition-fast

      &:hover
        background-color rgba($arch-blue, 0.05)

      .mw-title
        font-weight 600
        color $lighter

      .mw-user
        color $secondary-blue
        font-size 0.9em

      .mw-comment
        color $light
        font-size 0.85em
        font-style italic

// =============================================================================
// ADMIN INTERFACE ELEMENTS
// =============================================================================

.mw-userrights
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  .mw-userrights-groups
    list-style none
    padding 0
    margin 1em 0

    li
      padding 0.5em
      border-bottom 1px solid $border-subtle
      color $light

      &:hover
        background-color rgba($arch-blue, 0.05)

.mw-block
  background linear-gradient(135deg, rgba($secondary-red, 0.1), rgba($secondary-red, 0.05))
  border 2px solid $secondary-red
  border-radius $border-radius-md
  padding 1.5em

// =============================================================================
// NOTICES
// =============================================================================

.mw-notification
  background linear-gradient(135deg, rgba($arch-blue, 0.15), rgba($arch-blue, 0.08))
  border 1px solid rgba($arch-blue, 0.3)
  border-left 3px solid $secondary-blue
  border-radius $border-radius-md
  padding 1em 1.5em
  margin 1em 0
  color $lighter

  &.mw-notification-type-error
    background linear-gradient(135deg, rgba($secondary-red, 0.15), rgba($secondary-red, 0.08))
    border-left-color $secondary-red

  &.mw-notification-type-success
    background linear-gradient(135deg, rgba($green, 0.15), rgba($green, 0.08))
    border-left-color $green

  &.mw-notification-type-warn
    background linear-gradient(135deg, rgba($orange, 0.15), rgba($orange, 0.08))
    border-left-color $orange

// Success message after edit
.postedit
  background linear-gradient(135deg, rgba($green, 0.2), rgba($green, 0.1))
  border 2px solid $green
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0
  text-align center
  color $lighter
  font-weight 600
