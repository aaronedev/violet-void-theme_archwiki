// MediaWiki editing interface and special pages
// Complete styling for edit mode, account pages, and admin interfaces
// stylelint-disable selector-id-pattern
@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// EDIT INTERFACE
// =============================================================================

// Edit page wrapper
.mw-editform
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0

// Edit toolbar
.mw-editTools
.editToolbar
#toolbar
  background linear-gradient(135deg, $darker, rgba($arch-blue, 0.06))
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  padding 0.5em
  margin-bottom 0.75em
  display flex
  flex-wrap wrap
  gap 0.3em

  button
  .mw-editbutton
    background-color transparent
    border 1px solid transparent
    padding 0.3em 0.5em
    color $light
    cursor pointer
    border-radius $border-radius-sm
    transition all $transition-fast
    font-size 0.9em

    &:hover
      background-color rgba($arch-blue, 0.15)
      border-color rgba($arch-blue, 0.3)
      color $secondary-blue

    &:active
      background-color rgba($arch-blue, 0.2)

// Main textarea
#wpTextbox1
.mw-edit textarea
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em
  font-family $font-mono
  font-size 0.95em
  line-height 1.6
  min-height 400px
  resize vertical

  &:focus-visible
    border-color $arch-blue
    box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

// Edit summary
#wpSummary
.mw-summary
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  padding 0.5em 0.75em
  font-size 0.9em
  width 100%
  margin 0.5em 0

  &:focus-visible
    border-color $arch-blue
    box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

// Checkbox options
.editCheckboxes
.mw-editOptions
  margin 1em 0
  padding 0.75em
  background-color rgba($arch-blue, 0.05)
  border-radius $border-radius-sm

  label
    display flex
    align-items center
    gap 0.5em
    color $light
    margin 0.4em 0
    cursor pointer

    input
      margin 0

// Edit buttons
.editButtons
.mw-editButtons
  display flex
  gap 0.5em
  margin-top 1em
  flex-wrap wrap

  button
  input[type="submit"]
  input[type="button"]
    gradient-surface()

    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.5em 1em
    font-weight 600
    cursor pointer
    transition all $transition-fast

    &:hover
      background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
      border-color rgba($arch-blue, 0.3)
      color $secondary-blue

  // Primary button (Save)
  #wpSave
  button[name="wpSave"]
    background linear-gradient(135deg, $arch-blue, $secondary-blue)
    color $darker

    &:hover
      background linear-gradient(135deg, lighten($arch-blue, 12%), $secondary-blue)
      color $darker

// =============================================================================
// PREVIEW MODE
// =============================================================================

.mw-preview
#wikiPreview
.preview
  background-color $dark
  border 2px solid $arch-blue
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0

  .previewnote
    background linear-gradient(135deg, rgba($orange, 0.15), rgba($orange, 0.08))
    border 1px solid rgba($orange, 0.3)
    border-radius $border-radius-sm
    padding 1em
    margin-bottom 1em

    p
      margin 0
      color $lighter
      font-weight 600

// Changes view
.mw-diff
table.diff
  background-color $base
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden

// =============================================================================
// LOGIN / CREATE ACCOUNT
// =============================================================================

#userloginForm
#userlogin
.mw-ui-vform
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-lg
  padding 2em
  max-width 400px
  margin 2em auto
  box-shadow $shadow-elevated

  h2
    color $lighter
    margin-top 0
    text-align center

  .mw-ui-vform-field
    margin 1em 0

    label
      display block
      color $lighter
      font-weight 600
      margin-bottom 0.4em

    input
      width 100%
      padding 0.5em 0.75em
      background-color $darker
      color $lighter
      border 1px solid $border-subtle
      border-radius $border-radius-sm

      &:focus-visible
        border-color $arch-blue
        box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

  .mw-ui-button
    width 100%
    gradient-surface()

    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.6em 1em
    font-weight 600
    cursor pointer
    margin-top 0.5em

    &:hover
      background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
      border-color rgba($arch-blue, 0.3)
      color $secondary-blue

  // Links below form
  p
    text-align center
    margin-top 1em

    a
      color $secondary-blue
      text-decoration none

      &:hover
        color $white

// =============================================================================
// USER PREFERENCES
// =============================================================================

#preferences
.mw-prefs
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  fieldset
    border 1px solid $border-subtle
    border-radius $border-radius-md
    padding 1em
    margin 1.5em 0

    legend
      color $lighter
      font-weight 600
      padding 0 0.5em

  label
    color $light
    display inline-block
    margin 0.3em 0

  input[type="text"]
  input[type="password"]
  input[type="email"]
  select
    background-color $darker
    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.4em 0.6em

  .mw-prefs-buttons
    margin-top 1.5em
    padding-top 1em
    border-top 1px solid $border-subtle
    display flex
    gap 0.5em

// =============================================================================
// UPLOAD INTERFACE
// =============================================================================

#mw-upload-form
.mw-upload-form
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  .mw-upload-table
    width 100%

    td
      padding 0.6em 0.8em
      border-bottom 1px solid $border-subtle

      &:first-child
        color $lighter
        font-weight 600
        width 30%

  input[type="file"]
    background-color transparent
    border 2px dashed $border-subtle
    border-radius $border-radius-md
    padding 2em
    text-align center
    cursor pointer
    transition all $transition-fast

    &:hover
      border-color $arch-blue
      background-color rgba($arch-blue, 0.05)

// =============================================================================
// PAGE HISTORY
// =============================================================================

#pagehistory
.mw-history
  ul
    list-style none
    padding 0
    margin 0

    li
      border-bottom 1px solid $border-subtle
      padding 0.75em
      transition background-color $transition-fast

      &:hover
        background-color rgba($arch-blue, 0.05)

      input[type="radio"]
        margin-right 0.5em

      a
        color $secondary-blue

        &:hover
          color $white

      .history-user
        color $light
        font-size 0.9em

      .history-size
        color $muted
        font-size 0.85em
        margin-left 0.5em

      .comment
        color $light
        font-size 0.9em
        font-style italic

// =============================================================================
// PROTECTION / DELETE
// =============================================================================

.mw-warning-with-logexcerpt
  background linear-gradient(135deg, rgba($secondary-red, 0.15), rgba($secondary-red, 0.08))
  border 2px solid $secondary-red
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0

  p
    margin 0
    color $lighter
    font-weight 600

.mw-delete
  background linear-gradient(135deg, rgba($secondary-red, 0.1), rgba($secondary-red, 0.05))
  border 1px solid rgba($secondary-red, 0.3)
  border-radius $border-radius-md
  padding 1.5em

// =============================================================================
// MOVE / RENAME PAGE
// =============================================================================

#movepage
.mw-movepage
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  table
    width 100%

    td
      padding 0.6em 0.8em

      &:first-child
        color $lighter
        font-weight 600

  input[type="text"]
    width 100%
    background-color $darker
    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.5em

// =============================================================================
// CONTRIBUTIONS
// =============================================================================

.mw-contributions-table
  background-color $base
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden

  th
    background linear-gradient(135deg, $darker, rgba($arch-blue, 0.08))
    color $lighter
    font-weight 600
    padding 0.75em 1em
    text-align left
    border-bottom 2px solid $secondary-blue

  td
    padding 0.6em 1em
    border-bottom 1px solid $border-subtle
    color $light

  tr:hover td
    background-color rgba($arch-blue, 0.05)

// =============================================================================
// WATCHLIST
// =============================================================================

.mw-watchlist
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em

  .mw-watchlist-items
    list-style none
    padding 0
    margin 0

    li
      padding 0.6em
      border-bottom 1px solid $border-subtle
      transition background-color $transition-fast

      &:hover
        background-color rgba($arch-blue, 0.05)

      a
        color $secondary-blue

        &:hover
          color $white

// =============================================================================
// RECENT CHANGES
// =============================================================================

.mw-recentchanges
  .mw-changeslist
    list-style none
    padding 0
    margin 0

    li
      padding 0.75em
      border-bottom 1px solid $border-subtle
      display flex
      justify-content space-between
      align-items center
      transition background-color $transition-fast

      &:hover
        background-color rgba($arch-blue, 0.05)

      .mw-title
        font-weight 600
        color $lighter

      .mw-user
        color $secondary-blue
        font-size 0.9em

      .mw-comment
        color $light
        font-size 0.85em
        font-style italic

// =============================================================================
// ADMIN INTERFACE ELEMENTS
// =============================================================================

.mw-userrights
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1.5em

  .mw-userrights-groups
    list-style none
    padding 0
    margin 1em 0

    li
      padding 0.5em
      border-bottom 1px solid $border-subtle
      color $light

      &:hover
        background-color rgba($arch-blue, 0.05)

.mw-block
  background linear-gradient(135deg, rgba($secondary-red, 0.1), rgba($secondary-red, 0.05))
  border 2px solid $secondary-red
  border-radius $border-radius-md
  padding 1.5em

// =============================================================================
// NOTICES
// =============================================================================

.mw-notification
  background linear-gradient(135deg, rgba($arch-blue, 0.15), rgba($arch-blue, 0.08))
  border 1px solid rgba($arch-blue, 0.3)
  border-left 3px solid $secondary-blue
  border-radius $border-radius-md
  padding 1em 1.5em
  margin 1em 0
  color $lighter

  &.mw-notification-type-error
    background linear-gradient(135deg, rgba($secondary-red, 0.15), rgba($secondary-red, 0.08))
    border-left-color $secondary-red

  &.mw-notification-type-success
    background linear-gradient(135deg, rgba($green, 0.15), rgba($green, 0.08))
    border-left-color $green

  &.mw-notification-type-warn
    background linear-gradient(135deg, rgba($orange, 0.15), rgba($orange, 0.08))
    border-left-color $orange

// Success message after edit
.postedit
  background linear-gradient(135deg, rgba($green, 0.2), rgba($green, 0.1))
  border 2px solid $green
  border-radius $border-radius-md
  padding 1.5em
  margin 1em 0
  text-align center
  color $lighter
  font-weight 600

// =============================================================================
// EDIT CONFLICT RESOLUTION UI
// =============================================================================
// Conflict diff display, merge tool styling, resolution options
// Handles the edit conflict interface when two users edit the same page

// Edit conflict container
.mw-editconflict
  background linear-gradient(135deg, $base, rgba($orange, 0.04))
  border 2px solid $orange
  border-radius $border-radius-lg
  padding 1.5em
  margin 1.5em 0

// Conflict header/warning
.mw-conflict-header
  background linear-gradient(135deg, rgba($orange, 0.15), rgba($orange, 0.08))
  border 1px solid rgba($orange, 0.4)
  border-radius $border-radius-md
  padding 1em 1.25em
  margin-bottom 1.5em
  display flex
  align-items center
  gap 0.75em

  .conflict-icon
    font-size 1.5em
    flex-shrink 0

  .conflict-title
    font-size 1.1em
    font-weight 600
    color $lighter
    margin 0

  .conflict-description
    color $light
    font-size 0.9em
    margin 0.25em 0 0

// Conflict panels container
.mw-conflict-panels
  display grid
  grid-template-columns 1fr 1fr
  gap 1em
  margin 1em 0

  @media (max-width 768px)
    grid-template-columns 1fr

// Individual conflict panel (your edit vs stored version)
.mw-conflict-panel
  background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden

  .panel-header
    background linear-gradient(135deg, rgba($arch-blue, 0.12), rgba($arch-blue, 0.06))
    border-bottom 1px solid $border-subtle
    padding 0.75em 1em
    display flex
    align-items center
    justify-content space-between

    .panel-title
      font-weight 600
      color $lighter
      font-size 0.95em

    .panel-badge
      font-size 0.75em
      padding 0.2em 0.5em
      border-radius $border-radius-sm
      background rgba($arch-blue, 0.2)
      color $secondary-blue

  .panel-content
    padding 1em
    font-family $font-mono
    font-size 0.85em
    line-height 1.6
    max-height 400px
    overflow-y auto
    color $light

    // Line-by-line diff styling
    .diff-line
      padding 0.15em 0.5em
      margin 0 -0.5em

      &.diff-added
        background rgba($green, 0.15)
        border-inline-start 3px solid $green

      &.diff-removed
        background rgba($red, 0.15)
        border-inline-start 3px solid $red

      &.diff-changed
        background rgba($orange, 0.1)

      &.diff-context
        color $muted

// Your edit panel specific
.mw-conflict-panel-your-edit
  .panel-header
    background linear-gradient(135deg, rgba($secondary-blue, 0.15), rgba($secondary-blue, 0.08))

    .panel-badge
      background rgba($secondary-blue, 0.2)
      color $secondary-blue

// Stored version panel
.mw-conflict-panel-stored
  .panel-header
    background linear-gradient(135deg, rgba($muted, 0.12), rgba($muted, 0.06))

    .panel-badge
      background rgba($muted, 0.2)
      color $muted

// Conflict resolution options
.mw-conflict-resolution
  margin-top 1.5em
  padding-top 1.5em
  border-top 1px solid $border-subtle

  .resolution-title
    font-weight 600
    color $lighter
    margin-bottom 1em

  .resolution-options
    display flex
    flex-wrap wrap
    gap 0.75em

// Resolution buttons
.mw-conflict-btn
  background linear-gradient(135deg, rgba($arch-blue, 0.12), rgba($arch-blue, 0.06))
  border 1px solid rgba($arch-blue, 0.3)
  border-radius $border-radius-md
  padding 0.75em 1.25em
  color $light
  font-size 0.95em
  cursor pointer
  transition all $transition-fast
  display flex
  align-items center
  gap 0.5em

  &:hover
    background linear-gradient(135deg, rgba($arch-blue, 0.2), rgba($arch-blue, 0.1))
    border-color rgba($arch-blue, 0.5)
    color $lighter

  &:focus-visible
    outline 2px solid $arch-blue
    outline-offset 2px

  &.btn-use-yours
    background linear-gradient(135deg, rgba($secondary-blue, 0.15), rgba($secondary-blue, 0.08))
    border-color rgba($secondary-blue, 0.4)

    &:hover
      background linear-gradient(135deg, rgba($secondary-blue, 0.25), rgba($secondary-blue, 0.12))

  &.btn-use-theirs
    background linear-gradient(135deg, rgba($muted, 0.15), rgba($muted, 0.08))
    border-color rgba($muted, 0.4)

    &:hover
      background linear-gradient(135deg, rgba($muted, 0.25), rgba($muted, 0.12))

  &.btn-merge
    background linear-gradient(135deg, rgba($green, 0.15), rgba($green, 0.08))
    border-color rgba($green, 0.4)

    &:hover
      background linear-gradient(135deg, rgba($green, 0.25), rgba($green, 0.12))

// Merge editor textarea
.mw-merge-editor
  margin-top 1.5em
  background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em

  .merge-header
    font-weight 600
    color $lighter
    margin-bottom 0.75em
    display flex
    align-items center
    gap 0.5em

  textarea
    width 100%
    min-height 300px
    background $darker
    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 1em
    font-family $font-mono
    font-size 0.9em
    line-height 1.6
    resize vertical

    &:focus-visible
      border-color $arch-blue
      box-shadow 0 0 0 3px rgba($arch-blue, 0.25)

// Conflict helpful tips
.mw-conflict-tips
  margin-top 1.5em
  padding 1em
  background rgba($darker, 0.5)
  border 1px dashed $border-subtle
  border-radius $border-radius-md

  .tips-title
    font-weight 600
    color $lighter
    font-size 0.9em
    margin-bottom 0.5em

  ul
    margin 0
    padding-inline-start 1.25em
    color $light
    font-size 0.85em
    line-height 1.6

    li
      margin-bottom 0.25em

// Reduced motion for conflict animations
@media (prefers-reduced-motion reduce)
  .mw-editconflict
  .mw-conflict-panels
  .mw-conflict-resolution
    transition none
    animation none
