// =============================================================================
// Glassmorphism Effects
// Modern frosted glass styling with backdrop blur and transparency
// Browser support: 93%+ (Chrome 76+, Safari 17+, Firefox 103+)
// =============================================================================

// Glass base styling
.glass
  background rgba($base, 0.7)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($lighter, 0.1)

// Glass variants by intensity
.glass-light
  background rgba($lighter, 0.15)
  backdrop-filter blur(8px)
  -webkit-backdrop-filter blur(8px)
  border 1px solid rgba($lighter, 0.2)

.glass-dark
  background rgba($darker, 0.8)
  backdrop-filter blur(16px)
  -webkit-backdrop-filter blur(16px)
  border 1px solid rgba($darker, 0.3)

// Glass with colored tint
.glass-accent
  background rgba($arch-blue, 0.2)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($arch-blue, 0.3)

.glass-success
  background rgba($green, 0.15)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($green, 0.3)

.glass-warning
  background rgba($orange, 0.15)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($orange, 0.3)

.glass-danger
  background rgba($red, 0.15)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($red, 0.3)

// Glass with glow effect
.glass-glow
  background rgba($arch-blue, 0.1)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($arch-blue, 0.3)
  box-shadow 0 0 20px rgba($arch-blue, 0.2)

.glass-glow-strong
  background rgba($arch-blue, 0.15)
  backdrop-filter blur(20px)
  -webkit-backdrop-filter blur(20px)
  border 1px solid rgba($arch-blue, 0.4)
  box-shadow 0 0 40px rgba($arch-blue, 0.3)

// Frost effect (more blur)
.frosted
  background rgba($base, 0.85)
  backdrop-filter blur(24px)
  -webkit-backdrop-filter blur(24px)
  border 1px solid rgba($lighter, 0.15)

// Subtle glass (minimal blur)
.glass-subtle
  background rgba($base, 0.5)
  backdrop-filter blur(4px)
  -webkit-backdrop-filter blur(4px)
  border 1px solid rgba($lighter, 0.08)

// Glass card component
.glass-card
  background rgba($base, 0.6)
  backdrop-filter blur(16px)
  -webkit-backdrop-filter blur(16px)
  border 1px solid rgba($lighter, 0.1)
  border-radius 12px
  padding 1.5rem
  transition all 0.3s ease

  &:hover
    background rgba($base, 0.7)
    border-color rgba($arch-blue, 0.3)
    box-shadow 0 8px 32px rgba($darker, 0.3)

// Glass modal overlay
.glass-overlay
  background rgba($darker, 0.6)
  backdrop-filter blur(8px)
  -webkit-backdrop-filter blur(8px)

// Glass navigation header
.glass-nav
  background rgba($base, 0.8)
  backdrop-filter blur(16px)
  -webkit-backdrop-filter blur(16px)
  border-bottom 1px solid rgba($lighter, 0.1)
  position sticky
  top 0
  z-index 100

// Glass sidebar
.glass-sidebar
  background rgba($dark, 0.7)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border-right 1px solid rgba($lighter, 0.1)

// Glass dropdown menu
.glass-dropdown
  background rgba($base, 0.95)
  backdrop-filter blur(20px)
  -webkit-backdrop-filter blur(20px)
  border 1px solid rgba($lighter, 0.15)
  border-radius 8px
  box-shadow 0 10px 40px rgba($darker, 0.4)

// Glass tooltip
.glass-tooltip
  background rgba($dark, 0.9)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border 1px solid rgba($lighter, 0.1)
  border-radius 6px
  padding 0.5rem 0.75rem
  font-size 0.875rem

// Glass button
.glass-button
  background rgba($arch-blue, 0.2)
  backdrop-filter blur(8px)
  -webkit-backdrop-filter blur(8px)
  border 1px solid rgba($arch-blue, 0.4)
  border-radius 8px
  padding 0.75rem 1.5rem
  color $lighter
  cursor pointer
  transition all 0.2s ease

  &:hover
    background rgba($arch-blue, 0.3)
    border-color rgba($arch-blue, 0.6)
    box-shadow 0 0 20px rgba($arch-blue, 0.3)

  &:active
    background rgba($arch-blue, 0.4)

// Glass input field
.glass-input
  background rgba($base, 0.5)
  backdrop-filter blur(4px)
  -webkit-backdrop-filter blur(4px)
  border 1px solid rgba($lighter, 0.2)
  border-radius 8px
  padding 0.75rem 1rem
  color $light
  transition all 0.2s ease

  &::placeholder
    color rgba($light, 0.5)

  &:focus
    outline none
    border-color rgba($arch-blue, 0.5)
    background rgba($base, 0.7)

// Responsive glass effects
@media (max-width 768px)
  .glass-card
    padding 1rem
    border-radius 8px

  .glass-nav
    backdrop-filter blur(8px)
    -webkit-backdrop-filter blur(8px)

// High contrast mode support
@media (forced-colors active)
  .glass
  .glass-light
  .glass-dark
  .glass-accent
  .glass-card
  .glass-nav
  .glass-sidebar
  .glass-dropdown
  .glass-tooltip
  .glass-button
  .glass-input
    backdrop-filter none
    -webkit-backdrop-filter none
    background Canvas
    border 1px solid CanvasText

// Reduced motion support
@media (prefers-reduced-motion reduce)
  .glass-card
  .glass-button
  .glass-input
    transition none

// Reduced transparency support
// Users who prefer reduced transparency get solid backgrounds without blur
// Backdrop blur is non-essential decoration; solid backgrounds preserve legibility
@media (prefers-reduced-transparency reduce)
  .glass
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.95)

  .glass-light
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($lighter, 0.25)

  .glass-dark
    backdrop-filter none
    -webkit-backdrop-filter none
    background $dark

  .glass-accent
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($arch-blue, 0.3)

  .glass-success
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($green, 0.25)

  .glass-warning
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($orange, 0.25)

  .glass-danger
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($red, 0.25)

  .glass-glow
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($arch-blue, 0.2)
    box-shadow none

  .glass-glow-strong
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($arch-blue, 0.25)
    box-shadow none

  .frosted
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.95)

  .glass-subtle
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.75)

  .glass-card
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.9)

  .glass-overlay
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($darker, 0.9)

  .glass-nav
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.95)

  .glass-sidebar
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($dark, 0.95)

  .glass-dropdown
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.98)

  .glass-tooltip
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($dark, 0.98)

  .glass-button
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($arch-blue, 0.3)

  .glass-input
    backdrop-filter none
    -webkit-backdrop-filter none
    background rgba($base, 0.8)
