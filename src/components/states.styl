// State Patterns - Loading, Empty, Error, Success States
// Browser support: 97%+ for most features

@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/gradients'
@import '../mixins/effects'

// =============================================================================
// LOADING STATES
// =============================================================================

// Loading overlay for page content
.mw-body-loading-overlay
  position relative
  min-height 200px

  &::after
    content ""
    position absolute
    top 50%
    left 50%
    width 40px
    height 40px
    margin -20px 0 0 -20px
    border 3px solid rgba($arch-blue, 0.2)
    border-top-color $arch-blue
    border-radius 50%
    animation spin 0.8s linear infinite

@keyframes spin
  to
    transform rotate(360deg)

// Inline loading spinner
.mw-loading-spinner
  display inline-block
  width 16px
  height 16px
  border 2px solid rgba($arch-blue, 0.2)
  border-top-color $arch-blue
  border-radius 50%
  animation spin 0.8s linear infinite
  vertical-align middle

  // Size variants
  &.mw-loading-spinner-sm
    width 12px
    height 12px
    border-width 2px

  &.mw-loading-spinner-lg
    width 24px
    height 24px
    border-width 3px

  &.mw-loading-spinner-xl
    width 40px
    height 40px
    border-width 4px

// Loading text with spinner
.mw-loading
  display flex
  align-items center
  justify-content center
  gap 0.5em
  padding 1em
  color $light
  font-size 0.9em

  .mw-loading-spinner
    flex-shrink 0

// Page loading indicator (top of content)
.mw-body-loading
  position fixed
  top 0
  left 0
  right 0
  height 3px
  background rgba($arch-blue, 0.1)
  z-index 10000
  overflow hidden

  &::after
    content ""
    position absolute
    top 0
    left 0
    width 30%
    height 100%
    background linear-gradient(90deg, transparent, $arch-blue, transparent)
    animation loading-bar 1.5s ease-in-out infinite

@keyframes loading-bar
  0%
    transform translateX(-100%)
  100%
    transform translateX(400%)

// =============================================================================
// SKELETON SCREENS
// =============================================================================

// Skeleton placeholder base
.mw-skeleton
  background linear-gradient(
    90deg,
    rgba($arch-blue, 0.06) 0%,
    rgba($arch-blue, 0.12) 50%,
    rgba($arch-blue, 0.06) 100%
  )
  background-size 200% 100%
  animation skeleton-shimmer 1.5s ease-in-out infinite
  border-radius $border-radius-sm

@keyframes skeleton-shimmer
  0%
    background-position 200% 0
  100%
    background-position -200% 0

// Skeleton text lines
.mw-skeleton-text
  background linear-gradient(
    90deg,
    rgba($arch-blue, 0.06) 0%,
    rgba($arch-blue, 0.12) 50%,
    rgba($arch-blue, 0.06) 100%
  )
  background-size 200% 100%
  animation skeleton-shimmer 1.5s ease-in-out infinite
  border-radius $border-radius-sm
  height 1em
  margin-bottom 0.5em

  &:last-child
    width 70%

// Skeleton heading
.mw-skeleton-heading
  background linear-gradient(
    90deg,
    rgba($arch-blue, 0.06) 0%,
    rgba($arch-blue, 0.12) 50%,
    rgba($arch-blue, 0.06) 100%
  )
  background-size 200% 100%
  animation skeleton-shimmer 1.5s ease-in-out infinite
  border-radius $border-radius-sm
  height 1.5em
  width 60%
  margin-bottom 1em

// Skeleton image/thumbnail
.mw-skeleton-image
  background linear-gradient(
    90deg,
    rgba($arch-blue, 0.06) 0%,
    rgba($arch-blue, 0.12) 50%,
    rgba($arch-blue, 0.06) 100%
  )
  background-size 200% 100%
  animation skeleton-shimmer 1.5s ease-in-out infinite
  border-radius $border-radius-sm
  aspect-ratio 16 / 9

// Skeleton avatar
.mw-skeleton-avatar
  background linear-gradient(
    90deg,
    rgba($arch-blue, 0.06) 0%,
    rgba($arch-blue, 0.12) 50%,
    rgba($arch-blue, 0.06) 100%
  )
  background-size 200% 100%
  animation skeleton-shimmer 1.5s ease-in-out infinite
  border-radius $border-radius-sm
  width 40px
  height 40px
  border-radius 50%

// Skeleton infobox row
.mw-skeleton-infobox-row
  display flex
  gap 1em
  padding 0.5em 0

  .mw-skeleton-text
    flex 1

  &:nth-child(odd)
    .mw-skeleton-text:last-child
      width 40%

  &:nth-child(even)
    .mw-skeleton-text:last-child
      width 60%

// Skeleton table row
.mw-skeleton-table-row
  display table-row

  > td
  > th
    background linear-gradient(
      90deg,
      rgba($arch-blue, 0.06) 0%,
      rgba($arch-blue, 0.12) 50%,
      rgba($arch-blue, 0.06) 100%
    )
    background-size 200% 100%
    animation skeleton-shimmer 1.5s ease-in-out infinite
    border-radius $border-radius-sm
    height 1.5em
    padding 0.5em
    border-bottom 1px solid $border-subtle

// Skeleton list item
.mw-skeleton-list-item
  display flex
  align-items center
  gap 0.75em
  padding 0.75em 0
  border-bottom 1px solid $border-subtle

  .mw-skeleton-avatar
    flex-shrink 0

  .mw-skeleton-text
    flex 1

// =============================================================================
// PROGRESS INDICATORS
// =============================================================================

// Progress bar container
.mw-progress
  width 100%
  height 8px
  background rgba($arch-blue, 0.1)
  border-radius $border-radius-sm
  overflow hidden

// Progress bar fill
.mw-progress-bar
  height 100%
  background linear-gradient(90deg, $arch-blue, $secondary-blue)
  border-radius $border-radius-sm
  transition width $transition-medium
  position relative

  // Animated stripes
  &::after
    content ""
    position absolute
    top 0
    left 0
    right 0
    bottom 0
    background linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 100%
    )
    animation progress-stripe 1s linear infinite

@keyframes progress-stripe
  0%
    transform translateX(-100%)
  100%
    transform translateX(100%)

// Progress with label
.mw-progress-wrapper
  .mw-progress-label
    display flex
    justify-content space-between
    margin-bottom 0.25em
    font-size 0.85em
    color $light

  .mw-progress-percentage
    color $arch-blue
    font-weight 600

// Indeterminate progress bar
.mw-progress-indeterminate
  .mw-progress-bar
    width 30%
    animation progress-indeterminate 1.5s ease-in-out infinite

@keyframes progress-indeterminate
  0%
    transform translateX(-100%)
    left 0
  50%
    transform translateX(100%)
    left calc(100% - 30%)
  100%
    transform translateX(200%)
    left 100%

// Circular progress
.mw-progress-circular
  width 40px
  height 40px
  position relative

  svg
    width 100%
    height 100%
    transform rotate(-90deg)

  circle
    fill none
    stroke-width 4
    stroke-linecap round

    &.mw-progress-bg
      stroke rgba($arch-blue, 0.15)

    &.mw-progress-fill
      stroke $arch-blue
      stroke-dasharray 100
      stroke-dashoffset 100
      animation progress-circular 1.5s ease-out forwards

@keyframes progress-circular
  to
    stroke-dashoffset 25

// Progress spinner (alternative to CSS spinner)
.mw-progress-spinner
  width 40px
  height 40px

  &::before
  &::after
    content ""
    position absolute
    width 100%
    height 100%
    border-radius 50%
    border 3px solid transparent
    border-top-color $arch-blue
    animation spin 0.8s linear infinite

  &::before
    animation-direction normal

  &::after
    border-top-color $secondary-blue
    animation-direction reverse
    animation-duration 0.6s

// =============================================================================
// LOADING OVERLAYS
// =============================================================================

// Modal loading overlay
.mw-overlay-loading
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  background rgba($darker, 0.85)
  backdrop-filter blur(4px)
  display flex
  align-items center
  justify-content center
  z-index 9999

  .mw-loading
    flex-direction column
    color $lighter

    .mw-loading-spinner
      width 32px
      height 32px
      border-width 3px
      margin-bottom 1em

// Image loading placeholder
.mw-image-loading
  position relative
  background rgba($arch-blue, 0.05)
  min-height 100px

  &::before
    content ""
    position absolute
    top 50%
    left 50%
    width 32px
    height 32px
    margin -16px 0 0 -16px
    border 2px solid rgba($arch-blue, 0.2)
    border-top-color $arch-blue
    border-radius 50%
    animation spin 0.8s linear infinite

// =============================================================================
// REDUCED MOTION SUPPORT
// =============================================================================

@media (prefers-reduced-motion reduce)
  .mw-loading-spinner
  .mw-progress-bar::after
  .mw-skeleton
  .mw-body-loading::after
    animation none

  .mw-progress-bar
    transition none

  .mw-progress-indeterminate .mw-progress-bar
    animation none
    width 100%

  .mw-progress-circular circle.mw-progress-fill
    animation none
    stroke-dashoffset 75
