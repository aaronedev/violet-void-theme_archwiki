@import '../variables/layout'

// Responsive design adjustments
@media (max-width 768px)
  #content pre:not([class*="codemirror"])
    font-size 0.85em
    padding 1em !important
    padding-top 2.5em !important
    border-radius $border-radius-md

  .wikitable
    font-size 0.9em

  .mw-parser-output .wikitable,
  .mw-parser-output .infobox,
  .mw-parser-output table.results
    display block
    overflow-x auto
    max-width 100%
    -webkit-overflow-scrolling touch

  .mw-parser-output .wikitable thead,
  .mw-parser-output .infobox thead,
  .mw-parser-output table.results thead
    display table-header-group

  .mw-parser-output .wikitable th,
  .mw-parser-output .infobox th,
  .mw-parser-output table.results th
    white-space nowrap

  .mw-ui-button
    padding 0.4em 1em
    font-size 0.95em
