// =============================================================================
// @MEDIA (HOVER: NONE) - Touch-Only Devices (97%+ browser support)
// =============================================================================

// Scroll-driven animations - animate based on scroll position
// Provides smooth, performant animations without JavaScript
// Browser support: 85%+ (Chrome 115+, Firefox 123+ behind flag)

/* stylelint-disable stylus/at-rule-no-unknown, selector-pseudo-class-no-unknown, stylus/single-line-comment */
@css {
  @supports (animation-timeline: scroll()) {
    /* Reading progress bar - animates as user scrolls through article */
    .mw-parser-output {
      animation-timeline: scroll();
      animation-name: reading-progress;
      animation-fill-mode: both;
      animation-timing-function: linear;
    }

    /* Reading progress bar keyframes */
    @keyframes reading-progress {
      from {
        transform: scaleX(0);
        transform-origin: left;
      }
      to {
        transform: scaleX(1);
        transform-origin: left;
      }
    }

    /* TOC section indicator - highlights current section while scrolling */
    #toc,
    .toc {
      animation-timeline: view();
      animation-range: entry 0% cover 50%;
    }

    /* Fade-in effect for elements entering viewport */
    .mw-parser-output > * {
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
      animation-fill-mode: both;
    }

    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Infobox fade-in as it enters viewport */
    .infobox,
    .thumb.tright,
    .thumb.tleft {
      animation-timeline: view();
      animation-range: entry 0% cover 30%;
      animation-name: infobox-fade-in;
      animation-fill-mode: both;
    }

    @keyframes infobox-fade-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Navbox visibility - subtle scale effect when scrolling into view */
    .navbox,
    .vertical-navbox {
      animation-timeline: view();
      animation-range: entry 0% cover 20%;
      animation-name: navbox-scale-in;
      animation-fill-mode: both;
    }

    @keyframes navbox-scale-in {
      from {
        opacity: 0;
        transform: scale(0.98);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* Code block highlight effect while scrolling past */
    pre,
    .mw-highlight {
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
      animation-name: code-block-appear;
    }

    @keyframes code-block-appear {
      0% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
      100% {
        opacity: 0.7;
      }
    }

    /* Gallery items - staggered animation when scrolling into view */
    .gallery,
    .mw-gallery-traditional {
      animation-timeline: view();
      animation-range: entry 0% cover 50%;
    }

    /* Reference section highlight as user scrolls */
    .references,
    .ref-list {
      animation-timeline: view();
      animation-range: entry 0% cover 20%;
      animation-name: references-appear;
    }

    @keyframes references-appear {
      from {
        background-color: transparent;
      }
      to {
        background-color: rgba(var(--arch-blue-rgb, 137, 80, 199), 0.05);
      }
    }
  }

  /* Scroll-driven animations with named timelines */
  @supports (animation-timeline-name: continuous) {
    /* Create named timeline for continuous scroll */
    .mw-body {
      scroll-timeline: --page-scroll block;
      animation-timeline: --page-scroll;
    }

    /* Header shrink effect on scroll */
    #mw-head,
    .vector-sticky-p-container {
      animation-timeline: --page-scroll;
      animation-range: 0px 100px;
      animation-name: header-shrink;
    }

    @keyframes header-shrink {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(-10px);
      }
    }

    /* Sidebar parallax effect */
    .mw-sidebar {
      animation-timeline: --page-scroll;
      animation-range: 0px 500px;
      animation-name: sidebar-fade;
    }

    @keyframes sidebar-fade {
      from {
        opacity: 1;
      }
      to {
        opacity: 0.7;
      }
    }
  }
}

/* Scroll Timeline Named Timelines - Performance optimization for scroll-driven animations
 * Browser support: 85%+ (Chrome 115+, Edge 115+)
 * Allows creating named scroll timelines for reusable scroll-driven animations
 */

@supports (scroll-timeline-name: none) or (scroll-timeline-axis: block)
  // Named scroll timeline utilities
  .timeline-page
    scroll-timeline-name --page-scroll
    scroll-timeline-axis block

  .timeline-page-inline
    scroll-timeline-name --page-scroll
    scroll-timeline-axis inline

  .timeline-vertical
    scroll-timeline-name --vertical-scroll
    scroll-timeline-axis block

  .timeline-horizontal
    scroll-timeline-name --horizontal-scroll
    scroll-timeline-axis inline

  // View timeline for enter/exit animations
  .view-timeline-main
    view-timeline-name --main
    view-timeline-axis block

  .view-timeline-inline
    view-timeline-name --inline
    view-timeline-axis inline

  // Timeline scope - define reusable named timelines
  .timeline-scope-page
    timeline-scope --page-scroll

  .timeline-scope-vertical
    timeline-scope --vertical-scroll

  .timeline-scope-horizontal
    timeline-scope --horizontal-scroll

  // View timeline insets - adjust when view animations start/end
  .view-inset-start
    view-timeline-inset start 0%

  .view-inset-end
    view-timeline-inset end 0%

  .view-inset-both
    view-timeline-inset start 10% end 10%

/* Animation range utilities for fine-tuning scroll-driven animations */

@supports (animation-range: 0%)
  // Entry animations - element entering viewport
  .range-entry-cover
    animation-range entry 0% cover 100%

  .range-entry-25
    animation-range entry 0% cover 25%

  .range-entry-50
    animation-range entry 0% cover 50%

  .range-entry-75
    animation-range entry 0% cover 75%

  // Exit animations - element leaving viewport
  .range-exit-cover
    animation-range exit 0% cover 100%

  .range-exit-25
    animation-range exit 0% cover 25%

  .range-exit-50
    animation-range exit 0% cover 50%

  // Cross animations - element crossing through viewport
  .range-cross-cover
    animation-range crossfade 0% cover 100%

  // Contain animations - element contained in viewport
  .range-contain-cover
    animation-range contain 0% contain 100%

/* Disable scroll-driven animations for users who prefer reduced motion */
@media (prefers-reduced-motion reduce)
  .mw-parser-output > *
  .infobox
  .thumb.tright
  .thumb.tleft
  .navbox
  .vertical-navbox
  pre
  .mw-highlight
  .gallery
  .mw-gallery-traditional
  .references
  .ref-list
    animation none !important
    animation-timeline none !important


// Remove hover-dependent UI and enhance touch experience
// Use alongside @media (hover: hover) for devices with hover capability

@media (hover none) and (pointer coarse)
  // Hide hover-dependent elements that don't work on touch
  .tooltip
  .mw-title .mw-editsection-like
    visibility hidden

  // Remove hover states that can stick on touch
  a:hover
  button:hover
  .mw-ui-button:hover
    background-color inherit

  // Touch-friendly link targets
  .mw-body-content a
    padding 0.5em 0.25em // Larger tap area
    margin -0.5em -0.25em // Maintain layout while expanding tap area

  // Disable hover-based dropdowns - use tap/click instead
  .vector-sticky-pinned-container
  .mw-sidebar
    &:hover .dropdown-menu
      display none

    .dropdown-menu
      display block // Always visible on touch
      position relative
      opacity 1
      visibility visible
      pointer-events auto

  // Larger touch targets for navigation
  #mw-head .vector-sticky-pinned-container::after
    min-height 48px

  // Remove hover-based image previews
  .mw-wiki-logo
    opacity 1

  // Touch-friendly TOC
  #toc
    a
      padding 0.75em 0.5em

    li
      margin 0.25em 0

// =============================================================================
// INSET SHORTHAND - Logical Positioning
// =============================================================================

// The inset property is the logical equivalent of top/right/bottom/left
// Provides flow-relative positioning for better RTL support
// Browser support: 97%+

// Full coverage - replaces top: 0; right: 0; bottom: 0; left: 0;
.inset-cover
  inset 0

// Center positioning
.inset-center
  inset 50%
  translate -50% -50%

// Inset from all sides with custom value
.inset-space
  &-xs
    inset 0.25rem
  &-sm
    inset 0.5rem
  &-md
    inset 1rem
  &-lg
    inset 1.5rem
  &-xl
    inset 2rem

// Vertical inset only (top/bottom)
.inset-vertical
  &-sm
    inset-block 0.5rem
  &-md
    inset-block 1rem
  &-lg
    inset-block 1.5rem

// Horizontal inset only (left/right)
.inset-horizontal
  &-sm
    inset-inline 0.5rem
  &-md
    inset-inline 1rem
  &-lg
    inset-inline 1.5rem

// Inset-start (left in LTR, right in RTL)
.inset-start
  &-sm
    inset-inline-start 0.5rem
  &-md
    inset-inline-start 1rem
  &-lg
    inset-inline-start 1.5rem

// Inset-end (right in LTR, left in RTL)
.inset-end
  &-sm
    inset-inline-end 0.5rem
  &-md
    inset-inline-end 1rem
  &-lg
    inset-inline-end 1.5rem

// Inset-block (top/bottom)
.inset-block
  &-sm
    inset-block 0.5rem
  &-md
    inset-block 1rem
  &-lg
    inset-block 1.5rem

// Inset-inline (left/right)
.inset-inline
  &-sm
    inset-inline 0.5rem
  &-md
    inset-inline 1rem
  &-lg
    inset-inline 1.5rem

// Fixed positioning with inset shorthand
.fixed-cover
  position fixed
  inset 0

.fixed-center
  position fixed
  inset 50%
  translate -50% -50%

// Absolute positioning with inset for filling container
.absolute-cover
  position absolute
  inset 0

// Sticky positioning improvements
.sticky-cover
  position sticky
  inset-block-start 0

// =============================================================================
// UPDATE MEDIA QUERY - Display Refresh Capability
// =============================================================================

// Detect display refresh capability
// Browser support: 92%+
// Useful for e-ink displays (slow update) or high-refresh displays (fast)
// @media (update: slow) - display updates slowly (e-ink)
// @media (update: none) - no updates possible (printed)
// @media (update: fast) - frequent updates (typical screens)

// E-ink / slow display optimization
@media (update slow)
  // Disable smooth animations for e-ink displays
  *
  *::before
  *::after
    animation-duration 0.01ms !important
    animation-iteration-count 1 !important
    transition-duration 0.01ms !important
    scroll-behavior auto !important

  // Keep essential transitions but make them instant
  a
  button
  .mw-ui-button
    transition-duration 0.01ms !important

  // Disable motion-heavy effects
  .vector-sticky-pinned-container
  .mw-parser-output
  #content
    // Reduce or disable parallax effects
    transform none !important

  // Simplify shadows for e-ink
  .mbox
  .ambox
  .infobox
  .thumb
    box-shadow none !important

// No update possible (printed output)
@media (update none)
  // Additional print-like restrictions
  .vector-sticky-pinned-container
  .mw-sidebar
  #vector-main-menu
    display none !important

  // Ensure all content is visible
  body
    overflow visible !important

// Fast update (typical screens) - no restrictions needed
// This is the default and needs no special handling

// =============================================================================
// CUSTOM HIGHLIGHT API - JavaScript-Driven Highlights
// =============================================================================

// Note: ::highlight pseudo-element support is 85%+ (Chrome 105+, Edge 105+)
// Requires JavaScript API pairing for custom highlights
// Below are styles using data attributes that work with JS highlight APIs

// Search results highlight - purple theme for found text
[data-highlight="search"]
  background rgba($arch-blue, 0.3)
  color inherit
  border-radius 2px
  padding-inline 1px

// Custom annotation highlight - for user-added notes
[data-highlight="annotation"]
  background rgba($arch-blue, 0.2)
  border-bottom 2px solid $arch-blue

// Find match highlight - in-document search
[data-highlight="find"]
  background rgba($orange, 0.35)
  border-radius 2px

// Current match highlight - active find result
[data-highlight="current"]
  background rgba($orange, 0.5)
  border-radius 2px
  box-shadow 0 0 0 2px rgba($orange, 0.3)

// Quote highlight - for citation highlighting
[data-highlight="quote"]
  background rgba($green, 0.15)
  border-inline-start 3px solid $green
  padding-inline-start 0.5em

// Code highlight - for code snippet highlighting
[data-highlight="code"]
  background rgba($orange, 0.15)
  font-family $font-mono
  font-size 0.95em

// Region highlight - for highlighted regions/sections
[data-highlight="region"]
  background rgba($secondary-blue, 0.2)
  outline 1px dashed $secondary-blue

// Dimmed highlight - for less important matches
[data-highlight="dimmed"]
  background rgba($muted, 0.15)
  color $muted

// Highlight animation for attention
.highlight-pulse
  animation highlight-pulse 0.6s ease-out

@keyframes highlight-pulse
  0%
    background-color rgba($arch-blue, 0.5)
  100%
    background-color transparent

// =============================================================================
// ::HIGHLIGHT() PSEUDO-ELEMENT - CSS Custom Highlight API
// =============================================================================
// Browser support: 85%+ (Chrome 105+, Edge 105+, Safari pending)
// Requires JavaScript API pairing. This provides native text highlighting
// without modifying the DOM.
// ---
// JAVASCRIPT USAGE:
// ---------------------------------------------------------------------------
// The CSS.highlights API is used to apply named highlights to text ranges.
// Each highlight type (:highlight(name)) is styled via CSS below.
// ---
// Basic Usage:
//   const range = document.createRange();
//   range.selectNode(document.querySelector('.some-text'));
//   CSS.highlights.set('search-results', new StaticRange({ start: range.startContainer, end: range.endContainer, startOffset: range.startOffset, endOffset: range.endOffset }));
// ---
// Clear a highlight:
//   CSS.highlights.delete('search-results');
// ---
// Highlight Types Supported:
//   'search-results'  — found text in page search (purple theme)
//   'search-current' — active/current match (orange theme)
//   'annotation'     — user-added notes/marks
//   'custom-selection' — custom selection highlighting
//   'quote'          — citation/reference highlighting
//   'error'          — validation error highlighting
//   'warning'        — caution/warning highlighting
//   'link-found'     — discovered links within content
// ---
// Example: Page Search Integration:
//   document.querySelectorAll('.search-result').forEach((el, i) => {
//     el.addEventListener('click', () => {
//       const range = document.createRange();
//       range.selectNode(el);
//       CSS.highlights.set('search-current', new StaticRange({
//         start: range.startContainer, end: range.endContainer,
//         startOffset: range.startOffset, endOffset: range.endOffset
//       }));
//     });
//   });
// ---
// ---------------------------------------------------------------------------
// Fallback: data-highlight attributes work without JS (see below).
// The .highlight-range utility class provides a CSS-only fallback.
// stylelint-disable-next-line selector-type-no-unknown
@css {
  /* Highlight color tokens - theme-consistent oklch values (85%+ browser support) */
  /* ::highlight() pseudo-element support: Chrome 105+, Edge 105+, Safari (pending) */

  /* Search results highlight - found text in page search */
  ::highlight(search-results) {
    background-color: oklch(65% 0.18 285 / 35%);
    color: inherit;
  }

  /* Current/active search match highlight */
  ::highlight(search-current) {
    background-color: oklch(68% 0.16 55 / 50%);
    color: inherit;
  }

  /* Annotation highlight - user-added notes/marks */
  ::highlight(annotation) {
    background-color: oklch(58% 0.16 282 / 25%);
  }

  /* Selection-like highlight for custom selections */
  ::highlight(custom-selection) {
    background-color: oklch(68% 0.14 158 / 30%);
  }

  /* Quote highlight - for citation/reference highlighting */
  ::highlight(quote) {
    background-color: oklch(72% 0.16 168 / 20%);
  }

  /* Error highlight for validation errors */
  ::highlight(error) {
    background-color: oklch(58% 0.18 18 / 25%);
    text-decoration: underline wavy oklch(58% 0.18 18);
  }

  /* Warning highlight for caution items */
  ::highlight(warning) {
    background-color: oklch(78% 0.14 88 / 30%);
  }

  /* Link highlight - for discovered links within content */
  ::highlight(link-found) {
    background-color: oklch(65% 0.16 268 / 20%);
    text-decoration: underline;
  }

  /* ::search-text: browser-native "Find in page" search result highlights */
  /* Supported in: Chrome 123+, Firefox 129+, Safari 18.1+ (~87% global) */
  ::search-text {
    background-color: oklch(65% 0.18 285 / 40%);
    color: inherit;
    border-radius: 2px;
  }
}

// Utility class to work with JS highlight API
.highlight-range
  background-color rgba($arch-blue, 0.25)
  color inherit

// =============================================================================
// CUSTOM CUBIC-BEZIER EASING CURVES - Utility Classes
// =============================================================================
// Common easing curve presets via cubic-bezier()
// Browser support: 97%+
// Usage: class="ease-in-out" or style="transition: cubic-bezier(...)"
// These provide smoother alternatives to named timing functions

// =============================================================================
// EASING CURVE UTILITIES
// Standard easing curves (replicate CSS named easings)
// =============================================================================

// Linear - constant speed throughout
.ease-linear
  transition-timing-function linear
  animation-timing-function linear

// Ease (default browser) - subtle acceleration and deceleration
.ease
  transition-timing-function cubic-bezier(0.25, 0.1, 0.25, 1)
  animation-timing-function cubic-bezier(0.25, 0.1, 0.25, 1)

// Ease-in - slow start, fast end (like ease-in)
.ease-in
  transition-timing-function cubic-bezier(0.42, 0, 1, 1)
  animation-timing-function cubic-bezier(0.42, 0, 1, 1)

// Ease-out - fast start, slow end (like ease-out)
.ease-out
  transition-timing-function cubic-bezier(0, 0, 0.58, 1)
  animation-timing-function cubic-bezier(0, 0, 0.58, 1)

// Ease-in-out - slow start and end (like ease-in-out)
.ease-in-out
  transition-timing-function cubic-bezier(0.42, 0, 0.58, 1)
  animation-timing-function cubic-bezier(0.42, 0, 0.58, 1)

// =============================================================================
// SPECIALIZED EASING CURVES
// Common animation patterns
// =============================================================================

// Ease-out-start - fast then slow (decelerating)
.ease-out-start
  transition-timing-function cubic-bezier(0, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0, 0, 0.2, 1)

// Ease-in-end - slow then fast (accelerating)
.ease-in-end
  transition-timing-function cubic-bezier(0.4, 0, 1, 1)
  animation-timing-function cubic-bezier(0.4, 0, 1, 1)

// Ease-in-out-start - slow start, fast middle, slow end
.ease-in-out-start
  transition-timing-function cubic-bezier(0, 0, 0.3, 1)
  animation-timing-function cubic-bezier(0, 0, 0.3, 1)

// Ease-in-out-end - slow start, fast middle, slow end
.ease-in-out-end
  transition-timing-function cubic-bezier(0.7, 0, 1, 1)
  animation-timing-function cubic-bezier(0.7, 0, 1, 1)

// =============================================================================
// SPRING / BOUNCE EASING
// Elastic feel with overshoot
// =============================================================================

// Gentle spring - subtle bounce
.spring-gentle
  transition-timing-function cubic-bezier(0.34, 1.56, 0.64, 1)
  animation-timing-function cubic-bezier(0.34, 1.56, 0.64, 1)

// Spring - noticeable bounce
.spring
  transition-timing-function cubic-bezier(0.68, -0.55, 0.265, 1.55)
  animation-timing-function cubic-bezier(0.68, -0.55, 0.265, 1.55)

// Bounce-in - energetic entry with overshoot
.bounce-in
  transition-timing-function cubic-bezier(0.175, 0.885, 0.32, 1.275)
  animation-timing-function cubic-bezier(0.175, 0.885, 0.32, 1.275)

// Bounce-out - energetic exit with overshoot
.bounce-out
  transition-timing-function cubic-bezier(0.34, 1.56, 0.64, 1)
  animation-timing-function cubic-bezier(0.34, 1.56, 0.64, 1)

// =============================================================================
// SMOOTH CURVES
// Gentle, professional transitions
// =============================================================================

// Smooth - very gentle, professional feel
.smooth
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.2, 1)

// Smooth-in - smooth acceleration
.smooth-in
  transition-timing-function cubic-bezier(0.4, 0, 0.6, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.6, 1)

// Smooth-out - smooth deceleration
.smooth-out
  transition-timing-function cubic-bezier(0, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0, 0, 0.2, 1)

// Smooth-in-out - smooth acceleration and deceleration
.smooth-in-out
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.2, 1)

// =============================================================================
// SHARP CURVES
// Quick, snappy transitions
// =============================================================================

// Sharp - quick snap
.sharp
  transition-timing-function cubic-bezier(0.4, 0, 0.6, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.6, 1)

// Sharp-in - sharp acceleration
.sharp-in
  transition-timing-function cubic-bezier(0.4, 0, 1, 1)
  animation-timing-function cubic-bezier(0.4, 0, 1, 1)

// Sharp-out - sharp deceleration
.sharp-out
  transition-timing-function cubic-bezier(0, 0, 0.6, 1)
  animation-timing-function cubic-bezier(0, 0, 0.6, 1)

// =============================================================================
// SLIDE / MOTION CURVES
// Directional movement patterns
// =============================================================================

// Slide-left - accelerate right to left
.slide-left
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.2, 1)

// Slide-right - accelerate left to right
.slide-right
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.2, 1)

// Slide-up - accelerate bottom to top
.slide-up
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.2, 1)

// Slide-down - accelerate top to bottom
.slide-down
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  animation-timing-function cubic-bezier(0.4, 0, 0.2, 1)

// =============================================================================
// FADE CURVES
// Opacity-focused transitions
// =============================================================================

// Fade-in - subtle fade with gentle entry
.fade-in
  transition-timing-function ease-out
  animation-timing-function ease-out

// Fade-out - subtle fade with gentle exit
.fade-out
  transition-timing-function ease-in
  animation-timing-function ease-in

// =============================================================================
// STEPS() WITH JUMP KEYWORDS - Discrete Animations
// Browser support: 97%+
// Discrete animations that change at boundaries without interpolation
// Unlike cubic-bezier/ease curves which interpolate, steps() jumps between values
// jump-start: first jump occurs at start of animation (no hold at beginning)
// jump-end: last jump occurs at end of animation (no hold at end) - DEFAULT
// jump-both: jumps occur at start and end (no hold at either end)
// jump-none: holds at both ends before jumping (opposite of jump-both)
// Use for: frame-by-frame animations, sprite sheets, countdown timers,
// progress indicators, typewriter effects, pixel-art animations
// =============================================================================

// Steps-jump-start - no hold at beginning, first jump immediately
.steps-jump-start
  animation-timing-function steps(5, jump-start)

// Steps-jump-end - no hold at end, last jump at end
.steps-jump-end
  animation-timing-function steps(5, jump-end)

// Steps-jump-both - no hold at either end (jumps at both boundaries)
.steps-jump-both
  animation-timing-function steps(5, jump-both)

// Steps-jump-none - holds at both ends (most common, like pause before/after)
.steps-jump-none
  animation-timing-function steps(5, jump-none)

// Reduced motion: disable step animations for sensitive users
@media (prefers-reduced-motion reduce)
  .steps-jump-start
  .steps-jump-end
  .steps-jump-both
  .steps-jump-none
    animation none

// =============================================================================
// REDUCED MOTION OVERRIDES
// Ensure smooth experience for motion-sensitive users
// =============================================================================

@media (prefers-reduced-motion reduce)
  .spring-gentle
  .spring
  .bounce-in
  .bounce-out
    transition-timing-function ease-out
    animation-timing-function ease-out

  .sharp
  .sharp-in
  .sharp-out
    transition-timing-function ease-out
    animation-timing-function ease-out

  .slide-left
  .slide-right
  .slide-up
  .slide-down
    transition-timing-function ease-out
    animation-timing-function ease-out

// Reduced motion for highlights
@media (prefers-reduced-motion reduce)
  .highlight-pulse
    animation none

  [data-highlight]
    transition none
