// =============================================================================

// Hover capability detection
// Browser support: 97%+

@media (hover hover)
  .hover-only
    display block
  .touch-only
    display none

@media (hover none)
  .hover-only
    display none
  .touch-only
    display block

// Pointer precision
@media (pointer fine)
  .fine-pointer
    // Smaller targets OK

@media (pointer coarse)
  // Increase touch targets
