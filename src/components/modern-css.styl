// =============================================================================
// ::target-text PSEUDO-ELEMENT
// =============================================================================

// Style text highlighted by URL fragments (#:~:text=...)
// Browser support: 85%+ (Chrome 89+, Safari 17.2+, Edge 89+)
// Note: Uses theme accent color for highlighted text

@css {
  ::target-text {
    background-color: rgba(199, 146, 234, 0.3); /* --arch-blue with alpha */
    color: inherit;
    text-shadow: none;
  }

  /* Dark mode variant */
  @media (prefers-color-scheme: dark) {
    ::target-text {
      background-color: rgba(199, 146, 234, 0.4);
    }
  }
}

// Alternative approach using custom properties
// For browsers that support ::target-text with custom properties
.target-text-highlight
  background-color rgba($arch-blue, 0.3)
  color inherit

// =============================================================================
// ATTR() WITH TYPE() FUNCTION - Dynamic Values from HTML Attributes
// =============================================================================

// Note: attr() with type() support is growing (90%+ browser support)
// Allows parsing HTML attributes as typed CSS values
// Enables dynamic component sizing and styling from data attributes
// Using @css for attr() type() syntax since Stylus doesn't support it

@css {
  @supports (width: attr(data-width px)) {
    /* Dynamic sizing from data attributes */
    /* Components can be sized via HTML data-* attributes */

    /* Dynamic width components */
    [data-width] {
      width: attr(data-width px);
    }

    /* Dynamic height components */
    [data-height] {
      height: attr(data-height px);
    }

    /* Dynamic max-width constraints */
    [data-max-width] {
      max-width: attr(data-max-width px);
    }

    /* Dynamic min-width constraints */
    [data-min-width] {
      min-width: attr(data-min-width px);
    }

    /* Dynamic padding */
    [data-padding] {
      padding: attr(data-padding em);
    }

    /* Dynamic margin */
    [data-margin] {
      margin: attr(data-margin em);
    }

    /* Dynamic gap for flex/grid containers */
    [data-gap] {
      gap: attr(data-gap em);
    }

    /* Card components with dynamic sizing */
    .archwiki-card[data-card-width] {
      width: attr(data-card-width px);
      max-width: 100%;
    }

    /* Sidebar with configurable width */
    .mw-sidebar[data-sidebar-width] {
      width: attr(data-sidebar-width px);
      min-width: attr(data-sidebar-width px);
    }

    /* Infobox with dynamic sizing */
    .infobox[data-infobox-width] {
      width: attr(data-infobox-width px);
    }

    /* Code blocks with configurable max-height */
    pre[data-max-lines] {
      max-height: attr(data-max-lines em, 20em);
    }

    /* Progress bars with dynamic value */
    progress[data-progress]::progress-bar {
      width: attr(data-progress %);
    }

    /* Dynamic border radius */
    [data-radius] {
      border-radius: attr(data-radius px);
    }

    /* Dynamic font size */
    [data-font-size] {
      font-size: attr(data-font-size rem);
    }

    /* Color values from data attributes */
    /* Note: attr() with type(<color>) has limited support */

    /* Dynamic accent color for buttons */
    .mw-ui-button[data-accent-color] {
      background-color: attr(data-accent-color type(<color>), var(--theme-arch-blue));
      border-color: attr(data-accent-color type(<color>), var(--theme-arch-blue));
    }

    /* Dynamic text color */
    [data-text-color] {
      color: attr(data-text-color type(<color>), var(--theme-light));
    }

    /* Dynamic background color */
    [data-bg-color] {
      background-color: attr(data-bg-color type(<color>), var(--theme-base));
    }

    /* Dynamic border color */
    [data-border-color] {
      border-color: attr(data-border-color type(<color>), var(--theme-arch-blue));
    }

    /* Status indicators with dynamic colors */
    .status-indicator[data-status-color] {
      background-color: attr(data-status-color type(<color>));
      border-color: attr(data-status-color type(<color>));
    }

    /* Tag/badge components with dynamic colors */
    .archwiki-tag[data-tag-color] {
      background-color: attr(data-tag-color type(<color>), var(--theme-arch-blue));
      color: var(--theme-darker);
    }

    /* Alert boxes with dynamic accent */
    .mw-message-box[data-box-accent] {
      border-left-color: attr(data-box-accent type(<color>), var(--theme-arch-blue));
    }

    /* Highlight elements with dynamic background */
    .highlight[data-highlight-color] {
      background-color: attr(data-highlight-color type(<color>), rgba(137, 80, 199, 0.2));
    }

    /* Navigation items with dynamic active color */
    .vector-menu-item[data-active-color].active {
      background-color: attr(data-active-color type(<color>), var(--theme-arch-blue));
    }

    /* Progress indicators */
    .progress-bar[data-progress-color] {
      background-color: attr(data-progress-color type(<color>), var(--theme-arch-blue));
    }

    /* Fallback values with var() */
    /* attr() supports fallback values */
    [data-spacing] {
      padding: attr(data-spacing rem, 1rem);
    }

    /* Complex selectors combining multiple attrs */
    .archwiki-component[data-width][data-height] {
      width: attr(data-width px);
      height: attr(data-height px);
    }

    /* Responsive components using attr with media queries */
    /* Note: attr() values are computed, not reactive to media changes */
    /* Use CSS custom properties for reactive values */

    /* Grid layouts with dynamic columns */
    [data-columns] {
      grid-template-columns: repeat(attr(data-columns type(<integer>), 3), 1fr);
    }

    /* List styling with dynamic marker */
    ol[data-start] {
      counter-reset: item attr(data-start type(<integer>), 1);
    }
  }
}

// Fallback for browsers without attr() type() support
// Uses CSS custom properties as alternative

.archwiki-card
  --card-width auto
  width var(--card-width)
  max-width 100%

.mw-sidebar
  --sidebar-width 250px
  width var(--sidebar-width)
  min-width var(--sidebar-width)

.infobox
  --infobox-width 300px
  width var(--infobox-width)

.mw-ui-button[data-accent-color]
  --button-accent var(--theme-arch-blue)
  background-color var(--button-accent)
  border-color var(--button-accent)

// JavaScript can set these custom properties as fallback
// Example JS: element.style.setProperty('--card-width', '400px')


// =============================================================================
// @FONT-PALETTE-VALUES - Custom Color Font Palettes (87%+ browser support)
// =============================================================================

// Define custom palettes for emoji and color fonts
// Usage: font-palette: --emoji-void;
@css{}

@font-palette-values --emoji-void
  --font-color-1 #8950c7
  --font-color-2 #c7b8ff
  --font-color-3 #fd7cff

@font-palette-values --emoji-archive
  --font-color-1 #29adff
  --font-color-2 #00a8a4
  --font-color-3 #42ff97

@font-palette-values --emoji-contrast
  --font-color-1 #ffffff
  --font-color-2 #bfbfbf
  --font-color-3 #e7e7e7

// CSS custom property for JS-based palette selection
:root
  --custom-palette normal


// =============================================================================
// @MEDIA (HOVER: NONE) - Touch-Only Devices (97%+ browser support)
// =============================================================================

// Touch-only devices (phones, tablets without mouse/trackpad)
// Remove hover-dependent UI and enhance touch experience
// Use alongside @media (hover: hover) for devices with hover capability

@media (hover none) and (pointer coarse)
  // Hide hover-dependent elements that don't work on touch
  .tooltip
  .mw-title .mw-editsection-like
    visibility hidden

  // Remove hover states that can stick on touch
  a:hover
  button:hover
  .mw-ui-button:hover
    background-color inherit

  // Touch-friendly link targets
  .mw-body-content a
    padding 0.5em 0.25em // Larger tap area
    margin -0.5em -0.25em // Maintain layout while expanding tap area

  // Disable hover-based dropdowns - use tap/click instead
  .vector-sticky-pinned-container
  .mw-sidebar
    &:hover .dropdown-menu
      display none

    .dropdown-menu
      display block // Always visible on touch
      position relative
      opacity 1
      visibility visible
      pointer-events auto

  // Larger touch targets for navigation
  #mw-head .vector-sticky-pinned-container::after
    min-height 48px

  // Remove hover-based image previews
  .mw-wiki-logo
    opacity 1

  // Touch-friendly TOC
  #toc
    a
      padding 0.75em 0.5em

    li
      margin 0.25em 0
