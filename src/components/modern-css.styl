  a
    min-height 44px
    min-width 44px

// Any-hover/any-pointer for hybrid devices
@media (any-hover hover)
  .has-hover-capable
    display block

@media (any-pointer fine)
  .has-fine-pointer
    display block

// =============================================================================
// COLOR PREFERENCE QUERIES
// =============================================================================

// Forced colors (high contrast mode)
