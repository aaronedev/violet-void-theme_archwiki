// Modern CSS Features (Progressive Enhancement)
// Uses cutting-edge CSS features that may not be supported in all browsers
// These enhancements will be automatically applied where supported

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// CONTAINER QUERIES (@container) - Component-Based Responsive
// =============================================================================

// Note: @container support is good (89%+ browser support as of 2024)
// Allows components to respond to their container size, not just viewport

// Sidebar as a container
.mw-sidebar
#vector-main-menu
  container-type inline-size
  container-name sidebar

// Content area as a container
#content
.mw-body
  container-type inline-size
  container-name content

// TOC as a container
#toc
.toc
  container-type inline-size
  container-name toc

// Example: Adjust sidebar layout based on container width
@container sidebar (max-width: 250px)
  .vector-menu-content
    padding 0.25em

  .vector-menu-heading
    font-size 0.75em

// =============================================================================
// SCROLL-DRIVEN ANIMATIONS - Performance Animations
// =============================================================================

// Note: scroll() and view() support is growing (75%+ in 2024)
// These run on the compositor thread for better performance

// Fade in elements as they scroll into view
@supports (animation-timeline: view())
  .mw-heading
  .mw-parser-output > h2
  .mw-parser-output > h3
    animation fade-in-up both
    animation-timeline view()
    animation-range entry 0% entry 25%

  @keyframes fade-in-up
    from
      opacity 0
      transform translateY(20px)

    to
      opacity 1
      transform translateY(0)

// Parallax effect for page headers (subtle)
@supports (animation-timeline: scroll())
  .mw-first-heading
    animation parallax-header linear
    animation-timeline scroll()
    animation-range 0vh 50vh

  @keyframes parallax-header
    from
      transform translateY(0)

    to
      transform translateY(-10px)

// =============================================================================
// SCROLL STATE CONTAINERS (@scroll-state) - Scroll Snapping Detection
// =============================================================================

// Note: @scroll-state support is growing (85%+ browser support as of 2024)
// Allows querying scroll state in CSS - detecting snapped positions
// Using @css{} wrapper since Stylus doesn't natively support @scroll-state

/* stylelint-disable stylus/at-rule-no-unknown, selector-pseudo-class-no-unknown, stylus/single-line-comment */
@css {
  @supports (scroll-state: snapped) {
    /* TOC items - highlight when snapped into view */
    @scroll-state (snapped: y) {
      #toc li,
      .toc li {
        outline: 2px solid var(--accent-color, #6c5ce7);
        outline-offset: 2px;
      }
    }

    /* Scrollable sections with snap - visual feedback */
    .mw-parser-output {
      scroll-snap-type: y proximity;
    }

    /* Gallery items - highlight when snapped */
    .gallery-item {
      scroll-snap-align: center;
    }

    /* Carousel items - snap to center */
    .mwcarousel-item {
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }
  }

  /* :snapped pseudo-class for elements that are snapped */
  @supports (selector(:snapped)) {
    :snapped {
      outline: 2px solid var(--accent-color, #6c5ce7);
      outline-offset: 2px;
    }

    :snapped-y {
      border-left: 3px solid var(--accent-color, #6c5ce7);
    }

    :snapped-x {
      border-top: 3px solid var(--accent-color, #6c5ce7);
    }
  }
}
/* stylelint-enable */

// =============================================================================
// @starting-style - Entry Animations
// =============================================================================

// Note: @starting-style support is growing (85%+ in 2024)
// Allows defining initial styles for elements entering the DOM
// Using @css for @starting-style since Stylus doesn't support it

/* stylelint-disable stylus/single-line-comment, selector-type-no-unknown */
@css {
  @supports (@starting-style) {
    /* Dialogs and modals */
    dialog {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      dialog {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    /* Dropdowns */
    .vector-dropdown-content,
    .oo-ui-popupWidget-popup {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .vector-dropdown-content,
      .oo-ui-popupWidget-popup {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* Notifications */
    .mw-notification {
      opacity: 1;
      transform: translateX(0);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      .mw-notification {
        opacity: 0;
        transform: translateX(100%);
      }
    }
  }
}
/* stylelint-enable stylus/single-line-comment, selector-type-no-unknown */

// =============================================================================
// SUBGRID - Better Grid Alignment
// =============================================================================

// Note: subgrid support is good (88%+ in 2024)
// Allows nested grids to align with parent grid tracks

@supports (grid-template-rows: subgrid)
  // Table of contents with aligned items
  #toc ul
  .toc ul
    display grid
    grid-template-rows subgrid
    gap 0.25em

  // Infobox with aligned sections
  .infobox tbody
    display grid
    grid-template-rows subgrid

  // Navigation boxes
  .navbox-table tbody
    display grid
    grid-template-rows subgrid

// =============================================================================
// =============================================================================
// SCROLL SNAP - Better Scroll Behavior
// =============================================================================

// Enhanced scroll snapping for navigation
.vector-menu-content
  scroll-snap-type y proximity

  li
    scroll-snap-align start

// =============================================================================
// SCROLL PADDING - Account for Sticky Headers
// =============================================================================

// When navigating to anchors (hash links), the sticky header covers content.
// scroll-padding-top on html ensures the browser accounts for this offset.
// scroll-margin-top on targets ensures proper positioning for in-page links.

// Root scroll padding for hash navigation
html
  scroll-padding-top 5em

// TOC links need scroll margin for proper positioning
#toc a
.toc a
  scroll-margin-top 5em

// Headings as anchor targets need scroll margin
.mw-heading
h2[id]
h3[id]
h4[id]
  scroll-margin-top 5em

// Smooth scrolling for TOC links
@supports (scroll-behavior: smooth)
  #toc a
  .toc a
    scroll-behavior smooth

// =============================================================================
// BACKDROP FILTER - Frosted Glass Effects
// =============================================================================

// Note: backdrop-filter support is good (93%+ in 2024)
// Allows blur and other effects behind elements

@supports (backdrop-filter: blur(10px))
  // Sticky header with frosted glass
  .vector-sticky-header
    background rgba($base, 0.8)
    backdrop-filter blur(12px) saturate(180%)
    -webkit-backdrop-filter blur(12px) saturate(180%)

  // Dropdowns with frosted glass
  .vector-dropdown-content
  .oo-ui-popupWidget-popup
    background rgba($dark, 0.9)
    backdrop-filter blur(16px) saturate(180%)
    -webkit-backdrop-filter blur(16px) saturate(180%)

  // Modals with frosted glass
  .oo-ui-window-frame
    background rgba($base, 0.95)
    backdrop-filter blur(20px)
    -webkit-backdrop-filter blur(20px)


// =============================================================================
// REDUCED TRANSPARENCY - Accessibility Preference (92%+ browser support)
// =============================================================================

// Note: prefers-reduced-transparency support is good (92%+ as of 2024)
// Respects user preference for reduced transparency (Windows 10+ setting)

@media (prefers-reduced-transparency reduce)
  // Remove backdrop-filter transparency
  .vector-sticky-header
    background $dark !important
    backdrop-filter none !important
    -webkit-backdrop-filter none !important

  .vector-dropdown-content
  .oo-ui-popupWidget-popup
    background $base !important
    backdrop-filter none !important
    -webkit-backdrop-filter none !important

  .oo-ui-window-frame
    background $darker !important
    backdrop-filter none !important
    -webkit-backdrop-filter none !important

  // Solid backgrounds for panels
  .mw-sidebar
  #vector-main-menu
    background $darker !important

// =============================================================================

// FIELD SIZING - Auto-Growing Textareas
// =============================================================================

// Note: field-sizing support is new (Chrome 122+, 2024)
// Allows textareas to auto-grow based on content

@supports (field-sizing: content)
  textarea
  .oo-ui-textInputWidget-textarea
    field-sizing content
    min-height 3em
    max-height 20em

// =============================================================================
// :has() SELECTOR - Parent Selection Based on Children (89%+ browser support)
// =============================================================================

// Note: :has() support is good (89%+ as of 2024)
// Allows styling parents based on their children state
// Using @css for :has() selectors for better Stylus compatibility

@css {
  /* Form validation states */
  /* Highlight form containers with invalid inputs */
  .mw-htmlform-field:not(.mw-htmlform-autoinfuse-lazy):has(:invalid) {
    background: rgba(255, 68, 68, 0.05);
    border-left: 3px solid var(--arch-red, #ff4444);
    padding-left: 0.5em;
  }

  /* Success state for valid inputs */
  .mw-htmlform-field:not(.mw-htmlform-autoinfuse-lazy):has(:valid:not(:placeholder-shown)) {
    background: rgba(68, 255, 68, 0.05);
    border-left: 3px solid var(--arch-green, #44ff44);
    padding-left: 0.5em;
  }

  /* OOUI form validation */
  .oo-ui-fieldLayout:has(.oo-ui-inputWidget input:invalid) {
    background: rgba(255, 68, 68, 0.05);
    border-left: 3px solid var(--arch-red, #ff4444);
    padding-left: 0.5em;
  }

  /* Empty content detection */
  .mw-parser-output > *:has(:empty) {
    opacity: 0.5;
  }

  /* Highlight sections with empty paragraphs */
  .mw-heading:has(+ p:empty) {
    opacity: 0.6;
  }

  /* Parent styling based on children state */
  /* Style list items that contain links */
  li:has(> a) {
    margin-left: -0.5em;
    padding-left: 0.5em;
  }

  /* Highlight navigation items with active links */
  .vector-menu-content li:has(a.mw-selflink) {
    background: rgba(var(--arch-blue-rgb, 23, 147, 209), 0.1);
    font-weight: 600;
  }

  /* Table row highlighting based on cell class */
  /* Highlight rows with deprecated class */
  .wikitable tbody tr:has(td.deprecated) {
    opacity: 0.6;
    text-decoration: line-through;
  }

  /* Note: :contains() is not valid CSS - use JS or add classes to HTML for text-based selection */

  /* Card/list hover states affecting siblings */
  /* Dim sibling items when hovering */
  .mw-parser-output > ul > li:has(a:hover),
  .mw-parser-output > ol > li:has(a:hover) {
    opacity: 1;
  }

  .mw-parser-output > ul:has(li a:hover) > li:not(:has(a:hover)) {
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .mw-parser-output > ol:has(li a:hover) > li:not(:has(a:hover)) {
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  /* Infobox rows with images */
  .infobox tr:has(img) {
    text-align: center;
    background: rgba(var(--base-rgb, 25, 25, 35), 0.3);
  }

  /* Highlight sections containing code */
  .mw-heading:has(+ .mw-parser-output pre),
  .mw-heading:has(+ .mw-parser-output code) {
    border-left: 3px solid var(--arch-blue, #1793d1);
    padding-left: 0.5em;
  }

  /* Navigation boxes with nested content */
  .navbox-list:has(ul) {
    padding-left: 1em;
  }

  /* Categories box with items */
  .mw-normal-catlinks:has(ul li) {
    background: rgba(var(--base-rgb, 25, 25, 35), 0.2);
    padding: 0.5em;
    border-radius: 4px;
  }

  /* Table of contents with active section */
  #toc:has(a.active) {
    border-left: 3px solid var(--arch-blue, #1793d1);
  }

  /* Message boxes with icons */
  .mw-message-box:has(.mw-message-box-icon) {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
  }

  /* Form sections with required fields */
  .mw-htmlform-field:has([required]) {
    border-left: 2px solid var(--arch-blue, #1793d1);
  }

  /* Highlight template documentation */
  .mw-parser-output:has(.template-documentation) {
    border: 1px dashed rgba(var(--arch-blue-rgb, 23, 147, 209), 0.3);
    padding: 1em;
    margin: 1em 0;
  }
}

// =============================================================================
// TRANSITION BEHAVIOR - Discrete Property Transitions (80%+ browser support)
// =============================================================================

// Note: transition-behavior support is growing (Chrome 117+, Safari 17.5+, 80%+ as of 2024)
// Allows transitioning discrete properties like display, overlay, and visibility
// Must be combined with @starting-style for full enter/leave animations
// Using @css for transition-behavior since Stylus doesn't support the allow-discrete keyword

@css {
  @supports (transition-behavior: allow-discrete) {
    /* ==========================================================================
       COLLAPSIBLE SECTIONS - Smooth Expand/Collapse
       ========================================================================== */

    /* MediaWiki collapsible elements */
    .mw-collapsible {
      transition: display 0.3s allow-discrete, opacity 0.3s ease, max-height 0.3s ease;
    }

    .mw-collapsible.mw-collapsed {
      display: none;
    }

    /* HTML5 details/summary elements */
    details {
      transition: display 0.3s allow-discrete;
    }

    details[open] {
      display: block;
    }

    /* Details content animation */
    details > *:not(summary) {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      details > *:not(summary) {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* ==========================================================================
       DROPDOWNS & POPOVERS - Smooth Show/Hide
       ========================================================================== */

    /* Vector dropdown menus */
    .vector-dropdown-content {
      display: none;
      opacity: 0;
      transform: translateY(-10px);
      transition: display 0.2s allow-discrete, opacity 0.2s ease, transform 0.2s ease, overlay 0.2s allow-discrete;
    }

    .vector-dropdown:hover .vector-dropdown-content,
    .vector-dropdown:focus-within .vector-dropdown-content {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    @starting-style {
      .vector-dropdown:hover .vector-dropdown-content,
      .vector-dropdown:focus-within .vector-dropdown-content {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* OOUI popup widgets */
    .oo-ui-popupWidget-popup {
      display: none;
      opacity: 0;
      transform: translateY(-5px);
      transition: display 0.2s allow-discrete, opacity 0.2s ease, transform 0.2s ease, overlay 0.2s allow-discrete;
    }

    .oo-ui-popupWidget-popup:not([hidden]) {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    @starting-style {
      .oo-ui-popupWidget-popup:not([hidden]) {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* Native popovers */
    [popover] {
      display: none;
      opacity: 0;
      transform: scale(0.95);
      transition: display 0.25s allow-discrete, opacity 0.25s ease, transform 0.25s ease, overlay 0.25s allow-discrete;
    }

    [popover]:popover-open {
      display: block;
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      [popover]:popover-open {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    /* ==========================================================================
       MODALS & DIALOGS - Smooth Entry/Exit
       ========================================================================== */

    /* HTML5 dialog element */
    dialog {
      display: none;
      opacity: 0;
      transform: scale(0.95);
      transition: display 0.3s allow-discrete, opacity 0.3s ease, transform 0.3s ease, overlay 0.3s allow-discrete;
    }

    dialog[open] {
      display: block;
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      dialog[open] {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    /* OOUI modals */
    .oo-ui-window-frame {
      display: none;
      opacity: 0;
      transform: scale(0.9);
      transition: display 0.3s allow-discrete, opacity 0.3s ease, transform 0.3s ease, overlay 0.3s allow-discrete;
    }

    .oo-ui-window-frame:not([hidden]) {
      display: block;
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      .oo-ui-window-frame:not([hidden]) {
        opacity: 0;
        transform: scale(0.9);
      }
    }

    /* ==========================================================================
       NOTIFICATIONS & TOASTS - Slide Animations
       ========================================================================== */

    /* MediaWiki notifications */
    .mw-notification {
      display: none;
      opacity: 0;
      transform: translateX(100%);
      transition: display 0.3s allow-discrete, opacity 0.3s ease, transform 0.3s ease;
    }

    .mw-notification:not([hidden]) {
      display: block;
      opacity: 1;
      transform: translateX(0);
    }

    @starting-style {
      .mw-notification:not([hidden]) {
        opacity: 0;
        transform: translateX(100%);
      }
    }

    /* Echo notifications */
    .mw-echo-notification {
      display: none;
      opacity: 0;
      transform: translateY(-10px);
      transition: display 0.25s allow-discrete, opacity 0.25s ease, transform 0.25s ease;
    }

    .mw-echo-notification:not([hidden]) {
      display: flex;
      opacity: 1;
      transform: translateY(0);
    }

    @starting-style {
      .mw-echo-notification:not([hidden]) {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* ==========================================================================
       TABLE OF CONTENTS - Smooth Expand/Collapse
       ========================================================================== */

    /* TOC collapsible sections */
    .toc > ul {
      display: none;
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transition: display 0.25s allow-discrete, opacity 0.25s ease, max-height 0.25s ease;
    }

    .toc:not(.tochidden) > ul {
      display: block;
      opacity: 1;
      max-height: 2000px;
    }

    @starting-style {
      .toc:not(.tochidden) > ul {
        opacity: 0;
        max-height: 0;
      }
    }

    /* ==========================================================================
       SIDEBAR PANELS - Smooth Show/Hide
       ========================================================================== */

    /* Collapsible sidebar sections */
    .vector-menu-content {
      display: none;
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transition: display 0.25s allow-discrete, opacity 0.25s ease, max-height 0.25s ease;
    }

    .vector-menu:not(.collapsed) .vector-menu-content {
      display: block;
      opacity: 1;
      max-height: 2000px;
    }

    @starting-style {
      .vector-menu:not(.collapsed) .vector-menu-content {
        opacity: 0;
        max-height: 0;
      }
    }

    /* ==========================================================================
       MESSAGE BOXES - Dismissible Animations
       ========================================================================== */

    /* Dismissible message boxes */
    .mw-message-box[dismissible] {
      display: block;
      opacity: 1;
      max-height: 500px;
      transition: display 0.3s allow-discrete, opacity 0.3s ease, max-height 0.3s ease;
    }

    .mw-message-box.dismissed {
      display: none;
      opacity: 0;
      max-height: 0;
    }

    /* ==========================================================================
       UTILITY CLASSES - Reusable Transition Patterns
       ========================================================================== */

    /* Generic fade in/out */
    .fade-transition {
      display: none;
      opacity: 0;
      transition: display 0.3s allow-discrete, opacity 0.3s ease;
    }

    .fade-transition.visible {
      display: block;
      opacity: 1;
    }

    @starting-style {
      .fade-transition.visible {
        opacity: 0;
      }
    }

    /* Generic slide in/out */
    .slide-transition {
      display: none;
      opacity: 0;
      transform: translateY(20px);
      transition: display 0.3s allow-discrete, opacity 0.3s ease, transform 0.3s ease;
    }

    .slide-transition.visible {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    @starting-style {
      .slide-transition.visible {
        opacity: 0;
        transform: translateY(20px);
      }
    }

    /* Generic scale in/out */
    .scale-transition {
      display: none;
      opacity: 0;
      transform: scale(0.9);
      transition: display 0.3s allow-discrete, opacity 0.3s ease, transform 0.3s ease;
    }

    .scale-transition.visible {
      display: block;
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      .scale-transition.visible {
        opacity: 0;
        transform: scale(0.9);
      }
    }
  }
}

// Fallback for browsers without transition-behavior support
// These use traditional opacity/visibility transitions
@supports not (transition-behavior: allow-discrete)
  .mw-collapsible.mw-collapsed
    visibility hidden
    opacity 0
    max-height 0


  .vector-dropdown-content
    visibility hidden
    opacity 0


  .vector-dropdown:hover .vector-dropdown-content
    visibility visible
    opacity 1


  dialog
    visibility hidden
    opacity 0


  dialog[open]
    visibility visible
    opacity 1



// =============================================================================
// OVERLAY - Better Modal Positioning
// =============================================================================

// Note: overlay support is new (Chrome 117+, 2023)
// Simplifies positioning of overlays

@supports (overlay: auto)
  dialog
  .oo-ui-window-frame
    overlay auto

// =============================================================================
// PERFORMANCE HINTS
// =============================================================================

// Hint to browsers about rendering priority
.mw-parser-output
  content-visibility auto
  contain-intrinsic-size auto 500px

// Note: loading and decoding are HTML attributes, not CSS properties
// They should be set in HTML: <img loading="lazy" decoding="async">
// Including here for documentation purposes only

// =============================================================================
// ACCESSIBILITY IMPROVEMENTS
// =============================================================================

// Better focus indication
@supports (outline: auto)
  :focus-visible
    outline 2px solid $arch-blue
    outline-offset 2px

// High contrast mode support
/* stylelint-disable media-feature-colon, stylus/single-line-comment */
@media (forced-colors active)
  .mw-ui-button
  .cdx-button
    border 2px solid CurrentColor

  .oo-ui-checkboxInputWidget [type="checkbox"]
    border 2px solid CurrentColor
/* stylelint-enable media-feature-colon, stylus/single-line-comment */


// =============================================================================
// SPELLING & GRAMMAR ERROR STYLING
// =============================================================================
// Note: ::spelling-error and ::grammar-error are Chrome/Edge only
// Firefox doesn't support these - removed to prevent PostCSS build errors
// These pseudo-elements are not critical for theme functionality

// High contrast for reduced motion preference
@media screen and (prefers-reduced-motion reduce)
  [contenteditable="true"]
  textarea
    text-decoration-style solid
    text-decoration-thickness 3px

// =============================================================================
// PRINT ENHANCEMENTS
// =============================================================================

@media print
  // Ensure containers don't interfere with print
  .mw-sidebar
  #vector-main-menu
  #content
    container-type normal

  // Remove scroll-driven animations for print
  @supports (animation-timeline: view())
    *
      animation none !important

// =============================================================================
// @PROPERTY - Animatable CSS Custom Properties (93%+ browser support)
// =============================================================================

// Note: @property support is good (93%+ as of 2024)
// Allows defining typed custom properties with syntax, inheritance, and initial values
// Enables CSS transitions on custom properties for smooth theme changes
// Using @css for @property since Stylus doesn't support it

@css {
  /* Base theme colors */
  @property --theme-darker {
    syntax: '<color>';
    inherits: true;
    initial-value: #0f0f0f;
  }

  @property --theme-dark {
    syntax: '<color>';
    inherits: true;
    initial-value: #202020;
  }

  @property --theme-base {
    syntax: '<color>';
    inherits: true;
    initial-value: #181818;
  }

  @property --theme-light {
    syntax: '<color>';
    inherits: true;
    initial-value: #bfbfbf;
  }

  @property --theme-lighter {
    syntax: '<color>';
    inherits: true;
    initial-value: #e7e7e7;
  }

  @property --theme-white {
    syntax: '<color>';
    inherits: true;
    initial-value: #ffffff;
  }

  /* Accent colors */
  @property --theme-arch-blue {
    syntax: '<color>';
    inherits: true;
    initial-value: #8950c7;
  }

  @property --theme-secondary-blue {
    syntax: '<color>';
    inherits: true;
    initial-value: #c7b8ff;
  }

  @property --theme-red {
    syntax: '<color>';
    inherits: true;
    initial-value: #a80065;
  }

  @property --theme-secondary-red {
    syntax: '<color>';
    inherits: true;
    initial-value: #ff1a67;
  }

  @property --theme-green {
    syntax: '<color>';
    inherits: true;
    initial-value: #4bfe9b;
  }

  @property --theme-orange {
    syntax: '<color>';
    inherits: true;
    initial-value: #fd7cff;
  }

  /* UI colors */
  @property --theme-comment {
    syntax: '<color>';
    inherits: true;
    initial-value: #6f6f6f;
  }

  @property --theme-muted {
    syntax: '<color>';
    inherits: true;
    initial-value: #7a7a7a;
  }

  @property --theme-cell-delim {
    syntax: '<color>';
    inherits: true;
    initial-value: #252525;
  }
}

// Apply custom properties to root
:root
  --theme-darker $darker
  --theme-dark $dark
  --theme-base $base
  --theme-light $light
  --theme-lighter $lighter
  --theme-white $white
  --theme-arch-blue $arch-blue
  --theme-secondary-blue $secondary-blue
  --theme-red $red
  --theme-secondary-red $secondary-red
  --theme-green $green
  --theme-orange $orange
  --theme-comment $comment
  --theme-muted $muted
  --theme-cell-delim $cell-delim

// Example: Smooth color transitions using custom properties
// These transitions now work because @property defines types
@supports (background: paint(something))
  .mw-ui-button
  .cdx-button
    transition background-color 0.3s ease, color 0.3s ease

  .vector-dropdown-content
    transition background-color 0.2s ease

  .oo-ui-popupWidget-popup
    transition background-color 0.2s ease, border-color 0.2s ease

// =============================================================================
// =============================================================================
// COLOR-MIX() FUNCTION - Dynamic Color Mixing (97%+ browser support)
// =============================================================================

// Note: color-mix() support is excellent (97%+ as of 2024)
// Allows mixing two colors together in CSS without pre-computing variants
// Useful for hover states, transparency adjustments, and dynamic color variants
// Using @css for color-mix() since Stylus parser doesn't support it

@css {
  @supports (color: color-mix(in srgb, red, blue)) {
    :root {
      /* Hover state colors - lighter variants */
      --arch-blue-hover: color-mix(in srgb, var(--theme-arch-blue), white 15%);
      --secondary-blue-hover: color-mix(in srgb, var(--theme-secondary-blue), white 15%);
      --red-hover: color-mix(in srgb, var(--theme-red), white 15%);
      --secondary-red-hover: color-mix(in srgb, var(--theme-secondary-red), white 15%);
      --green-hover: color-mix(in srgb, var(--theme-green), white 15%);
      --orange-hover: color-mix(in srgb, var(--theme-orange), white 15%);

      /* Active/pressed state colors - darker variants */
      --arch-blue-active: color-mix(in srgb, var(--theme-arch-blue), black 15%);
      --secondary-blue-active: color-mix(in srgb, var(--theme-secondary-blue), black 15%);
      --red-active: color-mix(in srgb, var(--theme-red), black 15%);
      --secondary-red-active: color-mix(in srgb, var(--theme-secondary-red), black 15%);
      --green-active: color-mix(in srgb, var(--theme-green), black 15%);
      --orange-active: color-mix(in srgb, var(--theme-orange), black 15%);

      /* Transparent color variants for backgrounds and overlays */
      --arch-blue-t-10: color-mix(in srgb, var(--theme-arch-blue), transparent 90%);
      --arch-blue-t-20: color-mix(in srgb, var(--theme-arch-blue), transparent 80%);
      --arch-blue-t-30: color-mix(in srgb, var(--theme-arch-blue), transparent 70%);
      --arch-blue-t-50: color-mix(in srgb, var(--theme-arch-blue), transparent 50%);

      --secondary-blue-t-10: color-mix(in srgb, var(--theme-secondary-blue), transparent 90%);
      --secondary-blue-t-20: color-mix(in srgb, var(--theme-secondary-blue), transparent 80%);
      --secondary-blue-t-30: color-mix(in srgb, var(--theme-secondary-blue), transparent 70%);

      --red-t-10: color-mix(in srgb, var(--theme-red), transparent 90%);
      --red-t-20: color-mix(in srgb, var(--theme-red), transparent 80%);
      --red-t-30: color-mix(in srgb, var(--theme-red), transparent 70%);

      --green-t-10: color-mix(in srgb, var(--theme-green), transparent 90%);
      --green-t-20: color-mix(in srgb, var(--theme-green), transparent 80%);
      --green-t-30: color-mix(in srgb, var(--theme-green), transparent 70%);

      --orange-t-10: color-mix(in srgb, var(--theme-orange), transparent 90%);
      --orange-t-20: color-mix(in srgb, var(--theme-orange), transparent 80%);
      --orange-t-30: color-mix(in srgb, var(--theme-orange), transparent 70%);

      /* Muted color variants for secondary UI elements */
      --arch-blue-muted: color-mix(in srgb, var(--theme-arch-blue), var(--theme-muted) 40%);
      --secondary-blue-muted: color-mix(in srgb, var(--theme-secondary-blue), var(--theme-muted) 40%);
      --red-muted: color-mix(in srgb, var(--theme-red), var(--theme-muted) 40%);
      --green-muted: color-mix(in srgb, var(--theme-green), var(--theme-muted) 40%);
      --orange-muted: color-mix(in srgb, var(--theme-orange), var(--theme-muted) 40%);
    }

    /* Utility classes for color-mix */
    .text-hover-light:hover {
      color: color-mix(in srgb, currentColor, white 20%);
    }

    .text-hover-dark:hover {
      color: color-mix(in srgb, currentColor, black 20%);
    }

    .bg-hover-light:hover {
      background-color: color-mix(in srgb, currentColor, white 10%);
    }

    .bg-hover-dark:hover {
      background-color: color-mix(in srgb, currentColor, black 10%);
    }

    /* Button hover states using color-mix */
    .mw-ui-button:hover,
    .cdx-button:hover {
      background-color: color-mix(in srgb, var(--theme-arch-blue), white 15%);
    }

    .mw-ui-button:active,
    .cdx-button:active {
      background-color: color-mix(in srgb, var(--theme-arch-blue), black 15%);
    }

    /* Link hover states */
    a:hover {
      color: color-mix(in srgb, var(--theme-secondary-blue), white 15%);
    }

    a:active {
      color: color-mix(in srgb, var(--theme-secondary-blue), black 15%);
    }

    /* Code block hover */
    code:hover,
    pre:hover {
      background-color: color-mix(in srgb, var(--theme-base), var(--theme-arch-blue) 10%);
    }

    /* Table row hover */
    .wikitable tbody tr:hover {
      background-color: color-mix(in srgb, var(--theme-base), var(--theme-arch-blue) 5%);
    }

    /* Infobox header */
    .infobox th {
      background-color: color-mix(in srgb, var(--theme-darker), var(--theme-arch-blue) 20%);
    }

    /* Focus ring using color-mix */
    :focus-visible {
      outline-color: color-mix(in srgb, var(--theme-arch-blue), white 20%);
    }

    /* Selection color */
    ::selection {
      background-color: color-mix(in srgb, var(--theme-arch-blue), transparent 70%);
    }

    /* Scrollbar thumb */
    ::-webkit-scrollbar-thumb {
      background-color: color-mix(in srgb, var(--theme-comment), var(--theme-arch-blue) 30%);
    }

    ::-webkit-scrollbar-thumb:hover {
      background-color: color-mix(in srgb, var(--theme-comment), var(--theme-arch-blue) 50%);
    }
  }
}

// =============================================================================
// RELATIVE COLOR SYNTAX - Dynamic Color Variants (88%+ browser support)
// =============================================================================

// Note: Relative color syntax support is good (88%+ as of 2024)
// Allows creating color variants dynamically from base colors
// Using @css for relative color syntax since Stylus doesn't support it

@css {
  @supports (color: rgb(from red r g b)) {
    :root {
      /* Arch-blue variants */
      --arch-blue-light: rgb(from #8950c7 r g b / 0.5);
      --arch-blue-lighter: rgb(from #8950c7 r g b / 0.3);
      --arch-blue-dark: rgb(from #8950c7 calc(r * 0.8) calc(g * 0.8) calc(b * 0.8));
      --arch-blue-darker: rgb(from #8950c7 calc(r * 0.6) calc(g * 0.6) calc(b * 0.6));

      /* Secondary-blue variants */
      --secondary-blue-muted: rgb(from #c7b8ff r g b / 0.6);
      --secondary-blue-subtle: rgb(from #c7b8ff r g b / 0.3);
      --secondary-blue-dark: rgb(from #c7b8ff calc(r * 0.7) calc(g * 0.7) calc(b * 0.7));

      /* Red variants */
      --red-light: rgb(from #a80065 r g b / 0.5);
      --red-dark: rgb(from #a80065 calc(r * 0.8) calc(g * 0.8) calc(b * 0.8));

      /* Secondary-red variants */
      --secondary-red-muted: rgb(from #ff1a67 r g b / 0.6);
      --secondary-red-subtle: rgb(from #ff1a67 r g b / 0.3);

      /* Green variants */
      --green-muted: rgb(from #4bfe9b r g b / 0.6);
      --green-dark: rgb(from #4bfe9b calc(r * 0.7) calc(g * 0.7) calc(b * 0.7));

      /* Orange variants */
      --orange-muted: rgb(from #fd7cff r g b / 0.6);
      --orange-subtle: rgb(from #fd7cff r g b / 0.3);

      /* Base/UI variants */
      --base-lighter-opaque: rgb(from #181818 r g b / 0.8);
      --base-semi-transparent: rgb(from #181818 r g b / 0.5);
      --light-muted: rgb(from #bfbfbf r g b / 0.7);
      --light-subtle: rgb(from #bfbfbf r g b / 0.4);

      /* Comment/muted variants */
      --comment-light: rgb(from #6f6f6f calc(r * 1.2) calc(g * 1.2) calc(b * 1.2));
      --muted-light: rgb(from #7a7a7a calc(r * 1.2) calc(g * 1.2) calc(b * 1.2));
    }
  }
}

// FUTURE ENHANCEMENTS
// =============================================================================

// Modern CSS features that could be added in the future:
// - @layer for better cascade control (needs @css wrapper)
// - Trigonometric functions: sin(), cos(), tan()
// - Native CSS nesting (when dropping Stylus)

// =============================================================================
// ACCENT-COLOR - Native Form Control Styling (93%+ browser support)
// =============================================================================

// Provides native styling for checkboxes, radios, range inputs, and progress bars
@supports (accent-color: $arch-blue)
  :root
    accent-color $arch-blue

  // Form controls inherit accent color
  input[type="checkbox"]
  input[type="radio"]
  input[type="range"]
  progress
    accent-color $arch-blue

// =============================================================================
// TEXT-WRAP - Better Text Wrapping (Chrome 114+, Safari 17.4+)
// =============================================================================

// Balance headlines for better appearance
@supports (text-wrap: balance)
  h1
  h2
  h3
  .mw-heading
    text-wrap balance

// Pretty wrapping for paragraphs (prevents orphans)
@supports (text-wrap: pretty)
  p
  li
  dd
    text-wrap pretty

// =============================================================================
// SCROLLBAR-GUTTER - Prevent Layout Shift (90%+ browser support)
// =============================================================================

// Prevents layout shift when content overflows
@supports (scrollbar-gutter: stable)
  // Main content areas
  .mw-body
  #content
  .mw-parser-output
    scrollbar-gutter stable

  // Code blocks
  pre
  code
    scrollbar-gutter stable both-edges

  // Tables that might overflow
  .wikitable
  .infobox
  table.results
    scrollbar-gutter stable

  // Sidebars
  .mw-sidebar
  #vector-main-menu
    scrollbar-gutter stable

// =============================================================================
// @SCOPE - Component Isolation (88%+ browser support)
// =============================================================================

// Note: @scope support is good (88%+ as of 2024)
// Allows scoped styles that only apply within specific components
// Using @css for @scope since Stylus doesn't support it

@css {
  @supports (@scope) {
    /* Infobox scoped styles */
    @scope (.infobox) {
      th { background: rgba(137, 80, 199, 0.1); }
      td { border-color: rgba(137, 80, 199, 0.2); }
    }

    /* Wikitable scoped styles */
    @scope (.wikitable) {
      th { background: rgba(137, 80, 199, 0.08); }
    }

    /* Navigation scoped styles */
    @scope (.vector-menu) {
      li:hover { background: rgba(137, 80, 199, 0.05); }
    }
  }
}

// =============================================================================
// COLOR-GAMUT MEDIA QUERY FOR P3 DISPLAYS
// =============================================================================

// Detect wide-gamut (P3) displays and provide enhanced colors
// Browser support: 93%+
@supports (color: color(display-p3 1 1 1))
  @media (color-gamut p3)
    // More vibrant accent colors on capable hardware
    :root
      --arch-blue-p3 color(display-p3 0.537 0.314 0.78)
      --secondary-blue-p3 color(display-p3 0.78 0.722 1)
      --arch-blue var(--arch-blue-p3)
      --secondary-blue var(--secondary-blue-p3)

    // Enhanced gradients
    .gradient-primary
      background linear-gradient(135deg, var(--arch-blue-p3), var(--secondary-blue-p3))

// =============================================================================
// OKLCH COLOR SPACE
// =============================================================================
// Perceptually uniform color space with better L/C/H control than HSL
// Browser support: 90%+ (Chrome 111+, Safari 15.4+, Firefox 113+)
// Format: oklch(L% C H)
//   - L: lightness (0-100%)
//   - C: chroma (saturation intensity)
//   - H: hue (0-360 degrees)

// OKLCH provides consistent perceived brightness across hues
// Use for smooth color transitions and better gradient interpolation

// Example: Smooth color transitions using OKLCH
@supports (color: oklch(0 0 0))
  .color-transition
    transition color 0.3s ease

  // Interactive element states with OKLCH
  .oklch-link
    color $arch-blue
    transition color 0.2s ease

    &:hover
      color oklch(65% 0.22 280)

    &:active
      color oklch(45% 0.25 280)

// OKLCH gradients - smoother than HSL
// Note: gradient interpolation in oklch is supported in modern browsers
// Using direct oklch values for gradient colors
.gradient-oklch
  background linear-gradient(135deg, oklch(55% 0.2 280), oklch(80% 0.1 280))

.gradient-surface-oklch
  background linear-gradient(135deg, oklch(15% 0.025 280), oklch(12% 0.02 280))

// P3 gamut enhancement using OKLCH
@supports (color: oklch(0 0 0)) and (color: oklch(0 0.3 0))
  @media (color-gamut p3)
    :root
      // More saturated colors for P3 displays
      --oklch-arch-blue oklch(55% 0.25 280)
      --oklch-green oklch(70% 0.28 150)
      --oklch-orange oklch(70% 0.28 320)

    // Use OKLCH variants on P3 displays
    .oklch-enhanced
      color var(--oklch-arch-blue)

      &.accent-green
        color var(--oklch-green)

      &.accent-orange
        color var(--oklch-orange)

// =============================================================================
// :IS() FOR SELECTOR GROUPING
// =============================================================================

// Simplify complex selectors: :is(h1, h2, h3):hover
// Browser support: 97%+
// Stylus: Works directly

// Heading hover effects
:is(h1, h2, h3, h4, h5, h6):hover
  color $lighter

// Focus states for interactive elements
:is(a, button, input, select, textarea):focus-visible
  outline 2px solid $arch-blue
  outline-offset 2px

// Code and pre hover
:is(code, pre):hover
  background-color rgba($arch-blue, 0.05)

// =============================================================================
// :WHERE() FOR ZERO-SPECIFICITY SELECTORS
// =============================================================================

// Low-specificity overrides for theming
// Browser support: 97%+
// Stylus: Works directly

// Base link styles (easily overridden)
:where(a)
  color $secondary-blue
  text-decoration none

// Base list styles
:where(ul, ol)
  padding-inline-start 1.5em

// Base heading margins
:where(h1, h2, h3, h4, h5, h6)
  margin 0.5em 0


// =============================================================================
// ANIMATION-COMPOSITION FOR LAYERED ANIMATIONS
// =============================================================================

// Control how multiple animations combine
// Browser support: 87%+ (Chrome 112+, Safari 16+)

// Add animations together
.animate-add
  animation-composition add

// Accumulate animations
.animate-accumulate
  animation-composition accumulate

// Replace (default)
.animate-replace
  animation-composition replace


// =============================================================================
// BACKDROP-FILTER FOR GLASSMORPHISM
// =============================================================================

// Blur behind elements
// Browser support: 97%+

.glass
  backdrop-filter blur(10px)
  -webkit-backdrop-filter blur(10px)
  background-color rgba($base, 0.7)

.glass-strong
  backdrop-filter blur(20px) saturate(1.2)
  -webkit-backdrop-filter blur(20px) saturate(1.2)
  background-color rgba($base, 0.5)

// Navigation glass effect
.mw-header
#mw-head
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)

// =============================================================================
// FILTER EXPANSION
// =============================================================================

// Various filter effects
// Browser support: 97%+

// Blur unfocused elements
.blur-light
  filter blur(2px)

// Brightness adjustments
.brighten
  filter brightness(1.1)

.darken
  filter brightness(0.9)

// Saturate/desaturate
.saturate
  filter saturate(1.3)

.desaturate
  filter saturate(0)

// Grayscale for disabled states
.disabled
.muted-element
  filter grayscale(1)
  opacity 0.6

// Hue rotate for variations
.hue-shift
  filter hue-rotate(180deg)

// Invert for dark/light mode helpers
.invert
  filter invert(1)

// Sepia for vintage
.vintage
  filter sepia(0.5)

// Drop shadow for irregular shapes
.drop-shadow
  filter drop-shadow(2px 4px 8px rgba(0, 0, 0, 0.3))

// =============================================================================
// INDIVIDUAL TRANSFORM PROPERTIES
// =============================================================================

// translate, rotate, scale without transform shorthand
// Browser support: 97%+

.translate-up
  translate 0 -10px

.translate-center
  translate -50% -50%

.rotate-45
  rotate 45deg

.rotate-90
  rotate 90deg

.scale-up
  scale 1.1

.scale-down
  scale 0.9

// Combined transforms
.transform-hover:hover
  translate 0 -2px
  scale 1.02
  transition translate 0.2s, scale 0.2s


