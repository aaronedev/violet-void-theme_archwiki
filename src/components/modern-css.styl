.outline-native
  outline-style auto
  outline-color $arch-blue

// =============================================================================
// BORDER IMAGE
// =============================================================================

// border-image for decorative borders
// Browser support: 97%+

.border-image-gradient
  border-image linear-gradient(135deg, $arch-blue, $secondary-blue) 1

.border-image-slice
  border-image-slice 30

.border-image-round
  border-image-repeat round


// =============================================================================
