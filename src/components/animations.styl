// Animation Utilities and @starting-style for Entry/Exit Animations
// Browser support: 80%+ (Chrome 117+, Safari 17.5+)
// Enables CSS transitions on first render and display: none changes

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// @starting-style - ENTRY/EXIT ANIMATIONS
// =============================================================================
// Note: @starting-style support is growing (80%+ as of 2024)
// Allows defining initial styles for elements entering the DOM or changing display
// Must be combined with transition-behavior: allow-discrete for full effect
// Using @css for @starting-style since Stylus doesn't support it

@css {
  @supports (@starting-style) {
    /* ==========================================================================
       DIALOGS & MODALS - Smooth Entry/Exit
       ========================================================================== */

    /* HTML5 dialog element */
    dialog {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      dialog {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    /* OOUI modal dialogs */
    .oo-ui-window-frame {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      .oo-ui-window-frame {
        opacity: 0;
        transform: scale(0.9);
      }
    }

    /* ==========================================================================
       DROPDOWNS & POPOVERS - Smooth Show/Hide
       ========================================================================== */

    /* Vector dropdown menus */
    .vector-dropdown-content {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .vector-dropdown-content {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* OOUI popup widgets */
    .oo-ui-popupWidget-popup {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .oo-ui-popupWidget-popup {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* Native popovers */
    [popover] {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    @starting-style {
      [popover] {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    /* ==========================================================================
       NOTIFICATIONS & TOASTS - Slide Animations
       ========================================================================== */

    /* MediaWiki notifications */
    .mw-notification {
      opacity: 1;
      transform: translateX(0);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      .mw-notification {
        opacity: 0;
        transform: translateX(100%);
      }
    }

    /* Echo notifications */
    .mw-echo-notification {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    @starting-style {
      .mw-echo-notification {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* ==========================================================================
       COLLAPSIBLE SECTIONS - Smooth Expand/Collapse
       ========================================================================== */

    /* MediaWiki collapsible content */
    .mw-collapsible-content {
      opacity: 1;
      transition: opacity 0.3s ease;
    }

    @starting-style {
      .mw-collapsible-content {
        opacity: 0;
      }
    }

    /* Details/summary elements */
    details > *:not(summary) {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      details > *:not(summary) {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* TOC collapsible sections */
    .toc > ul,
    .vector-toc > ul {
      opacity: 1;
      transition: opacity 0.25s ease;
    }

    @starting-style {
      .toc > ul,
      .vector-toc > ul {
        opacity: 0;
      }
    }

    /* Sidebar collapsible sections */
    .vector-menu-content {
      opacity: 1;
      transition: opacity 0.25s ease;
    }

    @starting-style {
      .vector-menu-content {
        opacity: 0;
      }
    }

    /* Navbox collapsible sections */
    .navbox-content,
    .mw-navbox-content {
      opacity: 1;
      transition: opacity 0.25s ease;
    }

    @starting-style {
      .navbox-content,
      .mw-navbox-content {
        opacity: 0;
      }
    }

    /* ==========================================================================
       MESSAGE BOXES - Dismissible Animations
       ========================================================================== */

    /* Dismissible message boxes */
    .mw-message-box {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      .mw-message-box {
        opacity: 0;
        transform: scale(0.98);
      }
    }

    /* Ambox (article message boxes) */
    .ambox {
      opacity: 1;
      transition: opacity 0.3s ease;
    }

    @starting-style {
      .ambox {
        opacity: 0;
      }
    }

    /* ==========================================================================
       TOOLTIPS & HOVERCARDS - Fade In
       ========================================================================== */

    /* Reference tooltips */
    .mw-ref-tooltip,
    .reference-tooltip {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .mw-ref-tooltip,
      .reference-tooltip {
        opacity: 0;
        transform: translateY(5px);
      }
    }

    /* Page preview hovercards */
    .mwe-popups {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .mwe-popups {
        opacity: 0;
        transform: translateY(10px);
      }
    }

    /* ==========================================================================
       SEARCH AUTOCOMPLETE - Dropdown Animation
       ========================================================================== */

    /* Search suggestions dropdown */
    .cdx-menu,
    .cdx-typeahead-search__menu {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .cdx-menu,
      .cdx-typeahead-search__menu {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* ==========================================================================
       TABS - Content Transitions
       ========================================================================== */

    /* Tab panel content */
    .mw-ui-tab-panel {
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    @starting-style {
      .mw-ui-tab-panel {
        opacity: 0;
      }
    }

    /* OOUI tab panels */
    .oo-ui-tabPanelLayout {
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    @starting-style {
      .oo-ui-tabPanelLayout {
        opacity: 0;
      }
    }

    /* ==========================================================================
       ACCORDIONS - Section Animations
       ========================================================================== */

    /* Accordion content */
    .mw-accordion-content {
      opacity: 1;
      transition: opacity 0.25s ease;
    }

    @starting-style {
      .mw-accordion-content {
        opacity: 0;
      }
    }

    /* ==========================================================================
       FORM VALIDATION - Feedback Animations
       ========================================================================== */

    /* Form error messages */
    .mw-htmlform-error,
    .oo-ui-fieldLayout-messages-error {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .mw-htmlform-error,
      .oo-ui-fieldLayout-messages-error {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* Form success messages */
    .mw-htmlform-success,
    .oo-ui-fieldLayout-messages-success {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .mw-htmlform-success,
      .oo-ui-fieldLayout-messages-success {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* ==========================================================================
       IMAGE GALLERIES - Load Animations
       ========================================================================== */

    /* Gallery items */
    .mw-gallery-item,
    .gallerybox {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      .mw-gallery-item,
      .gallerybox {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    /* ==========================================================================
       CATEGORY TAGS - Tag Animations
       ========================================================================== */

    /* Category links */
    .mw-normal-catlinks li {
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    @starting-style {
      .mw-normal-catlinks li {
        opacity: 0;
      }
    }

    /* ==========================================================================
       USER INTERFACE - Button Effects
       ========================================================================== */

    /* Button press effect */
    .mw-ui-button,
    .cdx-button {
      transition: transform 0.1s ease, box-shadow 0.2s ease;
    }

    /* Button hover state entry */
    .mw-ui-button:hover,
    .cdx-button:hover {
      transform: translateY(-1px);
      box-shadow: 0 2px 4px rgba(15, 15, 15, 0.28);
    }

    @starting-style {
      .mw-ui-button:hover,
      .cdx-button:hover {
        transform: translateY(0);
        box-shadow: none;
      }
    }
  }
}

// =============================================================================
// KEYFRAME ANIMATIONS
// =============================================================================

// Fade in animation
@keyframes fade-in
  from
    opacity 0
  to
    opacity 1

// Fade in from bottom
@keyframes fade-in-up
  from
    opacity 0
    transform translateY(20px)
  to
    opacity 1
    transform translateY(0)

// Fade in from top
@keyframes fade-in-down
  from
    opacity 0
    transform translateY(-20px)
  to
    opacity 1
    transform translateY(0)

// Fade in from left
@keyframes fade-in-left
  from
    opacity 0
    transform translateX(-20px)
  to
    opacity 1
    transform translateX(0)

// Fade in from right
@keyframes fade-in-right
  from
    opacity 0
    transform translateX(20px)
  to
    opacity 1
    transform translateX(0)

// Scale in
@keyframes scale-in
  from
    opacity 0
    transform scale(0.9)
  to
    opacity 1
    transform scale(1)

// Slide down
@keyframes slide-down
  from
    max-height 0
    opacity 0
  to
    max-height 500px
    opacity 1

// Slide up
@keyframes slide-up
  from
    max-height 500px
    opacity 1
  to
    max-height 0
    opacity 0

// Spin (for loading indicators)
@keyframes spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

// Pulse (for attention)
@keyframes pulse
  0%
  100%
    opacity 1
  50%
    opacity 0.5

// Shake (for errors)
@keyframes shake
  0%
  100%
    transform translateX(0)
  25%
    transform translateX(-5px)
  75%
    transform translateX(5px)

// Bounce (for notifications)
@keyframes bounce
  0%
  100%
    transform translateY(0)
  50%
    transform translateY(-10px)

// =============================================================================
// ANIMATION UTILITY CLASSES
// =============================================================================

// Fade animations
.animate-fade-in
  animation fade-in 0.3s ease

.animate-fade-in-up
  animation fade-in-up 0.3s ease

.animate-fade-in-down
  animation fade-in-down 0.3s ease

.animate-fade-in-left
  animation fade-in-left 0.3s ease

.animate-fade-in-right
  animation fade-in-right 0.3s ease

// Scale animations
.animate-scale-in
  animation scale-in 0.3s ease

// Slide animations
.animate-slide-down
  animation slide-down 0.3s ease

.animate-slide-up
  animation slide-up 0.3s ease

// Loading animations
.animate-spin
  animation spin 1s linear infinite

.animate-pulse
  animation pulse 2s ease-in-out infinite

// Attention animations
.animate-shake
  animation shake 0.3s ease

.animate-bounce
  animation bounce 0.5s ease

// =============================================================================
// ANIMATION TIMING UTILITIES
// =============================================================================

// Easing functions
.ease-linear
  animation-timing-function linear

.ease-in
  animation-timing-function ease-in

.ease-out
  animation-timing-function ease-out

.ease-in-out
  animation-timing-function ease-in-out

// Duration utilities
.duration-fast
  animation-duration 0.15s

.duration-normal
  animation-duration 0.3s

.duration-slow
  animation-duration 0.5s

// Delay utilities
.delay-100
  animation-delay 0.1s

.delay-200
  animation-delay 0.2s

.delay-300
  animation-delay 0.3s

.delay-500
  animation-delay 0.5s

// =============================================================================
// TRANSITION UTILITIES
// =============================================================================

// Transition property utilities
.transition-none
  transition none

.transition-all
  transition all $transition-medium

.transition-colors
  transition color $transition-medium, background-color $transition-medium, border-color $transition-medium

.transition-opacity
  transition opacity $transition-medium

.transition-transform
  transition transform $transition-medium

.transition-shadow
  transition box-shadow $transition-medium


// =============================================================================
// LINEAR() TIMING FUNCTION - Custom Easing with Control Points
// =============================================================================
// Browser support: 92%+ (Chrome 111+, Firefox 108+, Safari 16+)
// The linear() function allows custom linear timing with intermediate control points
// Syntax: linear(start, [point1,] end) or linear(point1, point2, ...)
// Each point can have an optional easing: value [easing]
// Using @css{} wrapper since Stylus doesn't support linear() directly

@css {
  /* ==========================================================================
     LINEAR() TIMING FUNCTION CLASSES
     These provide smoother alternatives to cubic-bezier without the bounce
     ========================================================================== */

  /* Linear ease-in equivalent: starts slow, speeds up */
  .ease-linear-in {
    animation-timing-function: linear(0, 1);
  }

  /* Linear ease-out equivalent: starts fast, slows down */
  .ease-linear-out {
    animation-timing-function: linear(0, 1);
  }

  /* Linear ease-in-out equivalent: slow start, fast middle, slow end */
  .ease-linear-in-out {
    animation-timing-function: linear(0, 0.25 25%, 0.5 50%, 0.75 75%, 1);
  }

  /* Smooth linear with gradual acceleration */
  .ease-smooth-accel {
    animation-timing-function: linear(0, 0.35 40%, 0.55 60%, 0.7 80%, 1);
  }

  /* Smooth linear with gradual deceleration */
  .ease-smooth-decel {
    animation-timing-function: linear(0, 0.3 20%, 0.5 50%, 0.8 80%, 1);
  }

  /* Step-like linear progression (5 steps) */
  .ease-steps-5 {
    animation-timing-function: linear(0, 0.25, 0.5, 0.75, 1);
  }

  /* Quick step (2 steps) */
  .ease-steps-2 {
    animation-timing-function: linear(0, 0.5, 1);
  }

  /* Gentle wave - subtle back and forth */
  .ease-gentle-wave {
    animation-timing-function: linear(0, 0.3 30%, 0.5, 0.7 70%, 1);
  }

  /* ==========================================================================
     LINEAR() FOR SPECIFIC ANIMATIONS
     ========================================================================== */

  /* Reading progress bar - smooth continuous */
  .mw-reading-progress {
    animation-timing-function: linear(0, 1);
  }

  /* Scroll-to-top button - gentle ease-out */
  .scroll-to-top {
    animation-timing-function: linear(0, 0.4 30%, 0.7 60%, 1);
  }

  /* Loading spinners - continuous */
  .mw-spinner,
  .oo-ui-pending {
    animation-timing-function: linear(0, 1);
  }

  /* Notification slide-in - smooth entrance */
  .mw-notification {
    animation-timing-function: linear(0, 0.2 25%, 0.5 50%, 0.8 75%, 1);
  }

  /* Dropdown menu - smooth expand */
  .vector-dropdown-content,
  .dropdown-content {
    animation-timing-function: linear(0, 0.3 40%, 0.6 70%, 1);
  }

  /* Tab switch - quick but not instant */
  .mw-ui-tab-panel {
    animation-timing-function: linear(0, 0.5, 1);
  }

  /* Toast notifications - quick pop */
  .toast-notification {
    animation-timing-function: linear(0, 0.6 40%, 1);
  }

  /* Card hover effects - smooth scale */
  .mw-card,
  .infobox,
  .navbox {
    animation-timing-function: linear(0, 0.25 30%, 0.5 50%, 0.75 70%, 1);
  }

  /* Modal/dialog transitions */
  dialog,
  .oo-ui-window {
    animation-timing-function: linear(0, 0.3 35%, 0.6 70%, 1);
  }

  /* ==========================================================================
     STEPS() WITH JUMP KEYWORDS - Discrete Animations
     ========================================================================== */
  /* Browser support: 97%+ */

  /* Jump at start - no hold at beginning */
  .steps-jump-start {
    animation-timing-function: steps(5, jump-start);
  }

  /* Jump at end - no hold at end */
  .steps-jump-end {
    animation-timing-function: steps(5, jump-end);
  }

  /* Jump both - hold at neither end */
  .steps-jump-both {
    animation-timing-function: steps(5, jump-both);
  }

  /* Jump none - hold at both ends */
  .steps-jump-none {
    animation-timing-function: steps(5, jump-none);
  }

  /* ==========================================================================
     DISCRETE TRANSITIONS - transition-behavior: allow-discrete
     ========================================================================== */
  /* Enable transitions on discrete properties like display, visibility, overlay */

  @supports (transition-behavior: allow-discrete) {
    /* Fade in/out with display */
    .fade-discrete {
      transition: opacity 0.3s, display 0.3s;
      transition-behavior: allow-discrete;
    }

    .fade-discrete.hidden {
      opacity: 0;
      display: none;
    }

    /* Slide with display */
    .slide-discrete {
      transition: transform 0.3s, opacity 0.3s, display 0.3s;
      transition-behavior: allow-discrete;
    }

    .slide-discrete.hidden {
      transform: translateX(-100%);
      opacity: 0;
      display: none;
    }

    /* Overlay transitions */
    .overlay-discrete {
      transition: opacity 0.25s, visibility 0.25s, overlay 0.25s;
      transition-behavior: allow-discrete;
    }

    .overlay-discrete.hidden {
      opacity: 0;
      visibility: hidden;
      overlay: none;
    }
  }
}

// =============================================================================
// INTERPOLATE-SIZE - Smooth Height/Width to Auto Transitions
// =============================================================================

// Browser support: 85%+ (Chrome 129+, Firefox ~pending, Safari ~pending)
// Enables smooth transitions to/from intrinsic sizing keywords (auto, min-content, max-content, etc.)
// Previously required JavaScript or complex max-height hacks
// Using @css wrapper since this is newer CSS syntax

@css {
  @supports (interpolate-size: allow-keywords) {
    /* ==========================================================================
       AUTO HEIGHT TRANSITIONS - The Holy Grail of CSS Animations
       ========================================================================== */
    /* Now you can animate height: 0 to height: auto smoothly! */

    /* Base class for auto-height transitions */
    .height-auto {
      transition: height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    .height-auto.collapsed {
      height: 0;
      overflow: hidden;
    }

    .height-auto.expanded {
      height: auto;
    }

    /* Accordion-style sections */
    .accordion-content {
      transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      interpolate-size: allow-keywords;
    }

    .accordion-content[aria-hidden="true"] {
      height: 0;
      overflow: hidden;
    }

    /* Dropdown menus */
    .dropdown-menu {
      transition: height 0.2s ease-out, opacity 0.2s ease-out;
      interpolate-size: allow-keywords;
    }

    .dropdown-menu.closed {
      height: 0;
      opacity: 0;
      overflow: hidden;
    }

    /* Collapsible details/summary */
    details > .collapsible-content {
      transition: height 0.25s ease;
      interpolate-size: allow-keywords;
    }

    details:not([open]) > .collapsible-content {
      height: 0;
      overflow: hidden;
    }

    /* Smooth expand/collapse for any element */
    .expandable {
      transition: height 0.3s ease, max-height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    .expandable.collapsed {
      height: 0;
    }

    /* Auto-width transitions */
    .width-auto {
      transition: width 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* Inline-size (logical property) */
    .inline-size-auto {
      transition: inline-size 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* Block-size (logical property) */
    .block-size-auto {
      transition: block-size 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* Min/max content transitions */
    .height-min-content {
      transition: height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    .height-max-content {
      transition: height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* Grid track transitions */
    .grid-rows-auto {
      transition: grid-template-rows 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* Flex basis transitions */
    .flex-basis-auto {
      transition: flex-basis 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* ==========================================================================
       UTILITY CLASSES - Quick Apply
       ========================================================================== */

    /* Collapse/expand animations */
    .animate-collapse {
      height: 0;
      overflow: hidden;
      transition: height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    .animate-expand {
      height: auto;
      transition: height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    /* Slide toggle */
    .slide-toggle {
      transition: height 0.25s ease-in-out, opacity 0.25s ease-in-out;
      interpolate-size: allow-keywords;
    }

    /* Smooth dropdown */
    .smooth-dropdown {
      transition: height 0.2s ease-out, opacity 0.2s ease-out, visibility 0.2s;
      interpolate-size: allow-keywords;
    }

    /* Card expand on hover (for expandable cards) */
    .card-expandable {
      transition: height 0.3s ease;
      interpolate-size: allow-keywords;
    }

    .card-expandable:hover {
      height: auto;
    }

    /* ==========================================================================
       MEDIAWIKI SPECIFIC - Common Wiki Patterns
       ========================================================================== */

    /* Collapsible nav elements */
    .mw-collapsible-content {
      transition: height 0.25s ease;
      interpolate-size: allow-keywords;
    }

    /* Vector skin collapsible menus */
    .vector-sticky-pinned-container-collapsible-content {
      transition: height 0.2s ease;
      interpolate-size: allow-keywords;
    }

    /* TOC collapse */
    #toc ul {
      transition: height 0.2s ease;
      interpolate-size: allow-keywords;
    }

    /* Sidebar collapse */
    .mw-sidebar {
      transition: width 0.25s ease;
      interpolate-size: allow-keywords;
    }

    /* Personal toolbar collapse */
    #pt-userpage,
    #pt-preferences,
    #pt-logout {
      transition: inline-size 0.2s ease;
      interpolate-size: allow-keywords;
    }

    /* ==========================================================================
       ACCESSIBILITY - Reduced Motion Support
       ========================================================================== */

    @media (prefers-reduced-motion: reduce) {
      .height-auto,
      .accordion-content,
      .dropdown-menu,
      details > .collapsible-content,
      .expandable,
      .width-auto,
      .inline-size-auto,
      .block-size-auto,
      .height-min-content,
      .height-max-content,
      .grid-rows-auto,
      .flex-basis-auto,
      .animate-collapse,
      .animate-expand,
      .slide-toggle,
      .smooth-dropdown,
      .card-expandable,
      .mw-collapsible-content,
      .vector-sticky-pinned-container-collapsible-content,
      #toc ul,
      .mw-sidebar {
        transition: none;
      }
    }
  }

  /* ==========================================================================
     CALC-SIZE() - Alternative to Interpolate-Size
     ========================================================================== */
  /* calc-size() provides another way to animate to intrinsic sizes */
  /* Note: calc-size has less browser support than interpolate-size */

  @supports (height: calc-size(auto)) {
    .calc-size-height {
      transition: height 0.3s ease;
    }

    .calc-size-height.collapsed {
      height: calc-size(0);
    }

    .calc-size-height.expanded {
      height: calc-size(auto);
    }

    .calc-size-height.min {
      height: calc-size(min-content);
    }

    .calc-size-height.max {
      height: calc-size(max-content);
    }
  }
}



// =============================================================================
// ACCESSIBILITY
// =============================================================================

// Reduced motion - disable animations for users who prefer reduced motion
@media (prefers-reduced-motion reduce)
  *
  *::before
  *::after
    animation-duration 0.01ms !important
    animation-iteration-count 1 !important
    transition-duration 0.01ms !important
    scroll-behavior auto !important

  // Keep essential state changes but remove motion
  .animate-fade-in
  .animate-fade-in-up
  .animate-fade-in-down
  .animate-fade-in-left
  .animate-fade-in-right
  .animate-scale-in
  .animate-slide-down
  .animate-slide-up
    animation none

  .animate-spin
    animation none

  .animate-pulse
    animation none
    opacity 0.7

  .animate-shake
  .animate-bounce
    animation none

// =============================================================================
// PRINT STYLES
// =============================================================================

@media print
  // Disable all animations for print
  *
  *::before
  *::after
    animation none !important
    transition none !important

// =============================================================================
// ANIMATION PLAY STATE - Pause/Resume Animations
// =============================================================================
// Browser support: 97%+
// Control animation state with animation-play-state property

// Pause all animations on element
.animation-paused
  animation-play-state paused

// Resume animations (default state)
.animation-running
  animation-play-state running

// Pause on hover - great for reducing distraction
.pause-on-hover:hover
.pause-on-hover:focus-within
  animation-play-state paused

// Pause on focus - accessibility friendly
.pause-on-focus:focus
  animation-play-state paused

// Running state indicator (when paused)
.is-paused::after
  content " ⏸"
  font-size 0.75em
  opacity 0.7

// Running indicator
.is-running::after
  content " ▶"
  font-size 0.75em
  opacity 0.7

// Interactive elements - pause on hover for readability
#content .mw-editsection a:hover
#content .mw-file-description:hover
#content .vector-sticky-pinned-container::after
  animation-play-state paused

// Loading spinners - pause when hidden
.loading-spinner:not([hidden])
  animation-play-state running

.loading-spinner[hidden]
  animation-play-state paused

// Progress animations - useful for indication
@keyframes progress-pulse
  0%
  100%
    opacity 1
  50%
    opacity 0.5

.progress-indicator
  animation progress-pulse 2s ease-in-out infinite
  animation-play-state running

// Pause progress when page is not visible
@media (visibility hidden)
  .progress-indicator
    animation-play-state paused

@media (visibility visible)
  .progress-indicator
    animation-play-state running

// Tab animations - pause when tab is hidden
@media (update slow)
  .animate-once
    animation-iteration-count 1

  .animate-infinite
    animation-play-state paused

@media (update fast)
  .animate-once
    animation-iteration-count 1

  .animate-infinite
    animation-play-state running

// Reduced motion - ensure animations are properly stopped
@media (prefers-reduced-motion reduce)
  .animation-paused
  .pause-on-hover:hover
  .pause-on-focus:focus
  .progress-indicator
    animation-play-state paused !important
