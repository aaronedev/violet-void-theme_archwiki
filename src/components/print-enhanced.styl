// Enhanced Print Styles
// Optimized printing for all Arch Linux sites

@media print
  // =============================================================================
  // RESET FOR PRINT
  // =============================================================================

  // White background
  *
    background white !important
    color black !important
    box-shadow none !important
    text-shadow none !important

  // Hide unnecessary elements
  #archnavbar
  .mw-sidebar
  #vector-main-menu
  .vector-sticky-header
  .mw-editsection
  .toctoggle
  .catlinks
  #footer
  .navbox
  .navigation-box
  #mw-page-info
  .mw-indicators
  .vector-user-links
  .vector-search-box
  .oo-ui-toolbar
  .mw-notification
  .aur-enhanced
  .pkgactions
  .vote-btn
  .unvote-btn
  .flag-btn
    display none !important

  // Show links
  a
    color black !important
    text-decoration underline

    // Show URLs for external links
    &[href^="http"]:not([href*="archlinux.org"])::after
      content " (" attr(href) ")"
      font-size 0.85em
      color $print-text !important

  // =============================================================================
  // TYPOGRAPHY FOR PRINT
  // =============================================================================

  body
    font-family "Georgia", "Times New Roman", serif
    font-size 12pt
    line-height 1.6
    max-width 100%

  h1
    font-size 24pt
    page-break-after avoid
    margin-top 0.5in

  h2
    font-size 18pt
    page-break-after avoid
    margin-top 0.4in

  h3
    font-size 14pt
    page-break-after avoid

  h4
  h5
  h6
    font-size 12pt
    page-break-after avoid

  // =============================================================================
  // WIDOWS & ORPHANS CONTROL
  // =============================================================================

  // Widow: single line at top of page (from previous paragraph)
  // Orphan: single line at bottom of page (from next paragraph)
  // Browser support: 97%+
  // Values: minimum number of lines that must stay together

  p
  li
  dd
  dt
  blockquote
    orphans 3    // Minimum 3 lines at bottom of page
    widows 3     // Minimum 3 lines at top of page

  // Definition lists - keep terms with definitions
  dl
    break-inside avoid

  // Keep list items together
  li
    break-inside avoid

  // =============================================================================
  // CODE BLOCKS FOR PRINT
  // =============================================================================

  pre
  code
    font-family "Courier New", Courier, monospace
    font-size 10pt
    background $print-bg !important
    border 1px solid $print-border-light !important
    page-break-inside avoid
    overflow-wrap break-word
    white-space pre-wrap

  // =============================================================================
  // TABLES FOR PRINT
  // =============================================================================

  table
    border-collapse collapse
    page-break-inside avoid

  th
    background $print-bg !important
    font-weight bold
    border 1px solid $print-border !important

  td
    border 1px solid $print-border !important

  // Complex table headers
  th[colspan]
  th[rowspan]
    background darken($print-bg, 5%) !important
    text-align center

  // =============================================================================
  // IMAGES FOR PRINT
  // =============================================================================

  img
    max-width 100%
    page-break-inside avoid

  figure
    page-break-inside avoid

  // =============================================================================
  // LINKS FOR PRINT
  // =============================================================================

  // Show link destinations
  a[href]::after
    content " (" attr(href) ")"
    font-size 0.8em
    color $print-text !important

  // Don't show for anchor links
  a[href^="#"]::after
    content none

  // Don't show for repeated links
  a[href][title]::after
    content none

  // =============================================================================
  // TABLE OF CONTENTS FOR PRINT
  // =============================================================================

  #toc
  .toc
    display block !important
    background $print-white !important
    border 1px solid $print-border !important
    padding 0.5em
    margin 0.5em 0

    .toctitle
      font-weight bold
      font-size 14pt

    ul
      list-style none
      padding-left 1em

    li
      margin 0.25em 0

  // =============================================================================
  // SPECIFIC ARCH WIKI IMPROVEMENTS
  // =============================================================================

  // Warning/Note/Tip boxes
  .mw-warning
  .mw-notice
  .warningbox
  .notebox
    border 1px solid $print-border !important
    border-left 4px solid $print-text !important
    padding 0.5em
    margin 0.5em 0
    page-break-inside avoid

  // Infoboxes
  .infobox
    border 1px solid $print-border !important
    float right
    width 250px
    margin 0 0 0.5em 0.5em
    page-break-inside avoid

  // Message boxes
  .ambox
    border 1px solid $print-border !important
    margin 0.5em 0

  // =============================================================================
  // FORUM PRINT OPTIMIZATIONS
  // =============================================================================

  .blockpost
    border 1px solid $print-border !important
    margin 1em 0
    page-break-inside avoid

    .box-head
      border-bottom 1px solid $print-border !important
      font-weight bold

  // =============================================================================
  // AUR PRINT OPTIMIZATIONS
  // =============================================================================

  #pkgdetails
    border 1px solid $print-border !important
    page-break-inside avoid

  .pkgsearch-results
  table.results
    border 1px solid $print-border !important

  // =============================================================================
  // PAGE BREAKS
  // =============================================================================

  // Avoid page breaks inside these elements
  h1
  h2
  h3
  h4
  h5
  h6
  img
  figure
  table
  pre
    page-break-inside avoid

  // Page break before new sections
  h2
    page-break-before auto

  // =============================================================================
  // MARGINS FOR PRINT
  // =============================================================================

  @page
    margin 1in
    size letter

  // First page
  @page :first
    margin-top 1.5in

  // =============================================================================
  // ACCESSIBILITY FOR PRINT
  // =============================================================================

  // Increase contrast
  *
    -webkit-print-color-adjust exact
    print-color-adjust exact

  // Ensure text is readable
  body
    font-size 12pt

  // Ensure links are distinguishable
  a
    text-decoration underline

  // =============================================================================
  // MINIMAL STYLING FOR PRINT
  // =============================================================================

  // Remove shadows
  *
    box-shadow none !important

  // Remove gradients
  *
    background-image none !important

  // Remove animations
  *
    animation none !important
    transition none !important

  // Remove borders except for tables and boxes
  *
    border none !important

  table
  .infobox
  .mw-warning
  .mw-notice
  .warningbox
  .notebox
  .ambox
  pre
  code
    border 1px solid $print-border !important

  // =============================================================================
  // SPECIAL PAGES PRINT OPTIMIZATION
  // =============================================================================

  // History pages
  #pagehistory
    list-style none
    padding 0

    li
      border-bottom 1px solid $print-border !important
      padding 0.5em

  // Diff view
  table.diff
    border 1px solid $print-border !important

    td
      border 1px solid $print-border !important
      padding 0.5em

    td.diff-deletedline
      background lighten(red, 45%) !important

    td.diff-addedline
      background lighten(green, 45%) !important

  // =============================================================================
  // CATEGORIES PRINT
  // =============================================================================

  .catlinks
    display block !important
    border-top 1px solid $print-border !important
    padding-top 0.5em
    margin-top 1em

    a
      display inline-block
      margin-right 0.5em

// =============================================================================
// PRINT-ONLY LINK URLs
// =============================================================================

// Show link destinations in print
// Browser support: 100%

@media print
  a[href]::after
    content " (" attr(href) ")"
    font-size 0.8em
    color $muted

  // Don't show for internal anchors
  a[href^="#"]::after
  a[href^="javascript"]::after
    content none

  // Truncate long URLs
  a[href^="http"]::after
    max-width 30em
    overflow hidden
    text-overflow ellipsis
    display inline-block

// =============================================================================
// PAGE BREAK CONTROL
// =============================================================================

// Prevent orphaned headings and break issues
// Browser support: 97%+

@media print
  // Avoid breaking inside these elements
  .infobox
  .wikitable
  pre
  code
  blockquote
  figure
  .mw-highlight
    break-inside avoid

  // Major sections start on new page
  h1
    break-before page

  h2
    break-before auto
    break-after avoid

  // Prevent orphaned headings
  h1
  h2
  h3
  h4
  h5
  h6
    break-after avoid

  // Prevent breaking right after heading
  h1 + p
  h2 + p
  h3 + p
    break-before avoid

// =============================================================================
// =============================================================================
// PRINT HEADER/FOOTER
// =============================================================================

// Enhanced @page rules for page margins and page numbers
// Browser support: 97%+ for basic @page, 85%+ for named pages
// Note: Margin boxes require @css{} wrapper for Stylus

@media print
  // Article title in header
  @page
    margin 2cm
    size A4

// Named page styles for different content types
// Note: Wrap in @css{} for Stylus compatibility with margin boxes
@css {
  @page {
    /* Page margins */
    margin: 2cm;

    /* Page numbers in bottom-right corner */
    @bottom-right {
      content: "Page " counter(page) " of " counter(pages);
      font-size: 9pt;
      color: #666;
    }

    /* Article title in top-center */
    @top-center {
      content: element(page-header);
      font-size: 9pt;
      color: #666;
    }
  }

  /* First page styling */
  @page :first {
    margin-top: 3cm;

    @top-center {
      content: none;
    }
  }

  /* Landscape pages for wide tables */
  @page landscape {
    size: A4 landscape;
    margin: 1.5cm;
  }

  /* Apply landscape to wide tables */
  table.wikitable-wide {
    page: landscape;
  }
}

@media print
  .page-header
    position running(page-header)
    font-size 0.9em
    color $muted
    border-bottom 1px solid $border-subtle
    padding-bottom 0.5em

  .page-footer
    position running(page-footer)
    font-size 0.8em
    color $muted
