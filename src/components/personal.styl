// =============================================================================
// Personalization - Violet Void ArchWiki Theme
// Reading List, Quick Links, and User Preferences Styling
// Browser support: 97%+
// =============================================================================

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// READING LIST STYLING
// =============================================================================
// Saved article cards, read/unread indicators, category organization

// Reading list container
.reading-list
  margin 1.5em 0
  padding 1em
  background rgba($dark, 0.6)
  border 1px solid $border-subtle
  border-radius $border-radius-lg
  display flex
  flex-direction column
  gap 1em

  // List header
  .reading-list-header
    display flex
    align-items center
    justify-content space-between
    padding-bottom 0.75em
    border-bottom 1px solid rgba($border-subtle, 0.5)

    h3
      margin 0
      font-size 1.1rem
      color $lighter

    .list-actions
      display flex
      gap 0.5rem

      button
        padding 0.4rem 0.75rem
        background rgba($arch-blue, 0.2)
        border 1px solid rgba($arch-blue, 0.3)
        border-radius $border-radius-sm
        color $light
        font-size 0.85rem
        cursor pointer
        transition transition-fast

        &:hover
          background rgba($arch-blue, 0.3)
          border-color $arch-blue

        &:focus-visible
          outline 2px solid $arch-blue
          outline-offset 2px

  // Reading list items
  .reading-list-items
    display flex
    flex-direction column
    gap 0.75rem

  // Individual reading list item card
  .reading-list-item
    display flex
    align-items center
    gap 1rem
    padding 0.75rem 1rem
    background rgba($base, 0.6)
    border 1px solid $border-subtle
    border-radius $border-radius-md
    transition transition-medium
    text-decoration none
    color $light

    &:hover
      border-color rgba($arch-blue, 0.4)
      background rgba($arch-blue, 0.1)

    // Read/unread indicator
    .read-status
      width 8px
      height 8px
      border-radius 50%
      flex-shrink 0

      &.unread
        background $arch-blue
        box-shadow 0 0 6px rgba($arch-blue, 0.5)

      &.read
        background $muted
        opacity 0.5

    // Article thumbnail (if available)
    .item-thumbnail
      width 60px
      height 40px
      border-radius $border-radius-sm
      object-fit cover
      background $dark
      flex-shrink 0

    // Article info
    .item-info
      flex 1
      min-width 0

      .item-title
        font-size 0.95rem
        font-weight 500
        color $lighter
        margin-bottom 0.25rem
        white-space nowrap
        overflow hidden
        text-overflow ellipsis

      .item-meta
        font-size 0.8rem
        color $muted
        display flex
        gap 0.75rem

        .item-date
          tabular-nums()

        .item-category
          color $secondary-blue

    // Item actions
    .item-actions
      display flex
      gap 0.5rem
      opacity 0
      transition opacity-fast

    &:hover .item-actions
      opacity 1

    // Remove from list button
    .remove-item
      width 24px
      height 24px
      border-radius $border-radius-sm
      background transparent
      border none
      color $muted
      cursor pointer
      display flex
      align-items center
      justify-content center
      transition transition-fast

      &:hover
        background rgba($secondary-red, 0.2)
        color $secondary-red

// Reading list categories
.reading-list-category
  margin-bottom 1.5em

  .category-header
    display flex
    align-items center
    gap 0.5rem
    padding 0.5rem 0.75rem
    background rgba($arch-blue, 0.15)
    border-radius $border-radius-sm $border-radius-sm 0 0
    border-bottom 1px solid rgba($arch-blue, 0.2)

    .category-icon
      font-size 1rem

    .category-name
      flex 1
      font-size 0.9rem
      font-weight 500
      color $lighter

    .category-count
      font-size 0.8rem
      color $muted
      tabular-nums()

  .category-items
    border 1px solid rgba($arch-blue, 0.2)
    border-top none
    border-radius 0 0 $border-radius-sm $border-radius-sm

// Reading list empty state
.reading-list-empty
  text-align center
  padding 2rem
  color $muted

  .empty-icon
    font-size 3rem
    margin-bottom 1rem
    opacity 0.5

  h4
    margin 0 0 0.5rem
    color $light

  p
    margin 0
    font-size 0.9rem

// =============================================================================
// CUSTOM QUICK LINKS
// =============================================================================
// Quick link cards, reorder handles, edit/delete actions

// Quick links panel
.quick-links-panel
  margin 1.5em 0
  padding 1em
  background rgba($dark, 0.6)
  border 1px solid $border-subtle
  border-radius $border-radius-lg

  // Panel header
  .quick-links-header
    display flex
    align-items center
    justify-content space-between
    margin-bottom 1rem

    h3
      margin 0
      font-size 1.1rem
      color $lighter

    .add-link-btn
      padding 0.4rem 0.75rem
      background $arch-blue
      border none
      border-radius $border-radius-sm
      color $white
      font-size 0.85rem
      font-weight 500
      cursor pointer
      transition transition-fast
      display flex
      align-items center
      gap 0.4rem

      &:hover
        background lighten($arch-blue, 8%)

      &:focus-visible
        outline 2px solid $arch-blue
        outline-offset 2px

  // Quick links grid
  .quick-links-grid
    display grid
    grid-template-columns repeat(auto-fill, minmax(200px, 1fr))
    gap 0.75rem

  // Quick link card
  .quick-link-card
    display flex
    align-items center
    gap 0.75rem
    padding 0.75rem
    background rgba($base, 0.6)
    border 1px solid $border-subtle
    border-radius $border-radius-md
    text-decoration none
    color $light
    transition transition-medium
    position relative

    &:hover
      border-color rgba($arch-blue, 0.4)
      background rgba($arch-blue, 0.1)

    // Drag handle for reordering
    .drag-handle
      width 20px
      height 20px
      display flex
      align-items center
      justify-content center
      color $muted
      cursor grab
      opacity 0
      transition opacity-fast

      &:active
        cursor grabbing

    &:hover .drag-handle
      opacity 1

    // Link icon
    .link-icon
      width 32px
      height 32px
      border-radius $border-radius-sm
      background rgba($arch-blue, 0.15)
      display flex
      align-items center
      justify-content center
      color $arch-blue
      font-size 1rem
      flex-shrink 0

    // Link info
    .link-info
      flex 1
      min-width 0

      .link-title
        font-size 0.9rem
        font-weight 500
        color $lighter
        white-space nowrap
        overflow hidden
        text-overflow ellipsis

      .link-url
        font-size 0.75rem
        color $muted
        white-space nowrap
        overflow hidden
        text-overflow ellipsis

    // Link actions (visible on hover)
    .link-actions
      display flex
      gap 0.25rem
      opacity 0
      transition opacity-fast

    &:hover .link-actions
      opacity 1

    // Edit/delete buttons
    .link-action-btn
      width 24px
      height 24px
      border-radius $border-radius-sm
      background transparent
      border none
      color $muted
      cursor pointer
      display flex
      align-items center
      justify-content center
      transition transition-fast

      &:hover
        background rgba($arch-blue, 0.2)
        color $arch-blue

      &.delete:hover
        background rgba($secondary-red, 0.2)
        color $secondary-red

// Quick link add/edit form
.quick-link-form
  padding 1rem
  background rgba($base, 0.8)
  border 1px solid $border-subtle
  border-radius $border-radius-md
  margin-bottom 1rem

  .form-group
    margin-bottom 0.75rem

    label
      display block
      font-size 0.85rem
      color $light
      margin-bottom 0.25rem

    input
      width 100%
      padding 0.5rem 0.75rem
      background $dark
      border 1px solid $border-subtle
      border-radius $border-radius-sm
      color $lighter
      font-size 0.9rem

      &:focus
        outline none
        border-color $arch-blue

  .form-actions
    display flex
    gap 0.5rem
    justify-content flex-end

    button
      padding 0.4rem 1rem
      border-radius $border-radius-sm
      font-size 0.85rem
      cursor pointer
      transition transition-fast

      &.save
        background $arch-blue
        border none
        color $white

        &:hover
          background lighten($arch-blue, 8%)

      &.cancel
        background transparent
        border 1px solid $border-subtle
        color $light

        &:hover
          border-color $arch-blue

// Quick links empty state
.quick-links-empty
  text-align center
  padding 2rem
  color $muted

  .empty-icon
    font-size 2.5rem
    margin-bottom 0.75rem
    opacity 0.5

  p
    margin 0
    font-size 0.9rem

// =============================================================================
// WATCHLIST ENHANCEMENTS (additional styling beyond existing)
// =============================================================================
// Enhanced watchlist styling with change summary and diff preview

// Watchlist item enhancements
.mw-watchlist
  // Change summary styling
  .change-summary
    font-size 0.85rem
    color $muted
    padding 0.25rem 0
    display flex
    align-items center
    gap 0.5rem

    .change-tags
      display flex
      gap 0.25rem

      .change-tag
        padding 0.15rem 0.4rem
        background rgba($arch-blue, 0.15)
        border-radius $border-radius-sm
        font-size 0.75rem
        color $secondary-blue

        &.minor
          background rgba($green, 0.15)
          color $green

        &.bot
          background rgba($orange, 0.15)
          color $orange

        &.new
          background rgba($secondary-red, 0.15)
          color $secondary-red

  // Diff preview cards
  .watchlist-diff-preview
    margin-top 0.5rem
    padding 0.5rem
    background rgba($dark, 0.4)
    border 1px solid rgba($border-subtle, 0.5)
    border-radius $border-radius-sm
    font-size 0.8rem

    .diff-line
      padding 0.1rem 0.25rem
      font-family monospace

      &.added
        background rgba($green, 0.2)
        color $green

      &.removed
        background rgba($secondary-red, 0.2)
        color $secondary-red

// Watchlist timestamps with tabular-nums
.watchlist-timestamp
  font-size 0.85rem
  color $muted
  tabular-nums()

// Watchlist change indicators
.watchlist-change
  display inline-flex
  align-items center
  gap 0.25rem
  font-size 0.8rem

  &.increase
    color $green

  &.decrease
    color $secondary-red

// =============================================================================
// REDUCED MOTION SUPPORT
// =============================================================================

@media (prefers-reduced-motion reduce)
  .reading-list-item
  .quick-link-card
  .change-summary
    transition none

  .reading-list-item .read-status.unread
    animation none
