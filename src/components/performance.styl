// Page Load Indicator Styling
// Progress bars and skeleton screen patterns for loading states
// Browser support: 97%+

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// LOADING PROGRESS BAR
// =============================================================================

// Top progress bar for page load indication
.page-load-progress
  position fixed
  top 0
  left 0
  width 100%
  height 3px
  background rgba($arch-blue, 0.1)
  z-index 10000
  overflow hidden

  // Progress fill
  .progress-fill
    height 100%
    background linear-gradient(90deg, $arch-blue, $secondary-blue, $arch-blue)
    background-size 200% 100%
    animation load-progress 1.5s ease-in-out infinite
    width 0%
    transition width 0.3s ease-out

  // Determinate progress
  &.determinate .progress-fill
    animation none
    background $arch-blue

@keyframes load-progress
  0%
    background-position 200% 0
    width 0%
  50%
    width 70%
    background-position 100% 0
  100%
    background-position 0 0
    width 100%

// =============================================================================
// SKELETON SCREEN PATTERNS
// =============================================================================

// Skeleton loading placeholder
.skeleton
  background linear-gradient(90deg,
  rgba($darker, 0.3) 0%,
  rgba($dark, 0.5) 50%,
  rgba($darker, 0.3) 100%)
  background-size 200% 100%
  animation skeleton-pulse 1.5s ease-in-out infinite
  border-radius $border-radius-sm
  color transparent
  position relative
  overflow hidden

  // Prevent text selection during load
  &
  & *
    user-select none
    pointer-events none

@keyframes skeleton-pulse
  0%
    background-position 200% 0
  100%
    background-position -200% 0

// Skeleton text line
.skeleton-text
  @extend .skeleton
  height 1em
  margin-bottom 0.5em

  &:last-child
    width 70%

// Skeleton heading
.skeleton-heading
  @extend .skeleton
  height 1.5em
  width 60%
  margin-bottom 0.75em

// Skeleton paragraph
.skeleton-paragraph
  @extend .skeleton
  height 1em
  width 100%
  margin-bottom 0.25em

// Skeleton image/thumbnail
.skeleton-image
  @extend .skeleton
  aspect-ratio 16 / 9
  width 100%
  border-radius $border-radius-md

// Skeleton avatar
.skeleton-avatar
  @extend .skeleton
  width 48px
  height 48px
  border-radius 50%

// Skeleton button
.skeleton-button
  @extend .skeleton
  width 120px
  height 40px
  border-radius $border-radius-md

// Skeleton card
.skeleton-card
  @extend .skeleton
  padding 1em
  border-radius $border-radius-lg
  border 1px solid rgba($arch-blue, 0.15)

  .skeleton-image
    margin-bottom 0.75em

  .skkeleton-heading
    margin-bottom 0.5em

  .skeleton-text
    margin-bottom 0.25em

// =============================================================================
// CONTENT LOADING STATES
// =============================================================================

// Loading wrapper for dynamic content
.content-loading
  position relative
  min-height 200px

  // Overlay with spinner
  &::after
    content ''
    position absolute
    top 0
    left 0
    right 0
    bottom 0
    background rgba($darker, 0.7)
    display flex
    align-items center
    justify-content center
    z-index 10

// Spinner for loading state
.loading-spinner
  width 40px
  height 40px
  border 3px solid rgba($arch-blue, 0.2)
  border-top-color $arch-blue
  border-radius 50%
  animation spin 0.8s linear infinite

@keyframes spin
  to
    transform rotate(360deg)

// =============================================================================
// BLUR-UP IMAGE LOADING
// =============================================================================

// Blur-up effect for lazy loaded images
.img-loading
  filter blur(10px)
  transform scale(1.05)
  transition filter 0.3s ease, transform 0.3s ease

  &.loaded
    filter blur(0)
    transform scale(1)

// Placeholder for images
.img-placeholder
  background-color rgba($dark, 0.3)
  // Note: Use actual aspect-ratio values or aspect-ratio: attr(width) / attr(height) with proper fallback
  aspect-ratio 16 / 9
  min-height 100px

// =============================================================================
// LAZY LOAD FADE-IN
// =============================================================================

// Fade-in for lazy loaded content
.lazy-load-fade
  opacity 0
  transform translateY(10px)
  transition opacity 0.4s ease, transform 0.4s ease

  &.loaded
    opacity 1
    transform translateY(0)

// Intersection observer loading trigger
.lazy-load-trigger
  min-height 1px

// =============================================================================
// ERROR STATE STYLING
// =============================================================================

// Loading error state
.loading-error
  padding 1.5em
  text-align center
  background rgba($secondary-red, 0.1)
  border 1px solid rgba($secondary-red, 0.3)
  border-radius $border-radius-md
  color $light

  .error-icon
    font-size 2em
    margin-bottom 0.5em
    color $secondary-red

  .error-message
    margin-bottom 0.75em

  .retry-button
    display inline-block
    padding 0.5em 1.5em
    background $arch-blue
    color $lighter
    border-radius $border-radius-md
    cursor pointer
    transition background 0.2s

    &:hover
      background $secondary-blue

    &:focus-visible
      outline 2px solid $arch-blue
      outline-offset 2px

// =============================================================================
// REDUCED MOTION - SIMPLE TRANSITIONS
// =============================================================================

@media (prefers-reduced-motion reduce)
  .skeleton
    animation none
    background rgba($dark, 0.3)

  .loading-spinner
    animation none
    border-top-color $arch-blue

  .img-loading
    transition none
    filter none
    transform none

    &.loaded
      filter none
      transform none

  .lazy-load-fade
    transition none
    opacity 1
    transform none

// =============================================================================
// PREFER REDUCED DATA - Data Saver Mode
// =============================================================================

// Detect data saver mode and reduce resource usage
// Browser support: 87%+ (Chrome 113+, Firefox 121+, Safari 17.4+)
// Reduces image quality, animations, and optional content for data-conscious users

@media (prefers-reduced-data reduce)
  // Disable skeleton loading animations
  .skeleton
    animation none
    background rgba($dark, 0.2)

  // Simplify blur-up loading - no blur transition needed
  .img-loading
    filter none
    transform none
    transition none

    &.loaded
      filter none
      transform none

  // Reduce lazy load fade animations
  .lazy-load-fade
    opacity 1
    transform none
    transition none

  // Disable or simplify progress bar animations
  .page-load-progress .progress-fill
    animation none
    background $arch-blue
    width 100%

  // No blur on placeholders
  .img-placeholder
    filter none
    background-color rgba($dark, 0.15)

  // Reduce or disable decorative background images
  body
    background-image none !important

  // Simplify shadows for less rendering
  .skeleton-card
    box-shadow none
    border 1px solid rgba($arch-blue, 0.1)

  // Disable decorative pseudo-elements that add visual flair but not content
  .decorative-gradient::before
  .decorative-gradient::after
  .glow-effect::before
  .pulse-indicator::after
    display none

  // Reduce motion in animations
  *:not(.no-reduce)
    animation-duration 0.01ms !important
    animation-iteration-count 1 !important
    transition-duration 0.01ms !important

  // Simplify loading spinner
  .loading-spinner
    animation none
    border-top-color $arch-blue

  // Show lightweight alternatives to heavy components
  .heavy-graphic
    display none

  // Prefer simpler color schemes
  .complex-gradient
    background simple

// =============================================================================
// HIGH CONTRAST MODE
// =============================================================================

@media (forced-colors active)
  .skeleton
    border 1px solid CanvasText

  .loading-spinner
    border-top-color Highlight

  .loading-error
    border-color HighlightText
