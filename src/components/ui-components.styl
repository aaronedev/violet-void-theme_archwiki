// =============================================================================
// SVG ENHANCEMENTS
// =============================================================================
// Browser support: 97%+
// Improved SVG rendering for icons, diagrams, and embedded graphics

// =============================================================================
// PAINT-ORDER FOR SVG TEXT
// =============================================================================
// Control the paint order of stroke and fill for SVG text
// Useful for outlined text effects - draws stroke before fill for cleaner look

// Paint stroke before fill (outlined text effect)
svg text
  paint-order stroke fill

// Bold text with outline - stroke draws first, then fill
svg .text-bold
  paint-order stroke fill
  font-weight bold

// Themed text with outline
svg .text-outlined
  paint-order stroke fill
  stroke-width 0.5px

// Icon text variants
.svg-icon-text
  paint-order fill stroke

// =============================================================================
// STROKE PROPERTIES FOR SVG
// =============================================================================
// Fine-tune stroke appearance for SVG elements

// SVG icon stroke width
.svg-icon
  stroke-width 2

// SVG icon stroke linecap
.svg-icon-linecap
  stroke-linecap round
  stroke-linejoin round

// SVG icon dash array (dashed lines)
.svg-icon-dashed
  stroke-dasharray 4 2

// SVG diagram stroke styling
svg path
  stroke-linecap round
  stroke-linejoin round

// SVG connectors (flowcharts, diagrams)
.svg-connector
  stroke-width 2
  fill none
  stroke-linecap round

// SVG highlight paths
.svg-highlight
  stroke-width 3
  stroke $arch-blue

// SVG boundary paths
.svg-boundary
  stroke-width 1
  stroke $border-color
  fill none
  stroke-dasharray 3 3

// =============================================================================
// VECTOR-EFFECT: NON-SCALING-STROKE
// =============================================================================
// Keep stroke width constant regardless of SVG transform/scale
// Essential for responsive icons and scalable graphics

// Non-scaling stroke icons
.svg-icon-noscale
  vector-effect non-scaling-stroke

// Diagrams that maintain stroke width
.svg-diagram-noscale
  vector-effect non-scaling-stroke
  stroke-width 2

// Responsive icons
.icon-responsive
  vector-effect non-scaling-stroke

// Pixel-perfect icons at any size
.icon-pixel-perfect
  vector-effect non-scaling-stroke
  image-rendering crisp-edges

// =============================================================================
// SHAPE-RENDERING FOR SVG
// =============================================================================
// Control SVG rendering quality vs speed tradeoff

// Optimize for speed (default)
.svg-render-speed
  shape-rendering optimizeSpeed

// Optimize for crisp edges (pixel art, diagrams)
.svg-render-crisp
  shape-rendering crispEdges

// Geometric precision
.svg-render-geometric
  shape-rendering geometricPrecision

// Auto (browser default)
.svg-render-auto
  shape-rendering auto

// =============================================================================
// SVG ACCESSIBILITY
// =============================================================================

// Ensure SVG icons are accessible
svg[role="img"]
  // aria-hidden is handled via HTML attribute

// Hide decorative SVGs from screen readers
svg[aria-hidden="true"]
  // aria-hidden is handled via HTML attribute

// Focusable SVGs for keyboard navigation
svg.focusable
  // focusable attribute is handled via HTML
  outline none

  &:focus
    outline 2px solid $arch-blue
    outline-offset 2px

// =============================================================================
// SVG CONTAINMENT FOR PERFORMANCE
// =============================================================================
// Isolate SVG rendering for better performance

svg
  contain strict

// Complex SVGs (charts, diagrams)
svg.chart
svg.diagram
  contain layout paint

// =============================================================================
// SVG COLOR INHERITANCE
// =============================================================================
// Allow SVG strokes/fills to inherit from CSS color

// Icon color from current text color
.svg-icon-color
  stroke currentColor
  fill currentColor

// Stroke-only icons
.svg-stroke-only
  fill none
  stroke currentColor

// Fill-only icons
.svg-fill-only
  fill currentColor
  stroke none

// =============================================================================
// SVG ANIMATION OPTIMIZATIONS
// =============================================================================
// Performance hints for animated SVGs

svg.animate-path
  will-change stroke-dashoffset

svg.animate-transform
  will-change transform

// Reduce motion for SVGs
@media (prefers-reduced-motion reduce)
  svg *
    animation none
    transition none
    will-change auto

// =============================================================================
// PAINT-ORDER FOR SVG TEXT (97%+ browser support)
// =============================================================================
// Control paint order for SVG text elements
// Useful for outlined text effects: stroke drawn after fill
// Values: normal | [fill || stroke || markers]

// Stroke drawn after fill (outlined text effect)
.svg-text-outlined
  paint-order stroke fill

// Stroke drawn before fill (reverse outlined)
.svg-text-reversed
  paint-order fill stroke

// Markers drawn first
.svg-text-with-markers
  paint-order markers stroke fill

// Normal paint order
.svg-text-normal
  paint-order normal

// =============================================================================
// STROKE-* PROPERTIES FOR SVG (97%+ browser support)
// =============================================================================
// Control SVG stroke appearance

// Stroke width variants
.svg-stroke-thin
  stroke-width 1px

.svg-stroke-medium
  stroke-width 2px

.svg-stroke-thick
  stroke-width 3px

// Stroke linecap
.svg-linecap-round
  stroke-linecap round

.svg-linecap-square
  stroke-linecap square

.svg-linecap-butt
  stroke-linecap butt

// Stroke linejoin
.svg-linejoin-round
  stroke-linejoin round

.svg-linejoin-bevel
  stroke-linejoin bevel

.svg-linejoin-miter
  stroke-linejoin miter

// Dashed stroke patterns
.svg-dash-small
  stroke-dasharray 4 4

.svg-dash-medium
  stroke-dasharray 8 4

.svg-dash-large
  stroke-dasharray 12 6

// =============================================================================
// VECTOR-EFFECT FOR NON-SCALING STROKE (97%+ browser support)
// =============================================================================
// Prevent stroke scaling when SVG is resized
// Useful for icons and borders that should maintain consistent width

// Non-scaling stroke - maintains constant stroke-width regardless of transform
.vector-effect-none-scaling
  vector-effect non-scaling-stroke

// =============================================================================
// SHAPE-RENDERING FOR SVG (97%+ browser support)
// =============================================================================
// Control SVG rendering quality

// Optimize for speed
.svg-render-speed
  shape-rendering optimizeSpeed

// Optimize for crisp edges (pixel art, diagrams)
.svg-render-crisp
  shape-rendering crispEdges

// Geometric precision
.svg-render-geometric
  shape-rendering geometricPrecision

// Auto (browser default)
.svg-render-auto
  shape-rendering auto
