// =============================================================================
// Template Data Styling - Violet Void ArchWiki Theme
// Styles for MediaWiki TemplateData extension - parameter cards, indicators
// Browser support: 97%+
// =============================================================================

@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/gradients'

// =============================================================================
// TEMPLATE DATA CONTAINER
// =============================================================================
// Container for template parameter documentation
// Generated by TemplateData extension

.mw-template-data
.mw-template-data-container
.template-data-wrapper
  margin 1em 0
  padding 1.5em
  background linear-gradient(135deg, rgba($darker, 0.95), rgba($base, 0.9))
  border 1px solid rgba($arch-blue, 0.2)
  border-radius $border-radius-lg
  box-shadow $shadow-subtle

// Template parameters table
.mw-template-data-params
.template-data-params
  width 100%
  border-collapse collapse
  margin 1em 0

  th
  td
    padding 0.75em 1em
    text-align left
    border-bottom 1px solid $border-subtle

  th
    background rgba($arch-blue, 0.1)
    color $lighter
    font-weight 600
    font-size 0.9em
    text-transform uppercase
    letter-spacing 0.05em

  tr:hover
    background rgba($arch-blue, 0.05)

// =============================================================================
// TEMPLATE PARAMETER CARDS
// =============================================================================
// Individual parameter display cards

.template-parameter-card
.parameter-card
  display flex
  flex-direction column
  gap 0.5em
  margin 1em 0
  padding 1em 1.25em
  background rgba($base, 0.6)
  border 1px solid $border-subtle
  border-radius $border-radius-md
  transition transition-medium

  &:hover
    border-color rgba($arch-blue, 0.4)
    box-shadow $shadow-subtle

  // Parameter name header
  .param-name
    display flex
    align-items center
    gap 0.5em
    font-family $font-mono
    font-size 1em
    font-weight 600
    color $lighter

    // Parameter code styling
    code
      padding 0.2em 0.5em
      background rgba($arch-blue, 0.15)
      border-radius $border-radius-sm
      color $arch-blue
      font-size 0.9em

// =============================================================================
// PARAMETER TYPE INDICATORS
// =============================================================================
// Visual indicators for parameter types (string, number, boolean, etc.)

.param-type
.param-type-indicator
  display inline-flex
  align-items center
  gap 0.35em
  padding 0.25em 0.65em
  background rgba($arch-blue, 0.12)
  border-radius $border-radius-sm
  font-size 0.8em
  font-weight 500
  color $light
  font-family $font-mono

  // Type-specific colors
  &.type-string
    background rgba($arch-blue, 0.12)
    color $light

  &.type-number
    background rgba($green, 0.12)
    color $green

  &.type-boolean
    background rgba($orange, 0.12)
    color $orange

  &.type-wiki-page-name
    background rgba($arch-blue, 0.12)
    color $arch-blue

  &.type-line
  &.type-text
    background rgba($secondary-blue, 0.12)
    color $secondary-blue

  &.type-date
    background rgba($orange, 0.12)
    color $orange

  &.type-url
    background rgba($term-cyan, 0.12)
    color $term-cyan

  &.type-email
    background rgba($gold, 0.12)
    color $gold

// =============================================================================
// REQUIRED/OPTIONAL INDICATORS
// =============================================================================
// Badges showing whether parameters are required or optional

.param-required
.param-optional
  display inline-flex
  align-items center
  gap 0.25em
  padding 0.2em 0.5em
  border-radius $border-radius-sm
  font-size 0.75em
  font-weight 600
  text-transform uppercase
  letter-spacing 0.05em

.param-required
  background rgba($secondary-red, 0.15)
  color $secondary-red
  border 1px solid rgba($secondary-red, 0.3)

  &::before
    content "●"
    font-size 0.6em

.param-optional
  background rgba($muted, 0.15)
  color $muted
  border 1px solid rgba($muted, 0.3)

  &::before
    content "○"
    font-size 0.6em

// =============================================================================
// DEFAULT VALUE DISPLAY
// =============================================================================
// Styling for parameter default values

.param-default
.param-default-value
  display flex
  align-items center
  gap 0.5em
  margin-top 0.5em
  padding 0.5em 0.75em
  background rgba($darker, 0.5)
  border-radius $border-radius-sm
  font-size 0.85em
  color $light

  .default-label
    font-weight 500
    color $muted
    font-size 0.8em
    text-transform uppercase
    letter-spacing 0.05em

  .default-value
    font-family $font-mono
    color $arch-blue
    background rgba($arch-blue, 0.1)
    padding 0.15em 0.4em
    border-radius $border-radius-sm

// =============================================================================
// PARAMETER DESCRIPTION
// =============================================================================
// Description text for parameters

.param-description
  margin-top 0.5em
  padding-top 0.5em
  border-top 1px dashed rgba($border-subtle, 0.5)
  font-size 0.9em
  line-height 1.6
  color $light

// =============================================================================
// PARAMETER ALIASES
// =============================================================================
// Alternative parameter names

.param-aliases
  display flex
  flex-wrap wrap
  gap 0.35em
  margin-top 0.5em

  .alias-label
    font-size 0.75em
    color $muted
    text-transform uppercase
    letter-spacing 0.05em

  .alias-name
    font-family $font-mono
    font-size 0.8em
    padding 0.15em 0.4em
    background rgba($arch-blue, 0.1)
    border 1px solid rgba($arch-blue, 0.2)
    border-radius $border-radius-sm
    color $arch-blue

// =============================================================================
// PARAMETER DEPRECATION
// =============================================================================
// Styling for deprecated parameters

.param-deprecated
  .param-name
    color $secondary-red

    code
      background rgba($secondary-red, 0.15)
      color $secondary-red
      text-decoration line-through

  .deprecation-notice
    display flex
    align-items flex-start
    gap 0.5em
    margin-top 0.5em
    padding 0.5em 0.75em
    background rgba($secondary-red, 0.1)
    border-left 3px solid $secondary-red
    border-radius 0 $border-radius-sm $border-radius-sm 0
    font-size 0.85em
    color $light

    &::before
      content "⚠️"
      flex-shrink 0

// =============================================================================
// TEMPLATE DATA MANIPULABLE FLAG
// =============================================================================
// Indicates parameters that can be used in templates

.param-manipulable
  &::after
    content "✎"
    margin-left 0.35em
    font-size 0.8em
    color $arch-blue
    opacity 0.7

// =============================================================================
// PARAMETER LAYOUT VARIANTS
// =============================================================================
// Different layouts for parameter documentation

// Compact table layout
.template-data-compact
  .mw-template-data-params
    font-size 0.9em

    th
    td
      padding 0.5em 0.75em

// Card grid layout
.template-data-cards
  display grid
  grid-template-columns repeat(auto-fill, minmax(280px, 1fr))
  gap 1em

  .template-parameter-card
    margin 0

// Inline layout for small parameter sets
.template-data-inline
  display flex
  flex-wrap wrap
  gap 0.75em
  align-items flex-start

  .template-parameter-card
    flex 0 0 auto
    margin 0
    padding 0.5em 0.75em

    .param-description
      display none

// =============================================================================
// TEMPLATE DATA SEARCH/FILTER
// =============================================================================
// Search input for filtering parameters

.template-data-search
  display flex
  align-items center
  gap 0.5em
  margin-bottom 1em
  padding 0.5em 0.75em
  background rgba($base, 0.6)
  border 1px solid $border-subtle
  border-radius $border-radius-sm

  .search-icon
    color $muted

  input
    flex 1
    background transparent
    border none
    color $light
    font-size 0.9em

    &::placeholder
      color $muted

    &:focus
      outline none

// =============================================================================
// RESPONSIVE ADJUSTMENTS
// =============================================================================

@media (max-width 768px)
  .mw-template-data
    padding 1em

  .mw-template-data-params
    display block
    overflow-x auto

  .template-data-cards
    grid-template-columns 1fr

  .template-parameter-card
    padding 0.75em 1em
