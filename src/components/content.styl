@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/gradients'
@import '../mixins/effects'

// Main content area
#content
  background-color $dark
  border 1px solid $border-subtle
  color $light
  border-radius $border-radius-md
  box-shadow $shadow-subtle
  transition box-shadow $transition-medium
  padding 1em 1.5em

  // Subtle lift effect on content area isn't usually great for UX as it moves text
  // Removed hover-lift() for better stability, kept transition just in case

// Links
a,
a:visited
  text-decoration none !important
  color $secondary-blue
  background-image linear-gradient(to right, $orange, $orange)
  background-size 0% 1px
  background-repeat no-repeat
  background-position left bottom
  transition background-size $transition-fast, color $transition-fast

  &:hover
    color $orange
    background-size 100% 1px

// Man page links and other specific template links
.archwiki-template-man a,
.archwiki-template-pkg a
  color $term-green !important
  background-image linear-gradient(to right, $term-bright-green, $term-bright-green) !important

  &:hover
    color $term-bright-green !important
// Headings with gradient underlines
h1,
h2,
h3,
h4,
h5,
h6
  color $lighter
  font-weight 600
  line-height 1.3
  margin-top 1.5em
  margin-bottom 0.75em

h1,
h2
  position relative
  padding-bottom 0.5em
  margin-bottom 1em

h1::after
  content ""
  position absolute
  bottom 0
  left 0
  right 0
  height 3px
  gradient-primary()

  border-radius 2px

h2::after
  content ""
  position absolute
  bottom 0
  left 0
  right 0
  height 2px
  background linear-gradient(90deg, $arch-blue, transparent)
  border-radius 1px

// Collapsible content blocks
.mw-collapsible
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.75em 1em
  transition background-color $transition-fast, border-color $transition-fast, box-shadow $transition-fast

  &:hover
    background linear-gradient(135deg, $dark, rgba($arch-blue, 0.08))
    border-color rgba($arch-blue, 0.25)
    box-shadow $shadow-subtle

.mw-collapsible-toggle
  display inline-flex
  align-items center
  gap 0.35em
  color $secondary-blue
  background-color $darker
  border 1px solid rgba($arch-blue, 0.35)
  border-radius $border-radius-sm
  padding 0.25em 0.6em
  font-size 0.9em
  cursor pointer
  transition background-color $transition-fast, border-color $transition-fast, color $transition-fast
  focus-ring($arch-blue)

  &:hover
    background-color rgba($arch-blue, 0.12)
    border-color rgba($arch-blue, 0.6)
    color $arch-blue

.mw-collapsible-content
  margin-top 0.6em
  padding-top 0.6em
  border-top 1px solid $border-subtle
