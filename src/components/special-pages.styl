// Special Pages styling for Violet Void ArchWiki
// Search, categories, contributions, whatlinkshere, etc.

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// SEARCH RESULTS PAGE ENHANCEMENTS
// =============================================================================

// Search result item styling
.mw-search-results
  li
    padding 0.75em
    margin 0.5em 0
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.02))
    border 1px solid $border-subtle
    border-radius $border-radius-md
    transition all 0.2s ease

    &:hover
      border-color rgba($arch-blue, 0.3)
      box-shadow $shadow-subtle

  .mw-search-result-heading a
    color $secondary-blue
    font-weight 600
    font-size 1.1em

    &:hover
      color $arch-blue

// Match highlighting in snippets
.searchmatch
  background-color rgba($orange, 0.3)
  color $lighter
  padding 0.1em 0.2em
  border-radius 2px

// Advanced search form
.mw-search-form
  background-color $darker
  padding 1em
  border-radius $border-radius-md
  border 1px solid $border-subtle

// Search suggestions dropdown
.mw-search-suggest
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  box-shadow $shadow-lg

  a
    color $light
    padding 0.5em 0.75em
    display block

    &:hover
      background-color rgba($arch-blue, 0.1)
      color $lighter

// =============================================================================
// CATEGORY PAGE GRID LAYOUT
// =============================================================================

// Category member grid/list toggle
.mw-category
  column-count 3
  column-gap 2em
  column-rule 1px solid $border-subtle

  @media (max-width: 768px)
    column-count 2

  @media (max-width: 480px)
    column-count 1

// Subcategory cards
.mw-category-group
  margin-bottom 1em

  h3
    color $lighter
    font-size 0.9em
    padding 0.5em
    background-color rgba($arch-blue, 0.05)
    border-radius $border-radius-sm

  ul
    list-style none
    padding 0

  li
    padding 0.3em 0.5em

    a
      color $secondary-blue

      &:hover
        color $arch-blue

// Page count badges
.page-count
  font-variant-numeric tabular-nums
  font-size 0.8em
  color $muted
  margin-inline-start 0.5em

// =============================================================================
// SPECIAL:ALLPAGES / SPECIAL:PREFIXINDEX
// =============================================================================

// Alphabetical navigation styling
.mw-allpages-nav
  display flex
  flex-wrap wrap
  gap 0.3em
  padding 1em
  background-color $darker
  border-radius $border-radius-md
  margin-bottom 1em

  a
    padding 0.3em 0.6em
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue
    border-radius $border-radius-sm
    text-decoration none
    font-variant-numeric tabular-nums

    &:hover
      background-color $arch-blue
      color $darker

// Page list with hover states
.mw-allpages-body
  ul
    list-style none
    padding 0

  li
    padding 0.4em 0.6em
    border-bottom 1px solid $border-subtle
    transition background-color 0.2s ease

    &:hover
      background-color rgba($arch-blue, 0.05)

    a
      color $light

      &:hover
        color $arch-blue

// Namespace selector
.mw-allpages-form
  select
    background-color $darker
    color $lighter
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    padding 0.5em

// =============================================================================
// USER CONTRIBUTIONS PAGE
// =============================================================================

// Contribution list styling
.mw-contributions-list
  list-style none
  padding 0

  li
    padding 0.5em
    border-bottom 1px solid $border-subtle
    display flex
    flex-wrap wrap
    gap 0.5em
    align-items center

    &:hover
      background-color rgba($arch-blue, 0.03)

// Date grouping with tabular-nums timestamps
.mw-contributions-date
  font-variant-numeric tabular-nums
  color $muted
  font-size 0.85em
  min-width 10em

// Edit summary highlighting
.comment
  font-style italic
  color $light

  &.mw-comment-unhidden
    color $lighter

// =============================================================================
// SPECIAL:WHATLINKSHERE
// =============================================================================

// Backlinks list styling
#mw-whatlinkshere-list
  list-style none
  padding 0

  li
    padding 0.5em
    border-bottom 1px solid $border-subtle

    &:hover
      background-color rgba($arch-blue, 0.03)

// Redirect badge styling
.mw-whatlinkshere-redirect
  display inline-block
  padding 0.1em 0.4em
  font-size 0.75em
  background-color rgba($purple, 0.2)
  color $purple
  border-radius $border-radius-sm
  text-transform uppercase
  letter-spacing 0.05em

// Namespace filtering UI
.mw-whatlinkshere-nsfilter
  background-color $darker
  padding 1em
  border-radius $border-radius-md
  margin 1em 0

  label
    color $lighter
    margin-inline-end 0.5em

