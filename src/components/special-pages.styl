// Special Pages Styling
// Styles for MediaWiki special pages (Search, Categories, Contributions, etc.)
// Browser support: 97%+

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// SEARCH RESULTS PAGE ENHANCEMENTS
// =============================================================================

// Search results container
.mw-search-results
.search-results
  list-style none
  padding 0
  margin 1em 0

// Individual search result item
.mw-search-result
.search-result-item
  padding 1em 1.25em
  margin 0.5em 0
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.02))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  transition all 0.2s ease

  &:hover
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.06))
    border-color rgba($arch-blue, 0.2)
    box-shadow $shadow-subtle

// Search result title link
.mw-search-result-heading
.search-result-title
  margin-bottom 0.5em

  a
    color $secondary-blue
    font-size 1.1em
    font-weight 500
    text-decoration none
    border-bottom 1px solid transparent
    transition all 0.2s ease

    &:hover
      color $arch-blue
      border-bottom-color rgba($arch-blue, 0.3)

    &:visited
      color rgba($arch-blue, 0.7)

// Match highlighting in snippets
.searchmatch
.search-highlight
  background-color rgba($arch-blue, 0.25)
  color $lighter
  padding 0.1em 0.3em
  border-radius 2px
  font-weight 500

// Search result snippet/excerpt
.mw-search-result-data
.search-result-excerpt
  color $muted
  font-size 0.9em
  line-height 1.5
  margin 0.5em 0

  // Limit to 3 lines
  display -webkit-box
  -webkit-line-clamp 3
  -webkit-box-orient vertical
  overflow hidden

// Search result metadata (size, date, word count)
.mw-search-result-info
.search-result-meta
  font-size 0.8em
  color $muted
  margin-top 0.5em
  display flex
  flex-wrap wrap
  gap 0.5em 1em

  span
    display inline-flex
    align-items center
    gap 0.3em

// Advanced search form styling
.mw-search-form
.search-form
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.03))
  border 1px solid $border-subtle
  border-radius $border-radius-lg
  padding 1.5em
  margin 1em 0

// Search input field
.mw-search-input
.search-input
  width 100%
  padding 0.75em 1em
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  color $lighter
  font-size 1em
  transition all 0.2s ease

  &:focus
    outline none
    border-color $arch-blue
    box-shadow 0 0 0 2px rgba($arch-blue, 0.2)

  &::placeholder
    color $muted

// Search options panel
.mw-search-options
.search-options
  display grid
  grid-template-columns repeat(auto-fill, minmax(200px, 1fr))
  gap 1em
  margin-top 1em
  padding-top 1em
  border-top 1px solid $border-subtle

// Search option group
.search-option-group
  label
    display block
    color $muted
    font-size 0.85em
    margin-bottom 0.5em
    text-transform uppercase
    letter-spacing 0.05em

  select
  input[type="text"]
    width 100%
    padding 0.5em 0.75em
    background-color $darker
    border 1px solid $border-subtle
    border-radius $border-radius-sm
    color $lighter
    font-size 0.9em

    &:focus
      outline none
      border-color $arch-blue

// Namespace filter chips
.namespace-filter
  display flex
  flex-wrap wrap
  gap 0.5em
  margin-top 0.5em

.namespace-chip
  padding 0.3em 0.7em
  background-color rgba($arch-blue, 0.1)
  border 1px solid transparent
  border-radius 1em
  color $secondary-blue
  font-size 0.8em
  cursor pointer
  transition all 0.2s ease

  &:hover
    background-color rgba($arch-blue, 0.2)
    border-color rgba($arch-blue, 0.3)

  &.active
    background-color $arch-blue
    color $darker
    border-color $arch-blue

// Search button
.mw-search-button
.search-button
  padding 0.75em 1.5em
  background linear-gradient(135deg, $arch-blue, rgba($arch-blue, 0.8))
  border none
  border-radius $border-radius-md
  color $darker
  font-size 1em
  font-weight 500
  cursor pointer
  transition all 0.2s ease

  &:hover
    transform translateY(-1px)
    box-shadow 0 4px 12px rgba($arch-blue, 0.3)

  &:active
    transform translateY(0)

// "Did you mean" suggestion
.search-suggestion
  padding 1em
  background-color rgba($orange, 0.1)
  border 1px solid rgba($orange, 0.3)
  border-radius $border-radius-md
  margin 1em 0
  color $lighter

  a
    color $orange
    font-weight 500

    &:hover
      text-decoration underline

// No results message
.mw-search-nonefound
.search-no-results
  padding 2em
  text-align center
  color $muted
  font-size 1.1em

  .search-suggestions
    margin-top 1em
    font-size 0.9em

    a
      color $secondary-blue

// Search results pagination
.mw-search-pager
.search-pagination
  display flex
  justify-content center
  align-items center
  gap 0.5em
  margin 2em 0
  padding 1em
  background-color $darker
  border-radius $border-radius-md

  a
  span
    padding 0.5em 0.75em
    border-radius $border-radius-sm
    text-decoration none
    transition all 0.2s ease

  a
    color $secondary-blue
    background-color transparent

    &:hover
      background-color rgba($arch-blue, 0.1)
      color $arch-blue

  .active
  .mw-search-pager-current
    background-color $arch-blue
    color $darker
    font-weight 500

  .disabled
    color $muted
    cursor not-allowed
    opacity 0.5
