  background linear-gradient(135deg, rgba($secondary-red, 0.12), rgba($secondary-red, 0.06)) !important

// Ensure text in notice boxes is readable
.note p
.tip p
.warning p
.important p
div.note p
div.tip p
div.warning p
div.important p
.notification p
.admonition p
  color $lighter !important

// Links in notice boxes
.note a
.tip a
.warning a
.important a
div.note a
div.tip a
div.warning a
div.important a
  color $secondary-blue !important

.note a:hover
.tip a:hover
.warning a:hover
.important a:hover
div.note a:hover
div.tip a:hover
div.warning a:hover
div.important a:hover
  color $orange !important

// =============================================================================
// MIX-BLEND-MODE FOR EMPHASIS EFFECTS
// =============================================================================

// Subtle blend effects for emphasis and overlays

// Warning boxes with enhanced contrast via blend mode
.warningbox
.errorbox
  mix-blend-mode normal // Base - ensures consistent appearance

  // Overlay effect for nested emphasis
  strong
  em
    mix-blend-mode plus-lighter

// Highlight overlays
.highlight-overlay
  mix-blend-mode screen
  opacity 0.15

// Emphasis marks with blend effects
mark
.highlight
  mix-blend-mode multiply
