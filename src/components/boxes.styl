@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/gradients'
@import '../mixins/effects'

// ArchWiki template boxes
div.archwiki-template-box
  position relative
  overflow hidden
  transition all $transition-medium
  // Multi-layer shadow for realistic depth: tight inner shadow + diffuse outer shadow
  // Browser support: 97%+ (Chrome, Firefox, Safari, Edge)
  box-shadow 0 1px 2px rgba($darker, 0.15), 0 4px 16px rgba($darker, 0.25)
  margin 1em 0

  // Note: hover-lift removed to avoid layout shifting on informational content
  // hover-lift()

// Note boxes
div.archwiki-template-box.archwiki-template-box-note
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.06))
  border 1px solid rgba($arch-blue, 0.12)
  border-radius $border-radius-md
  padding 0.6em 0.75em 0.6em 1.5em

  &::before
    content ""
    position absolute
    top 0
    left 0
    width 3px
    height 100%
    gradient-primary-vertical()

// Tip boxes
div.archwiki-template-box.archwiki-template-box-tip
  background linear-gradient(135deg, rgba($green, 0.1), rgba($green, 0.03))
  border 1px solid rgba($green, 0.14)
  border-radius $border-radius-md
  padding 0.6em 2em 0.6em 0.75em

  &::before
    content "💡"
    position absolute
    top 0.4em
    right 0.5em
    font-size 1em
    opacity 0.8
    filter drop-shadow(0 0 5px rgba($green, 0.4))

// Warning boxes
div.archwiki-template-box.archwiki-template-box-warning
  background linear-gradient(135deg, rgba($red, 0.1), rgba($secondary-red, 0.03))
  border 1px solid rgba($secondary-red, 0.12)
  border-radius $border-radius-md
  padding 0.6em 2em 0.6em 0.75em
  color $light !important

  &::before
    content "!"
    position absolute
    top 0.4em
    right 0.5em
    font-size 1em
    font-weight bold
    color $secondary-red

// ArchWiki message boxes
.mw-message-box
.messagebox
.warningbox
.errorbox
.successbox
.noticebox
  position relative
  overflow hidden
  transition all $transition-medium
  // Multi-layer shadow for realistic depth
  box-shadow 0 1px 2px rgba($darker, 0.15), 0 4px 16px rgba($darker, 0.25)
  margin 1em 0
  border-radius $border-radius-md

.mw-message-box
.messagebox
.noticebox
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.06))
  border 1px solid rgba($arch-blue, 0.12)
  padding 0.6em 0.75em 0.6em 1.5em

  &::before
    content ""
    position absolute
    top 0
    left 0
    width 3px
    height 100%
    gradient-primary-vertical()

.successbox
  background linear-gradient(135deg, rgba($green, 0.1), rgba($green, 0.03))
  border 1px solid rgba($green, 0.14)
  padding 0.6em 2em 0.6em 0.75em
  color $light !important

  &::before
    content "✓"
    position absolute
    top 0.4em
    right 0.5em
    font-size 1em
    font-weight bold
    color $green
    opacity 0.85
    filter drop-shadow(0 0 5px rgba($green, 0.4))

.warningbox
  background linear-gradient(135deg, rgba($red, 0.1), rgba($secondary-red, 0.03))
  border 1px solid rgba($secondary-red, 0.12)
  padding 0.6em 2em 0.6em 0.75em
  color $light !important

  &::before
    content "!"
    position absolute
    top 0.4em
    right 0.5em
    font-size 1em
    font-weight bold
    color $secondary-red

.errorbox
  background linear-gradient(135deg, rgba($secondary-red, 0.14), rgba($secondary-red, 0.04))
  border 1px solid rgba($secondary-red, 0.2)
  padding 0.6em 2em 0.6em 0.75em
  color $light !important

  &::before
    content "✖"
    position absolute
    top 0.4em
    right 0.5em
    font-size 1em
    font-weight bold
    color $secondary-red

