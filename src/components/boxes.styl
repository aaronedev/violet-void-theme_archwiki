.admonition-warning
  border-left 4px solid $orange !important
  background linear-gradient(135deg, rgba($orange, 0.12), rgba($orange, 0.06)) !important

// Important/Caution - red accent
body .mw-body .important
body .mw-body .mw-parser-output .important
.important
div.important
