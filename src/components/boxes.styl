  border-left 4px solid $arch-blue !important
  background linear-gradient(135deg, rgba($arch-blue, 0.12), rgba($arch-blue, 0.06)) !important

// Tip specific styling - green accent
body .mw-body .tip
body .mw-body .mw-parser-output .tip
.tip
div.tip
.notification-tip
.admonition-tip
  border-left 4px solid $green !important
  background linear-gradient(135deg, rgba($green, 0.12), rgba($green, 0.06)) !important

// Warning specific styling - orange accent
body .mw-body .warning
body .mw-body .mw-parser-output .warning
.warning
div.warning
