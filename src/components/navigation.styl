@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/effects'
@import '../mixins/menus'

// Arch navigation bar
#archnavbar
  height 40px !important
  padding 10px 15px !important
  background $base !important
  border-bottom 5px $arch-blue solid !important
  display flex
  align-items center

// Sidebar (article table of contents and misc side panels)
.mw-sidebar
  menu-panel()

// Global main menu (Vector menu shown when the hamburger button is opened)
// This styles the left-hand site navigation so it fits the dark, violet-toned header.
#vector-main-menu
.vector-main-menu
  // Subtle gradient from the base colour towards a hint of Arch blue
  menu-panel()

  // Section headings within the main menu
  .vector-menu-heading
    menu-heading()

  // Individual menu items
  .vector-menu-content li
    menu-list-item()

// Portal headings
.vector-menu-portal .vector-menu-heading
  menu-heading()

  display block

// Portal content
.vector-menu-portal .vector-menu-content li
  menu-list-item()

  a
    line-height 1.5
    padding 0.2em 0

// -----------------------------------------------------------------------------
// Scroll Snap Enhancements for Mobile UX
// Scroll snapping provides a smoother navigation experience on touch devices
// by aligning content to snap points during scrolling.

// Table of contents
#toc
.toc
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.4em 0.75em
  box-shadow $shadow-subtle
  transition all $transition-medium
  // Scroll snap for better mobile UX
  scroll-snap-type y proximity
  overflow-y auto
  scrollbar-gutter stable // Prevent layout shift when scrollbar appears
  // Performance: hint browser about scroll and box-shadow changes
  will-change scroll-position, box-shadow

  &:hover
    box-shadow $shadow-elevated
    border-color rgba($arch-blue, 0.2)

// TOC list items snap alignment
#toc li
.toc li
  scroll-snap-align start
  scroll-snap-stop always

// Page title bar table of contents button alignment
.vector-toc-landmark
  display flex
  align-items center

.vector-page-titlebar-toc
  display flex
  align-items center
  margin 0

  .vector-dropdown-label
    display inline-flex
    align-items center
    justify-content center
    line-height 1
    padding 0.3em

    .vector-icon
      margin 0
      vertical-align middle

.tocnumber
  color $secondary-blue
  font-weight 600
  margin-inline-end 0.5em

// TOC toggle
.toctogglelabel
  color $secondary-blue
  font-size 0.9em
  cursor pointer

  &:hover
    color $orange

// -----------------------------------------------------------------------------
// Dropdown menu styling (Vector main menu)
// The Vector skin on ArchWiki uses a white dropdown container for the main
// navigation menu and applies its own backgrounds to nested elements like
// `.vector-menu-content` and `.mw-portlet`.  To ensure the Violet‑Void theme
// colours flow seamlessly through the entire panel, we override these
// backgrounds and apply our dark gradient, violet accents and consistent
// typography.  High specificity selectors are used to win against upstream
// styles without resorting to excessive `!important` flags.

// Outer wrapper for dropdown menus (e.g. the main menu opened via the
// hamburger button).  Apply the theme's gradient, rounded corners and shadow.
.vector-dropdown-content
  menu-panel()
  // Scroll snap for smooth navigation menus on mobile
  scroll-snap-type y proximity
  overflow-y auto
  scrollbar-gutter stable // Prevent layout shift when scrollbar appears
  // Performance: hint browser about scroll and transform changes
  will-change scroll-position, transform, opacity

  // Ensure nested blocks don't introduce their own light backgrounds.  The
  // `>` selector combined with class names targets immediate children as well
  // as deeper nested containers used by Vector's layout (like
  // `.vector-main-menu`, `.vector-unpinned-container`, `.mw-portlet` and the
  // pinnable header bar).
  > *
  .vector-main-menu
  .vector-unpinned-container
  .mw-portlet
  .vector-pinnable-header
  .vector-menu-content
    background-color transparent
    border 0
    box-shadow none

  // Style the pinnable header bar ("Main menu" label and pin/unpin buttons)
  .vector-pinnable-header
    pinnable-header()

  // Section headings within dropdowns
  .vector-menu-heading
    menu-heading()

  // List items in dropdown menus
  .vector-menu-content li
    menu-list-item(true)
    // Scroll snap alignment for smooth menu navigation
    scroll-snap-align start
    scroll-snap-stop always

    a
      padding 0.25em 0.5em
      line-height 1.4

// -----------------------------------------------------------------------------
// Pinned sidebar menu styling
// When the main menu is pinned to the sidebar, Vector inserts it into a
// `.vector-pinned-container` within a sticky wrapper.  The default styles
// assign a white background and fade-out overlay to this container.  These
// overrides apply our Violet‑Void gradient and remove the unwanted white
// backdrop, ensuring the pinned menu matches the dropdown styling.

// Apply dark gradient, border and shadow to pinned containers
.vector-pinned-container
  menu-panel()

// Keep the sticky wrapper neutral so empty containers do not render a panel
.vector-sticky-pinned-container
  background-color transparent
  border 0
  box-shadow none
  padding 0

// Remove the white fade overlay at the bottom of sticky pinned containers
.vector-sticky-pinned-container::after
  display none

// Remove default backgrounds from nested elements inside pinned menus
.vector-pinnable-element
.vector-pinnable-element .vector-menu-content
.vector-pinnable-element .mw-portlet
.vector-pinnable-header
  background-color transparent
  border 0
  box-shadow none

// Style the pinnable header (appears in both pinned and dropdown menus)
.vector-pinnable-header
  pinnable-header()

// Headings within pinned menus
.vector-pinnable-element .vector-menu-heading
  menu-heading()

// Menu items within pinned menus
.vector-pinnable-element .vector-menu-content li
  menu-list-item(true)
  // Scroll snap for pinned menu items
  scroll-snap-align start
  scroll-snap-stop always

  a
    padding 0.25em 0.5em
    line-height 1.4

// -----------------------------------------------------------------------------
// Vector header styling
// The page header in the Vector skin uses a very dark hue (#050A10) that
// clashes with the Violet‑Void palette.  These rules set the header and its
// container to our theme's dark gradient and ensure the border aligns with
// other components.  Only key structural elements are targeted to avoid
// unintended overrides.

.vector-header-container
.vector-header
.vector-header-start
.vector-header-end
header.vector-header
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border-bottom 1px solid $border-subtle

// -----------------------------------------------------------------------------
// FIX: Header icon links get a fake underline (background gradient) from global
// link styling (content.styl) and it visually cuts through icons (bell, etc.).
// Kill that underline ONLY in the header area (keep it everywhere else).

.vector-header a
.vector-header a:visited
  // Disable gradient-underline background used by the global link styling
  background-image none !important
  background-size auto !important
  background-repeat initial !important
  background-position initial !important
  text-decoration none !important

  &:hover
    background-image none !important
    text-decoration none !important

// Make header icons immune to text-decoration metrics and center them properly
.vector-header .vector-icon
.vector-header .mw-ui-icon
  display inline-flex
  align-items center
  justify-content center
  vertical-align middle
  width 16px
  height 16px
  margin 0

// Fix hamburger menu icon alignment
.vector-header-start .vector-dropdown-label
.vector-header .vector-dropdown-label
  display inline-flex
  align-items center
  justify-content center
  padding 0.25em
  line-height 1

  .vector-icon
    margin 0
    vertical-align middle

// Fix all icon alignment in buttons and links
.vector-sticky-header .cdx-button
.vector-header a
.vector-header button
  display inline-flex
  align-items center
  justify-content center
  gap 0.3em

  .vector-icon
  .mw-ui-icon
  .cdx-icon
    margin 0
    vertical-align middle
    flex-shrink 0

// -----------------------------------------------------------------------------
// Sticky header styling (appears when scrolling)
// The sticky header inherits default Vector styles which include plain blue
// buttons and light backgrounds.  These rules re-theme the sticky header to
// match the Violet‑Void palette.  They apply a dark gradient to the header
// container, style the search bar and its toggle, and refine icons and the
// sticky table‑of‑contents dropdown.

// Header container and inner wrapper
.vector-sticky-header-container
.vector-sticky-header
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border-bottom 1px solid $border-subtle
  box-shadow $shadow-subtle
  // Performance: hint browser for sticky positioning transforms
  will-change transform

// Buttons and icons within the sticky header (search toggle, discussion/history
// icons, user menu, etc.)
.vector-sticky-header .cdx-button
  // Match menu panel styling
  gradient-surface()

  border 1px solid $border-subtle
  color $lighter
  border-radius $border-radius-sm
  padding 0.25em 0.5em
  font-size 0.85em
  line-height 1
  // Performance: hint browser for hover transitions
  will-change background-color, border-color, color

  &:hover
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
    border-color rgba($arch-blue, 0.3)
    color $secondary-blue

// Search input inside the sticky header
#vector-sticky-search-form .cdx-search-input__input-wrapper input
#vector-sticky-search-form .cdx-text-input__input
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.4em 0.6em

// Search submit button inside the sticky header
#vector-sticky-search-form .cdx-button.cdx-search-input__end-button
  // Match menu panel styling
  gradient-surface()

  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-sm
  padding 0.3em 0.6em
  font-size 0.8em
  // Performance: hint browser for hover transitions
  will-change background-color, border-color, color

  &:hover
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
    border-color rgba($arch-blue, 0.3)
    color $secondary-blue

// Sticky header table of contents dropdown styling
.vector-sticky-header-toc .vector-dropdown-content
  menu-panel()

  width max-content
  // Scroll snap for sticky TOC dropdown
  scroll-snap-type y proximity
  overflow-y auto
  scrollbar-gutter stable // Prevent layout shift when scrollbar appears
  // Performance: hint browser about scroll and visibility changes
  will-change scroll-position, transform, opacity

  // Transparent backgrounds for nested elements
  > *
  .vector-pinnable-element
  .vector-unpinned-container
  .mw-portlet
  .vector-pinnable-header
  .vector-menu-content
    background-color transparent
    border 0
    box-shadow none

  // Pinned header inside sticky TOC
  .vector-pinnable-header
    pinnable-header()

  // Headings within the sticky TOC dropdown
  .vector-menu-heading
    menu-heading()

  // Menu items within the sticky TOC dropdown
  .vector-menu-content li
    menu-list-item(true)
    // Scroll snap alignment for sticky TOC items
    scroll-snap-align start
    scroll-snap-stop always

    a
      padding 0.25em 0.5em
      line-height 1.4

// -----------------------------------------------------------------------------
// Sticky table of contents and context bar enhancements
// The Vector sticky header includes a context bar that displays the page title
// and a dropdown table of contents.  By default, these elements use plain
// colours that clash with the Violet‑Void palette (e.g. bright blue links and
// dark backdrops).  These overrides apply our dark gradient, lighten text and
// accent colours for active entries and hover states.  They also refine the
// toggle buttons used to expand/collapse TOC sections.

// Style the page title in the sticky context bar
.vector-sticky-header-context-bar-primary
  color $light
  font-weight 600
  font-size 1em
  padding 0.25em 0.5em

// General styling for table of contents lists (applies to sticky TOC and
// pinned/inline TOC).  Provide a dark background and consistent padding.
.vector-toc
.vector-sticky-header-toc .vector-toc
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.4em 0.75em
  box-shadow $shadow-subtle
  // Scroll snap for better mobile UX
  scroll-snap-type y proximity
  overflow-y auto
  scrollbar-gutter stable // Prevent layout shift when scrollbar appears
  // Performance: hint browser about scroll changes
  will-change scroll-position

// List items within the TOC
.vector-toc .vector-toc-list-item
  position relative
  // Scroll snap alignment for smooth navigation
  scroll-snap-align start
  scroll-snap-stop always

// Links inside the TOC
.vector-toc .vector-toc-link
  color $lighter
  display block
  // FIX: Ensure space for the absolute toggle button on the left
  padding 0.15em 0.5em 0.15em 2em
  border-radius $border-radius-sm
  text-decoration none
  line-height 1.4
  // Performance: hint browser for hover transitions
  will-change background-color, color

  &:hover
    background-color rgba($arch-blue, 0.15)
    color $white
    font-weight 500

// Highlight active section links in the TOC
.vector-toc .vector-toc-list-item-active > .vector-toc-link
.vector-toc .vector-toc-level-1-active:not(.vector-toc-list-item-expanded) > .vector-toc-link
.vector-toc .vector-toc-list-item-active.vector-toc-level-1-active > .vector-toc-link
  color $secondary-blue !important
  font-weight bold

// Text within TOC entries
.vector-toc .vector-toc-text
  color $lighter
  padding 0.1em 0

// Position the table‑of‑contents toggle buttons relative to the list item so
// their icons align vertically with the menu text.  Use a 50% offset and
// negative translation to achieve perfect centering regardless of line height.
.vector-toc .vector-toc-toggle
  position absolute
  left 0.5em
  top 50%
  transform translateY(-50%)
  // Match menu panel styling
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.06))
  border 1px solid $border-subtle
  color $lighter
  border-radius $border-radius-sm
  min-width 18px
  min-height 18px
  width 18px
  height 18px
  display flex
  align-items center
  justify-content center
  cursor pointer
  padding 0
  margin 0
  flex-shrink 0
  // Performance: hint browser for transform and hover transitions
  will-change transform, background-color, border-color

  &:hover
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
    border-color rgba($arch-blue, 0.3)
    color $secondary-blue

  .vector-icon
    width 12px
    height 12px
    fill $lighter
    margin 0
    vertical-align middle
    flex-shrink 0

// -----------------------------------------------------------------------------
// Site-wide search box and autocomplete results styling
// The ArchWiki search component uses Codex classes (\`cdx-*\`) to build its
// typeahead search boxes and result lists.  By default, these controls use
// generic light themes that contrast poorly with the Violet‑Void palette.
// These overrides restyle the search input, button and autocomplete menu to
// blend seamlessly into the dark interface and adopt neon violet accents.

// Wrapper around the search form
// Do not override structural layout (flex positioning) to avoid breaking
// the built-in positioning logic of the autocomplete menu.  Only apply
// colours and subtle borders.
#searchform
.cdx-typeahead-search__form
  background-color transparent
  border none
  border-radius 0
  box-shadow none

// Search input container
.cdx-search-input
.cdx-search-input--has-end-button
  background-color transparent
  border none
  border-radius 0

  // FIX: keep the default Codex layout (input + end button) intact
  // but make alignment predictable.
  display flex
  align-items center
  gap 0.25em

// Wrapper around the text input and menu
// IMPORTANT: keep \`position: relative\` (Codex uses it to anchor the menu).
// Do NOT turn this into a flex/grid container; that can mess with menu placement.
.cdx-search-input__input-wrapper
  position relative
  flex 1 1 auto
  min-width 0

// Text input with leading icon
// Do not alter the display of the text input container; only adjust colours.
.cdx-text-input
  // Keep it flexible so the input expands and the button stays close
  display flex
  align-items center
  flex 1 1 auto
  min-width 0
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  color $lighter

  // FIX: tighten vertical rhythm without breaking Codex sizing
  padding 0.25em 0.5em

.cdx-text-input .cdx-text-input__input
  flex 1 1 auto
  background-color transparent
  border none
  box-shadow none
  color $lighter
  font-size 0.95em
  line-height 1.2
  outline none

// Start icon inside the search input (magnifying glass)
.cdx-text-input__icon-vue.cdx-text-input__start-icon
  display flex
  align-items center
  justify-content center
  flex-shrink 0
  margin 0
  padding 0

  svg
    fill $secondary-blue
    // FIX: readable size + consistent alignment
    width 16px
    height 16px
    margin 0
    vertical-align middle
    display block

// Search submit button at the end of the input
.cdx-search-input__end-button.cdx-button
  // Match menu panel styling
  gradient-surface()

  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-sm

  // FIX: compact button, snug next to input
  margin-inline-start 0
  padding 0.3em 0.6em
  font-size 0.8em
  line-height 1
  white-space nowrap

  // Ensure it doesn't float away in flex layouts
  flex 0 0 auto
  // Performance: hint browser for hover transitions
  will-change background-color, border-color, color

  &:hover
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.12))
    border-color rgba($arch-blue, 0.3)
    color $secondary-blue

// Autocomplete dropdown menu
.cdx-menu.cdx-typeahead-search__menu
  // Darker background for readability of search results.  Increase the
  // violet overlay to improve contrast.
  gradient-surface()
  border 1px solid $border-subtle
  border-radius $border-radius-md
  box-shadow $shadow-subtle
  // Preserve default positioning and sizing of the autocomplete menu.  Only
  // set colours and borders; do not adjust margin or scrolling, as doing
  // so can cause the menu to render in the wrong place.
  padding 0
  // Performance: hint browser for menu visibility changes
  will-change transform, opacity

.cdx-menu__listbox
  list-style none
  margin 0
  padding 0

  li.cdx-menu-item
    margin 0
    padding 0

    // The anchor that forms each result entry
    .cdx-menu-item__content
      display flex
      flex-direction row
      align-items center
      color $light
      padding 0.3em 0.5em
      border-radius $border-radius-sm
      text-decoration none
      // Performance: hint browser for hover transitions
      will-change background-color, color

      &:hover
        background-color rgba($arch-blue, 0.1)
        color $secondary-blue

      // Thumbnail (placeholder icon) for search result
      .cdx-thumbnail
      .cdx-menu-item__thumbnail
        margin-inline-end 0.4em

        .cdx-icon svg
          fill $secondary-blue
          width 14px
          height 14px

      // Label text
      .cdx-menu-item__text__label
        color $lighter
        font-size 0.9em

    // Footer item (search for full text)
    &.cdx-typeahead-search__search-footer
      border-top 1px solid $border-subtle
      margin-top 0
      padding-top 0.3em

      .cdx-typeahead-search__search-footer__icon .cdx-icon svg
        fill $secondary-blue
        width 12px
        height 12px

      .cdx-typeahead-search__search-footer__text
        color $lighter
        font-size 0.85em

        strong.cdx-typeahead-search__search-footer__query
          color $secondary-blue

// -----------------------------------------------------------------------------
// Global Icon Alignment Fixes
// Ensure all icons throughout the theme are properly aligned and sized

// Universal icon alignment
.vector-icon
.mw-ui-icon
.oo-ui-iconElement-icon
.cdx-icon
  display inline-flex
  align-items center
  justify-content center
  vertical-align middle
  flex-shrink 0
  margin 0

// Fix icons in dropdown menus
.vector-dropdown-label
  display inline-flex
  align-items center
  justify-content center
  gap 0.3em

  .vector-icon
  .mw-ui-icon
    margin 0

// Fix icons in menu items
.vector-menu-content li a
.vector-toc-link
  display flex
  align-items center
  gap 0.3em

  .vector-icon
    margin 0
    flex-shrink 0

// Ensure consistent icon sizing
.vector-icon svg
.mw-ui-icon svg
.oo-ui-iconElement-icon svg
.cdx-icon svg
  display block
  margin 0
  vertical-align middle

// =============================================================================
// TOUCH-ACTION FOR BETTER TOUCH UX
// =============================================================================

// Prevents accidental zooming/panning on interactive elements
// Browser support: 97%+

// Navigation menus
.vector-menu
.vector-dropdown
.mw-portlet
  touch-action manipulation

// Dropdowns and popups
.vector-dropdown-content
.mw-body-content
  touch-action manipulation

// Interactive navigation elements
#p-navigation
#p-tb
#p-personal
  a
  button
    touch-action manipulation

// =============================================================================
// ISOLATION FOR Z-INDEX MANAGEMENT
// =============================================================================

// Creates new stacking contexts for z-index isolation
// Browser support: 97%+

// Dropdown menus need isolated stacking
.vector-dropdown
.vector-menu-content
  isolation isolate

// Modals and overlays
.mw-modal
.overlay
  isolation isolate

// Navigation panels
#mw-navigation
#mw-panel
  isolation isolate

// =============================================================================
// EDIT SECTION LINK STYLING
// =============================================================================

// Hover-reveal edit links for sections
// Browser support: 97%+

.mw-editsection
  font-size 0.75em
  opacity 0.3
  transition opacity 0.2s ease
  margin-inline-start 0.5em

  &:hover
    opacity 1

// Show edit link on section hover
.mw-headline:hover + .mw-editsection
h1:hover .mw-editsection
h2:hover .mw-editsection
h3:hover .mw-editsection
h4:hover .mw-editsection
h5:hover .mw-editsection
h6:hover .mw-editsection
  opacity 1

.mw-editsection a
  color $muted
  text-decoration none
  padding 0.2em 0.4em
  border-radius $border-radius-sm
  transition all 0.2s ease

  &:hover
    color $arch-blue
    background-color rgba($arch-blue, 0.1)

// =============================================================================
// INTERPOLATE-SIZE FOR AUTO TRANSITIONS
// =============================================================================

// Enable smooth transitions to/from auto values
// Browser support: 85%+ (Chrome 129+, Safari 17.5+)
// Note: Wrap in @css{} for Stylus compatibility

@css {
  // Collapsible sections can now animate to/from auto
  .mw-collapsible-content,
  .vector-toc ul,
  .toc ul,
  .vector-dropdown-content,
  .vector-menu-content {
    interpolate-size: allow-keywords;
  }
}

// =============================================================================
// calc-size() FOR AUTO TRANSITIONS
// =============================================================================

// Alternative to interpolate-size: allows smooth transitions to/from auto
// Browser support: 85%+ (Chrome 129+)
// Note: Wrap in @css{} for Stylus compatibility
// calc-size() is an alternative approach to interpolate-size

@css {
  @supports (height: calc-size(auto)) {
    /* Collapsible sections with calc-size */
    .mw-collapsible-content,
    .vector-toc ul,
    .toc ul,
    .vector-dropdown-content,
    .vector-menu-content {
      transition: height 0.3s ease, max-height 0.3s ease;
    }

    /* Auto-height transitions using calc-size */
    .mw-collapsible-content {
      height: calc-size(auto);
    }

    .mw-collapsible-content.collapsed {
      height: calc-size(0);
    }

    /* Dropdown menus */
    .vector-dropdown-content,
    .vector-menu-content {
      height: calc-size(auto);
    }

    .vector-dropdown-content.closed,
    .vector-menu-content.closed {
      height: calc-size(0);
    }
  }
}

// =============================================================================
// @starting-style FOR COLLAPSIBLE SECTIONS
// =============================================================================

// Entry animations for collapsible sections in navigation
// Browser support: 80%+ (Chrome 117+, Safari 17.5+)
// Note: Wrap in @css{} for Stylus compatibility

@css {
  @supports (@starting-style) {
    /* TOC collapsible sections */
    .toc > ul,
    .vector-toc > ul {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    @starting-style {
      .toc > ul,
      .vector-toc > ul {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* Vector menu collapsible content */
    .vector-menu-content {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .vector-menu-content {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* Sidebar panel content */
    .mw-sidebar .vector-menu-content {
      opacity: 1;
      transition: opacity 0.25s ease;
    }

    @starting-style {
      .mw-sidebar .vector-menu-content {
        opacity: 0;
      }
    }

    /* Dropdown menu content */
    .vector-dropdown-content {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .vector-dropdown-content {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* Sticky header TOC dropdown */
    .vector-sticky-header-toc .vector-dropdown-content {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    @starting-style {
      .vector-sticky-header-toc .vector-dropdown-content {
        opacity: 0;
        transform: translateY(-5px);
      }
    }

    /* Category tree collapsible children */
    .CategoryTreeChildren,
    .mw-categorytree-children {
      opacity: 1;
      transition: opacity 0.25s ease;
    }

    @starting-style {
      .CategoryTreeChildren,
      .mw-categorytree-children {
        opacity: 0;
      }
    }

    /* Navigation list items - staggered fade in */
    .vector-menu-content li {
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    @starting-style {
      .vector-menu-content li {
        opacity: 0;
      }
    }

    /* TOC list items */
    .toc li,
    .vector-toc li {
      opacity: 1;
      transition: opacity 0.15s ease;
    }

    @starting-style {
      .toc li,
      .vector-toc li {
        opacity: 0;
      }
    }

    /* Related pages panel */
    .related-pages {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    @starting-style {
      .related-pages {
        opacity: 0;
        transform: translateY(10px);
      }
    }

    /* Breadcrumbs */
    .breadcrumbs,
    .mw-category-breadcrumb {
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    @starting-style {
      .breadcrumbs,
      .mw-category-breadcrumb {
        opacity: 0;
      }
    }
  }
}

// =============================================================================
// TABLE OF CONTENTS ENHANCEMENTS
// =============================================================================

// Collapsible TOC with smooth animations
// Current section highlighting

.toc
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.02))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em

  // Number alignment with tabular-nums
  .tocnumber
    font-variant-numeric tabular-nums
    color $muted
    margin-inline-end 0.5em

  // Current section highlight
  .tocactive > a
    color $arch-blue
    font-weight 600
    background-color rgba($arch-blue, 0.1)
    border-radius $border-radius-sm
    padding 0.1em 0.3em

  // Smooth collapse animation
  ul
    overflow hidden
    transition height 0.3s ease, max-height 0.3s ease

// TOC sticky on scroll (for wide screens)
@media (min-width 1200px)
  .toc
    position sticky
    top 5em
    max-height calc(100vh - 6em)
    overflow-y auto
    scrollbar-gutter stable // Prevent layout shift when scrollbar appears


// =============================================================================
// RELATED PAGES SIDEBAR
// =============================================================================

// Related articles panel
// Browser support: 97%+

.related-pages
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.02))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em
  margin 1em 0

  h3
    color $lighter
    font-size 0.9em
    margin-bottom 0.5em
    border-bottom 1px solid $border-subtle
    padding-bottom 0.3em

  ul
    list-style none
    padding 0
    margin 0

  li
    margin 0.3em 0

  a
    color $secondary-blue
    text-decoration none
    display block
    padding 0.3em 0.5em
    border-radius $border-radius-sm
    transition all 0.2s ease

    &:hover
      background-color rgba($arch-blue, 0.1)
      color $arch-blue

// =============================================================================
// BREADCRUMB TRAIL
// =============================================================================

// Category path display
// Browser support: 97%+

.breadcrumbs
.mw-category-breadcrumb
  display flex
  flex-wrap wrap
  gap 0.3em
  align-items center
  padding 0.5em 0
  font-size 0.9em
  color $muted

  a
    color $secondary-blue
    text-decoration none

    &:hover
      color $arch-blue

  // Separator
  .breadcrumb-separator
    color $border-subtle
    margin 0 0.2em

    &::before
      content "›"

  // Current page
  .breadcrumb-current
    color $light
    font-weight 500

// =============================================================================
// CATEGORY TREE STYLING
// =============================================================================

// CategoryTree extension styling for expandable category trees
// Browser support: 97%+
// Used on category pages and in sidebar widgets

.CategoryTree
.mw-categorytree
  font-size 0.9em
  line-height 1.5

// Category tree item
.CategoryTreeItem
.mw-categorytree-item
  display flex
  align-items flex-start
  gap 0.4em
  padding 0.25em 0
  transition background-color $transition-fast

  &:hover
    background-color rgba($arch-blue, 0.05)
    border-radius $border-radius-sm

// Category tree toggle (expand/collapse button)
.CategoryTreeToggle
.mw-categorytree-toggle
  cursor pointer
  color $arch-blue
  font-size 0.85em
  padding 0.1em 0.3em
  border-radius $border-radius-sm
  transition all $transition-fast
  user-select none
  flex-shrink 0

  &:hover
    background-color rgba($arch-blue, 0.15)
    color $lighter

  &:active
    background-color rgba($arch-blue, 0.25)

// Expanded state indicator
.CategoryTreeToggle.expanded
.mw-categorytree-toggle.expanded
  &::before
    content "▼"
    font-size 0.75em

// Collapsed state indicator
.CategoryTreeToggle.collapsed
.mw-categorytree-toggle.collapsed
  &::before
    content "▶"
    font-size 0.75em

// Loading state
.CategoryTreeLoading
.mw-categorytree-loading
  color $muted
  font-style italic
  padding 0.25em 0.5em

  &::before
    content "◌ "
    animation spin 1s linear infinite

@keyframes spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

// Category tree children container
.CategoryTreeChildren
.mw-categorytree-children
  margin-inline-start 1.5em
  padding-inline-start 0.5em
  border-inline-start 1px dashed $border-subtle
  overflow hidden
  transition max-height 0.3s ease

// Empty children
.CategoryTreeChildren:empty
.mw-categorytree-children:empty
  display none

// Category link styling
.CategoryTreeLabel
.mw-categorytree-label
  a
    color $secondary-blue
    text-decoration none
    transition color $transition-fast

    &:hover
      color $arch-blue
      text-decoration underline

    &:visited
      color darken($secondary-blue, 10%)

// Page count badge
.CategoryTreePageCount
.mw-categorytree-count
  font-size 0.75em
  color $muted
  background-color rgba($arch-blue, 0.08)
  padding 0.1em 0.4em
  border-radius $border-radius-sm
  margin-inline-start 0.5em
  font-variant-numeric tabular-nums
  white-space nowrap

// Subcategory indicator
.CategoryTreeSubcat
.mw-categorytree-subcat
  &::before
    content "📁"
    font-size 0.85em
    margin-inline-end 0.3em
    opacity 0.7

// Page indicator
.CategoryTreePage
.mw-categorytree-page
  &::before
    content "📄"
    font-size 0.85em
    margin-inline-end 0.3em
    opacity 0.7

// Active category highlight
.CategoryTreeActive
.mw-categorytree-active
  > .CategoryTreeLabel a
  > .mw-categorytree-label a
    color $arch-blue
    font-weight 600
    background-color rgba($arch-blue, 0.1)
    padding 0.1em 0.3em
    border-radius $border-radius-sm

// Category tree section (used in sidebar widgets)
.CategoryTreeSection
.mw-categorytree-section
  margin 1em 0

  > h3
  > h4
    color $lighter
    font-size 0.9em
    font-weight 600
    margin-bottom 0.5em
    padding-bottom 0.3em
    border-bottom 1px solid $border-subtle

// Special:CategoryTree page
.mw-special-CategoryTree
  .mw-categorytree
    background linear-gradient(135deg, $base, rgba($arch-blue, 0.02))
    border 1px solid $border-subtle
    border-radius $border-radius-md
    padding 1em

// Root category styling
.CategoryTreeRoot
.mw-categorytree-root
  > .CategoryTreeItem
  > .mw-categorytree-item
    font-weight 500

    > .CategoryTreeLabel a
    > .mw-categorytree-label a
      color $lighter
      font-size 1em

// Depth indicators (visual nesting)
.CategoryTreeDepth1
  margin-inline-start 0

.CategoryTreeDepth2
  margin-inline-start 1.5em

.CategoryTreeDepth3
  margin-inline-start 3em

.CategoryTreeDepth4
  margin-inline-start 4.5em

.CategoryTreeDepth5
  margin-inline-start 6em

// Maximum depth styling (for very deep trees)
.CategoryTreeDepth6
.CategoryTreeDepth7
.CategoryTreeDepth8
  margin-inline-start 7em
  font-size 0.85em
  opacity 0.9

// Category tree in sidebar
#mw-panel
.mw-sidebar
  .CategoryTree
  .mw-categorytree
    font-size 0.85em
    padding 0.5em

    .CategoryTreeItem
    .mw-categorytree-item
      padding 0.15em 0

    .CategoryTreePageCount
    .mw-categorytree-count
      font-size 0.7em

// Focus states for accessibility
.CategoryTreeToggle:focus-visible
.mw-categorytree-toggle:focus-visible
  outline 2px solid $arch-blue
  outline-offset 2px

.CategoryTreeLabel a:focus-visible
.mw-categorytree-label a:focus-visible
  outline 2px solid $arch-blue
  outline-offset 2px
  border-radius 2px

// Reduced motion
@media (prefers-reduced-motion reduce)
  .CategoryTreeChildren
  .mw-categorytree-children
    transition none

  .CategoryTreeLoading::before
  .mw-categorytree-loading::before
    animation none

// High contrast mode
@media (forced-colors active)
  .CategoryTreeToggle
  .mw-categorytree-toggle
    forced-color-adjust none

  .CategoryTreePageCount
  .mw-categorytree-count
    border 1px solid CanvasText

// -----------------------------------------------------------------------------
// Gap in Flexbox
// Use gap instead of margins in flex containers for cleaner spacing between
// flex items. This is widely supported (97%+ browser support) and provides
// more predictable spacing than margins in flex layouts.

// Flex gap utilities - use instead of margin between flex items
.flex-gap-xs
  gap 0.25em

.flex-gap-sm
  gap 0.5em

.flex-gap-md
  gap 1em

.flex-gap-lg
  gap 1.5em

.flex-gap-xl
  gap 2em

// Row gap only
.flex-row-gap-xs
  row-gap 0.25em

.flex-row-gap-sm
  row-gap 0.5em

.flex-row-gap-md
  row-gap 1em

// Column gap only
.flex-col-gap-xs
  column-gap 0.25em

.flex-col-gap-sm
  column-gap 0.5em

.flex-col-gap-md
  column-gap 1em

// Apply gap to key flex containers in navigation
// Arch navbar
#archnavbar
  gap 0.5em

// TOC list items
.toc li
  // gap replaces margin for cleaner spacing
  gap 0.25em

// Vector TOC landmarks
.vector-toc-landmark
  gap 0.5em

.vector-page-titlebar-toc
  gap 0.25em

// Search form flex container
.cdx-search-input
.cdx-search-input--has-end-button
  gap 0.25em

// Menu toggle buttons
.vector-main-menu-pagination-container
  gap 0.5em

// Dropdown content flex containers
.vector-dropdown-content
  gap 0

// User menu items
.vector-user-menu
  gap 0.25em

// Language selector dropdown
.vector-languageSelector-dropdown
  gap 0.5em

// Pinnable header
.vector-pinnable-header
  gap 0.5em

// Sidebar portal content
.mw-portlet
  gap 0

// Footer links
#footer
  gap 1em

// ===========================================
// Scroll Markers (New - 2026-03-15)
// File: navigation.styl
// Style scroll position markers like carousel pagination dots
// Browser support: 85%+
// Note: Wrap in @css{} for Stylus
// ===========================================

@css
  // Base scroll marker container styling
  .scroll-marker-group
    display flex
    gap 8px
    justify-content center
    padding 16px 0


  // Scroll marker individual dot styling
  ::scroll-marker
    width 10px
    height 10px
    border-radius 50%
    background-color rgba(128, 128, 128, 0.4)
    transition background-color 0.3s ease, transform 0.3s ease


  // Active/current scroll marker
  ::scroll-marker:focus
  ::scroll-marker:active
  .scroll-marker-group:has(::scroll-marker:focus) ::scroll-marker
  .scroll-marker-group:has(::scroll-marker:active) ::scroll-marker
    background-color var(--accent, #7c4dff)
    transform scale(1.2)


  // Scroll marker group focus within
  ::scroll-marker-group:has(::scroll-marker:focus) ::scroll-marker
    opacity 0.6


  // Hover state for scroll markers
  @media (hover hover)
    ::scroll-marker:hover
      background-color rgba(128, 128, 128, 0.7)
      transform scale(1.1)
      cursor pointer



  // Reduced motion support
  @media (prefers-reduced-motion reduce)
    ::scroll-marker
      transition none

    ::scroll-marker:hover
    ::scroll-marker:focus
    ::scroll-marker:active
      transform none



  // Vertical scroll marker group
  .scroll-marker-group--vertical
    flex-direction column
    gap 12px


  // Horizontal scroll marker group (default)
  .scroll-marker-group--horizontal
    flex-direction row
    gap 8px


  // Custom scroll marker colors for different sections
  .scroll-marker-group--toc ::scroll-marker
    background-color rgba(124, 77, 255, 0.3)
    width 8px
    height 8px


  .scroll-marker-group--toc ::scroll-marker:focus
  .scroll-marker-group--toc ::scroll-marker:active
    background-color var(--accent, #7c4dff)


  .scroll-marker-group--gallery ::scroll-marker
    background-color rgba(255, 255, 255, 0.4)
    width 12px
    height 12px


  .scroll-marker-group--gallery ::scroll-marker:focus
  .scroll-marker-group--gallery ::scroll-marker:active
    background-color #fff


// =============================================================================
// SCROLL START/END PROPERTIES
// =============================================================================
// Define scroll snap boundaries with scroll-start and scroll-end
// Browser support: 85%+
// Note: Wrap in @supports for Stylus

@supports (scroll-start: 0px)
  // Scroll start - beginning of scrollable area
  .scroll-snap-start
    scroll-snap-align start

  // Scroll end - end of scrollable area
  .scroll-snap-boundaries
    scroll-padding-block-start 0px
    scroll-padding-block-end 100%

  // Container with explicit scroll boundaries
  .scroll-boundary-container
    scroll-padding-block-start 10%
    scroll-padding-block-end 90%

  // Element that should snap to start when scrolling forward
  .scroll-snap-proximity
    scroll-snap-type y proximity

  // Force scroll to start on load
  .scroll-to-start
    scroll-padding-block-start 0px

  // Force scroll to end on load
  .scroll-to-end
    scroll-padding-block-start 100%

  // View-based scroll timeline (alternative to scroll())
  @supports (animation-timeline: view())
    .animate-on-entry
      animation-timeline view()
      animation-range entry 0% cover 50%

    .animate-on-exit
      animation-timeline view()
      animation-range cover 50% exit 100%

    .animate-on-cross
      animation-timeline view()
      animation-range cross 0% cross 100%


// =============================================================================
// SNAPPED-X / SNAPPED-Y PSEUDO-CLASSES
// =============================================================================
// Style axis-specific snapped items for scroll snap containers
// Browser support: 85%+ (Chrome 114+, Firefox 109+)
// Note: Wrap in @css{} for Stylus

@css {
  /* Horizontal scroll snap - style items snapped on x-axis */
  :snapped-x {
    outline: 2px solid var(--accent-color, #7c3aed);
    outline-offset: 2px;
  }

  /* Vertical scroll snap - style items snapped on y-axis */
  :snapped-y {
    outline: 2px solid var(--accent-color, #7c3aed);
    outline-offset: 2px;
  }

  /* Combined snapped states */
  :snapped-x:snapped-y {
    outline-color: var(--success-color, #10b981);
  }

  /* Non-snapped items in snap container */
  scroll-snap-container :not(:snapped-x):not(:snapped-y) {
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  /* Highlight snapped item with transform */
  :snapped-x {
    transform: scale(1.02);
  }

  :snapped-y {
    transform: scale(1.02);
  }
}

// Utility classes for applying snapped pseudo-class behavior
// These work without @css{} by using scroll-snap-align directly

.scroll-snap-item-snapped
  &.snapped
    scroll-snap-align center
    background-color rgba(124, 58, 237, 0.1)

  &.snapped-x
    scroll-snap-align center

  &.snapped-y
    scroll-snap-align center

// Indicator showing current snap position
.snap-indicator
  position absolute

  &.snap-x
    left 50%
    transform translateX(-50%)
    width 40px
    height 3px
    background var(--accent-color, #7c3aed)
    border-radius 2px

  &.snap-y
    top 50%
    transform translateY(-50%)
    width 3px
    height 40px
    background var(--accent-color, #7c3aed)
    border-radius 2px


// =============================================================================
// BACKDROP FILTER BRIGHTNESS - Backdrop Brightness Adjustment
// =============================================================================
// Adjust backdrop brightness without blur for performance-conscious designs
// Browser support: 97%+
// Note: Requires @supports wrapper for Stylus compatibility

@supports (backdrop-filter: brightness(1.2))
  // Brighten backdrop (lighten background behind element)
  .backdrop-brightness-light
    backdrop-filter brightness(1.2)
    -webkit-backdrop-filter brightness(1.2)

  .backdrop-brightness-lighter
    backdrop-filter brightness(1.4)
    -webkit-backdrop-filter brightness(1.4)

  .backdrop-brightness-lightest
    backdrop-filter brightness(1.6)
    -webkit-backdrop-filter brightness(1.6)

  // Darken backdrop (darken background behind element)
  .backdrop-brightness-dark
    backdrop-filter brightness(0.8)
    -webkit-backdrop-filter brightness(0.8)

  .backdrop-brightness-darker
    backdrop-filter brightness(0.6)
    -webkit-backdrop-filter brightness(0.6)

  .backdrop-brightness-darkest
    backdrop-filter brightness(0.4)
    -webkit-backdrop-filter brightness(0.4)

  // Custom brightness levels
  .backdrop-brightness-120
    backdrop-filter brightness(1.2)
    -webkit-backdrop-filter brightness(1.2)

  .backdrop-brightness-150
    backdrop-filter brightness(1.5)
    -webkit-backdrop-filter brightness(1.5)

  .backdrop-brightness-200
    backdrop-filter brightness(2)
    -webkit-backdrop-filter brightness(2)

  .backdrop-brightness-50
    backdrop-filter brightness(0.5)
    -webkit-backdrop-filter brightness(0.5)

  .backdrop-brightness-75
    backdrop-filter brightness(0.75)
    -webkit-backdrop-filter brightness(0.75)


// =============================================================================
// BACKDROP FILTER SATURATE - Backdrop Saturation Adjustment
// =============================================================================
// Adjust backdrop saturation without blur for vibrant overlay effects
// Browser support: 97%+
// Note: Requires @supports wrapper for Stylus compatibility

@supports (backdrop-filter: saturate(1.5))
  // Increase saturation (more vibrant colors behind element)
  .backdrop-saturate-high
    backdrop-filter saturate(1.5)
    -webkit-backdrop-filter saturate(1.5)

  .backdrop-saturate-higher
    backdrop-filter saturate(2)
    -webkit-backdrop-filter saturate(2)

  .backdrop-saturate-highest
    backdrop-filter saturate(2.5)
    -webkit-backdrop-filter saturate(2.5)

  // Decrease saturation (desaturate/dull colors behind element)
  .backdrop-saturate-low
    backdrop-filter saturate(0.8)
    -webkit-backdrop-filter saturate(0.8)

  .backdrop-saturate-lower
    backdrop-filter saturate(0.5)
    -webkit-backdrop-filter saturate(0.5)

  .backdrop-saturate-lowest
    backdrop-filter saturate(0.25)
    -webkit-backdrop-filter saturate(0.25)

  // Remove saturation (grayscale behind element)
  .backdrop-saturate-none
    backdrop-filter saturate(0)
    -webkit-backdrop-filter saturate(0)

  // Custom saturation levels
  .backdrop-saturate-150
    backdrop-filter saturate(1.5)
    -webkit-backdrop-filter saturate(1.5)

  .backdrop-saturate-180
    backdrop-filter saturate(1.8)
    -webkit-backdrop-filter saturate(1.8)

  .backdrop-saturate-200
    backdrop-filter saturate(2)
    -webkit-backdrop-filter saturate(2)


// =============================================================================
// BACKDROP FILTER BRIGHTNESS + SATURATE COMBINED
// =============================================================================
// Combined brightness and saturate for enhanced visual effects

@supports (backdrop-filter: brightness(1.2) saturate(1.5))
  // Bright and vibrant backdrop
  .backdrop-bright-vibrant
    backdrop-filter brightness(1.2) saturate(1.5)
    -webkit-backdrop-filter brightness(1.2) saturate(1.5)

  // Dark and vibrant backdrop
  .backdrop-dark-vibrant
    backdrop-filter brightness(0.7) saturate(1.8)
    -webkit-backdrop-filter brightness(0.7) saturate(1.8)

  // Light and muted backdrop
  .backdrop-light-muted
    backdrop-filter brightness(1.1) saturate(0.7)
    -webkit-backdrop-filter brightness(1.1) saturate(0.7)

  // Dark and muted backdrop
  .backdrop-dark-muted
    backdrop-filter brightness(0.6) saturate(0.6)
    -webkit-backdrop-filter brightness(0.6) saturate(0.6)

  // Frosted glass effect with brightness and saturation
  .backdrop-frosted-bright
    backdrop-filter blur(8px) brightness(1.1) saturate(1.3)
    -webkit-backdrop-filter blur(8px) brightness(1.1) saturate(1.3)

  // High contrast frosted glass
  .backdrop-frosted-contrast
    backdrop-filter blur(10px) brightness(1.15) saturate(1.4)
    -webkit-backdrop-filter blur(10px) brightness(1.15) saturate(1.4)

// =============================================================================
// INTEREST PSEUDO-CLASSES (:interest-source, :interest-target)
// Browser support: 85%+ (Chrome 123+, Firefox not yet supported)
// =============================================================================
// :interest-source - targets an element receiving user interest (hover/focus)
// :interest-target - targets an element that is the target of an interest source
// These enable enhanced dropdown menu interactions and progressive disclosure

// Note: Wrap in @supports for browser compatibility - using @css{} for Stylus
// stylelint-disable stylus/at-rule-no-unknown,selector-pseudo-class-no-unknown
@css {
  @supports selector(:interest-source) {
    .vector-dropdown-content .vector-menu-content {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, visibility 0.2s, transform 0.2s ease;
    }

    .vector-dropdown-content:interest-source .vector-menu-content {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .vector-menu-content li:interest-source {
      background: rgba(#c7b8ff, 0.15);
    }

    .mw-parser-output a.external,
    .mw-parser-output .link {
      position: relative;
    }

    .mw-parser-output a.external::after,
    .mw-parser-output .link::after {
      content: attr(title);
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      padding: 0.5em 0.75em;
      background: #202020;
      border: 1px solid rgba(#c7b8ff, 0.3);
      border-radius: 4px;
      font-size: 0.875em;
      white-space: nowrap;
      z-index: 1000;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    .mw-parser-output a.external:interest-source::after,
    .mw-parser-output .link:interest-source::after,
    .mw-parser-output a.external:interest-target::after,
    .mw-parser-output .link:interest-target::after {
      opacity: 1;
    }

    .mw-collapsible .mw-collapsible-content {
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transition: opacity 0.25s ease, max-height 0.25s ease;
    }

    .mw-related-summary .related-links {
      opacity: 0.5;
      transition: opacity 0.2s ease;
    }

    .mw-related-summary:interest-source .related-links {
      opacity: 1;
    }

    .mw-headline-number {
      opacity: 0.3;
      transition: opacity 0.15s ease;
    }

    .mw-headline-number:interest-source {
      opacity: 1;
      color: #c7b8ff;
    }

    .mw-ui-input:interest-source {
      border-color: rgba(108, 92, 231, 0.6);
      box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.15);
    }
  }
}
// stylelint-enable

// Mobile touch-friendly alternatives
// Since :interest-source isn't well supported on mobile, use hover as fallback
@media (pointer coarse)
  .vector-dropdown-content .vector-menu-content
    opacity 1
    visibility visible
    transform none
    transition none



