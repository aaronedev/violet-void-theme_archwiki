@import '../variables/colors'
@import '../variables/layout'
@import '../mixins/effects'
@import '../mixins/menus'

// Arch navigation bar
#archnavbar
  height 40px !important
  padding 10px 15px !important
  background $base !important
  border-bottom 5px $arch-blue solid !important
  display flex
  align-items center

// Sidebar (article table of contents and misc side panels)
.mw-sidebar
  background linear-gradient(180deg, $dark, $darker)
  border-radius $border-radius-md
  box-shadow $shadow-subtle
  padding 1em
  border 1px solid $border-subtle

// Global main menu (Vector menu shown when the hamburger button is opened)
// This styles the left-hand site navigation so it fits the dark, violet-toned header.
#vector-main-menu,
.vector-main-menu
  // Subtle gradient from the base colour towards a hint of Arch blue
  menu-panel()

  // Section headings within the main menu
  .vector-menu-heading
    menu-heading()

  // Individual menu items
  .vector-menu-content li
    menu-list-item()

// Portal headings
.vector-menu-portal .vector-menu-heading
  menu-heading()

  display block

// Portal content
.vector-menu-portal .vector-menu-content li
  menu-list-item()

// Table of contents
#toc,
.toc
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 1em
  box-shadow $shadow-subtle
  transition all $transition-medium

  &:hover
    box-shadow $shadow-elevated
    border-color rgba($arch-blue, 0.2)

// Page title bar table of contents button alignment
.vector-toc-landmark
  display flex
  align-items center

.vector-page-titlebar-toc
  display flex
  align-items center
  margin 0

  .vector-dropdown-label
    display inline-flex
    align-items center
    justify-content center
    line-height 1

.tocnumber
  color $secondary-blue
  font-weight 600
  margin-right 0.5em

// TOC toggle
.toctogglelabel
  color $secondary-blue
  font-size 0.9em
  cursor pointer

  &:hover
    color $orange

// -----------------------------------------------------------------------------
// Dropdown menu styling (Vector main menu)
// The Vector skin on ArchWiki uses a white dropdown container for the main
// navigation menu and applies its own backgrounds to nested elements like
// `.vector-menu-content` and `.mw-portlet`.  To ensure the Violet‑Void theme
// colours flow seamlessly through the entire panel, we override these
// backgrounds and apply our dark gradient, violet accents and consistent
// typography.  High specificity selectors are used to win against upstream
// styles without resorting to excessive `!important` flags.

// Outer wrapper for dropdown menus (e.g. the main menu opened via the
// hamburger button).  Apply the theme’s gradient, rounded corners and shadow.
.vector-dropdown-content
  menu-panel()

  // Ensure nested blocks don’t introduce their own light backgrounds.  The
  // `>` selector combined with class names targets immediate children as well
  // as deeper nested containers used by Vector’s layout (like
  // `.vector-main-menu`, `.vector-unpinned-container`, `.mw-portlet` and the
  // pinnable header bar).
  > *,
  .vector-main-menu,
  .vector-unpinned-container,
  .mw-portlet,
  .vector-pinnable-header,
  .vector-menu-content
    background-color transparent
    border 0
    box-shadow none

  // Style the pinnable header bar (“Main menu” label and pin/unpin buttons)
  .vector-pinnable-header
    pinnable-header()

  // Section headings within dropdowns
  .vector-menu-heading
    menu-heading()

  // List items in dropdown menus
  .vector-menu-content li
    menu-list-item(true)

// -----------------------------------------------------------------------------
// Pinned sidebar menu styling
// When the main menu is pinned to the sidebar, Vector inserts it into a
// `.vector-pinned-container` within a sticky wrapper.  The default styles
// assign a white background and fade-out overlay to this container.  These
// overrides apply our Violet‑Void gradient and remove the unwanted white
// backdrop, ensuring the pinned menu matches the dropdown styling.

// Apply dark gradient, border and shadow to pinned containers
.vector-pinned-container
  menu-panel()

// Keep the sticky wrapper neutral so empty containers do not render a panel
.vector-sticky-pinned-container
  background-color transparent
  border 0
  box-shadow none
  padding 0

// Remove the white fade overlay at the bottom of sticky pinned containers
.vector-sticky-pinned-container::after
  display none

// Remove default backgrounds from nested elements inside pinned menus
.vector-pinnable-element,
.vector-pinnable-element .vector-menu-content,
.vector-pinnable-element .mw-portlet,
.vector-pinnable-header
  background-color transparent
  border 0
  box-shadow none

// Style the pinnable header (appears in both pinned and dropdown menus)
.vector-pinnable-header
  pinnable-header()

// Headings within pinned menus
.vector-pinnable-element .vector-menu-heading
  menu-heading()

// Menu items within pinned menus
.vector-pinnable-element .vector-menu-content li
  menu-list-item(true)

// -----------------------------------------------------------------------------
// Vector header styling
// The page header in the Vector skin uses a very dark hue (#050A10) that
// clashes with the Violet‑Void palette.  These rules set the header and its
// container to our theme’s dark gradient and ensure the border aligns with
// other components.  Only key structural elements are targeted to avoid
// unintended overrides.

.vector-header-container,
.vector-header,
.vector-header-start,
.vector-header-end,
header.vector-header
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border-bottom 1px solid $border-subtle

// -----------------------------------------------------------------------------
// FIX: Header icon links get a fake underline (background gradient) from global
// link styling (content.styl) and it visually cuts through icons (bell, etc.).
// Kill that underline ONLY in the header area (keep it everywhere else).

.vector-header a,
.vector-header a:visited
  // Disable gradient-underline background used by the global link styling
  background-image none !important
  background-size auto !important
  background-repeat initial !important
  background-position initial !important
  text-decoration none !important

  &:hover
    background-image none !important
    text-decoration none !important

// Make header icons immune to text-decoration metrics and center them properly
.vector-header .vector-icon,
.vector-header .mw-ui-icon
  display inline-flex
  align-items center
  justify-content center
  vertical-align middle

// -----------------------------------------------------------------------------
// Sticky header styling (appears when scrolling)
// The sticky header inherits default Vector styles which include plain blue
// buttons and light backgrounds.  These rules re-theme the sticky header to
// match the Violet‑Void palette.  They apply a dark gradient to the header
// container, style the search bar and its toggle, and refine icons and the
// sticky table‑of‑contents dropdown.

// Header container and inner wrapper
.vector-sticky-header-container,
.vector-sticky-header
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border-bottom 1px solid $border-subtle
  box-shadow $shadow-subtle

// Buttons and icons within the sticky header (search toggle, discussion/history
// icons, user menu, etc.)
.vector-sticky-header .cdx-button
  background-color $darker
  border 1px solid $border-subtle
  color $light
  border-radius $border-radius-sm
  padding 0.25em 0.5em
  font-size 0.85em
  line-height 1

  &:hover
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue

// Search input inside the sticky header
#vector-sticky-search-form .cdx-search-input__input-wrapper input,
#vector-sticky-search-form .cdx-text-input__input
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.4em 0.6em

// Search submit button inside the sticky header
#vector-sticky-search-form .cdx-button.cdx-search-input__end-button
  background-color $arch-blue
  color $darker
  border 1px solid $arch-blue
  border-radius $border-radius-md
  padding 0.4em 0.8em
  font-size 0.85em

  &:hover
    background-color lighten($arch-blue, 10%)
    color $darker

// Sticky header table of contents dropdown styling
.vector-sticky-header-toc .vector-dropdown-content
  menu-panel()

  width max-content

  // Transparent backgrounds for nested elements
  > *,
  .vector-pinnable-element,
  .vector-unpinned-container,
  .mw-portlet,
  .vector-pinnable-header,
  .vector-menu-content
    background-color transparent
    border 0
    box-shadow none

  // Pinned header inside sticky TOC
  .vector-pinnable-header
    pinnable-header()

  // Headings within the sticky TOC dropdown
  .vector-menu-heading
    menu-heading()

  // Menu items within the sticky TOC dropdown
  .vector-menu-content li
    menu-list-item(true)

// -----------------------------------------------------------------------------
// Sticky table of contents and context bar enhancements
// The Vector sticky header includes a context bar that displays the page title
// and a dropdown table of contents.  By default, these elements use plain
// colours that clash with the Violet‑Void palette (e.g. bright blue links and
// dark backdrops).  These overrides apply our dark gradient, lighten text and
// accent colours for active entries and hover states.  They also refine the
// toggle buttons used to expand/collapse TOC sections.

// Style the page title in the sticky context bar
.vector-sticky-header-context-bar-primary
  color $light
  font-weight 600
  font-size 1em
  padding 0.25em 0.5em

// General styling for table of contents lists (applies to sticky TOC and
// pinned/inline TOC).  Provide a dark background and consistent padding.
.vector-toc,
.vector-sticky-header-toc .vector-toc
  background linear-gradient(135deg, $base, rgba($arch-blue, 0.04))
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.5em 1em
  box-shadow $shadow-subtle

// Links inside the TOC
.vector-toc .vector-toc-link
  color $light
  display block
  padding 0.25em 0.5em
  border-radius $border-radius-sm
  text-decoration none

  &:hover
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue

// Highlight active section links in the TOC
.vector-toc .vector-toc-list-item-active > .vector-toc-link,
.vector-toc .vector-toc-level-1-active:not(.vector-toc-list-item-expanded) > .vector-toc-link,
.vector-toc .vector-toc-list-item-active.vector-toc-level-1-active > .vector-toc-link
  color $secondary-blue !important
  font-weight bold

// Text within TOC entries
.vector-toc .vector-toc-text
  color $lighter
  padding 0.25em 0

// TOC toggle buttons (expand/collapse arrows)
.vector-toc .vector-toc-toggle
  background-color $darker
  border 1px solid $border-subtle
  color $light
  border-radius $border-radius-sm
  min-width 20px
  min-height 20px
  display flex
  align-items center
  justify-content center
  cursor pointer

  &:hover
    background-color rgba($arch-blue, 0.1)
    color $secondary-blue

// Icon within toggle buttons
.vector-toc .vector-toc-toggle .vector-icon
  fill $light

// -----------------------------------------------------------------------------
// Site-wide search box and autocomplete results styling
// The ArchWiki search component uses Codex classes (`cdx-*`) to build its
// typeahead search boxes and result lists.  By default, these controls use
// generic light themes that contrast poorly with the Violet‑Void palette.
// These overrides restyle the search input, button and autocomplete menu to
// blend seamlessly into the dark interface and adopt neon violet accents.

// Wrapper around the search form
// Do not override structural layout (flex positioning) to avoid breaking
// the built-in positioning logic of the autocomplete menu.  Only apply
// colours and subtle borders.
#searchform,
.cdx-typeahead-search__form
  background-color transparent
  border none
  border-radius 0
  box-shadow none

// Search input container
.cdx-search-input,
.cdx-search-input--has-end-button
  background-color transparent
  border none
  border-radius 0

  // FIX: keep the default Codex layout (input + end button) intact
  // but make alignment predictable.
  display flex
  align-items center
  gap 0.5em

// Wrapper around the text input and menu
// IMPORTANT: keep `position: relative` (Codex uses it to anchor the menu).
// Do NOT turn this into a flex/grid container; that can mess with menu placement.
.cdx-search-input__input-wrapper
  position relative
  flex 1 1 auto
  min-width 0

// Text input with leading icon
// Do not alter the display of the text input container; only adjust colours.
.cdx-text-input
  // Keep it flexible so the input expands and the button stays close
  display flex
  align-items center
  flex 1 1 auto
  min-width 0
  background-color $darker
  border 1px solid $border-subtle
  border-radius $border-radius-md
  color $lighter

  // FIX: tighten vertical rhythm without breaking Codex sizing
  padding 0.35em 0.6em

.cdx-text-input .cdx-text-input__input
  flex 1 1 auto
  background-color transparent
  border none
  box-shadow none
  color $lighter
  font-size 0.95em
  line-height 1.2
  outline none

// Start icon inside the search input (magnifying glass)
.cdx-text-input__icon-vue.cdx-text-input__start-icon svg
  fill $secondary-blue

  // FIX: readable size + consistent alignment
  width 16px
  height 16px
  margin-right 0.5em
  flex 0 0 auto

// Search button at the end of the input
.cdx-search-input__end-button.cdx-button
  background-color $arch-blue
  color $darker
  border 1px solid $arch-blue
  border-radius $border-radius-md

  // FIX: stop giant button; keep it snug next to the input
  margin-left 0
  padding 0.5em 0.8em
  font-size 0.85em
  line-height 1
  white-space nowrap

  // Ensure it doesn't float away in flex layouts
  flex 0 0 auto

  &:hover
    background-color lighten($arch-blue, 10%)
    color $darker

// Autocomplete dropdown menu
.cdx-menu.cdx-typeahead-search__menu
  // Darker background for readability of search results.  Increase the
  // violet overlay to improve contrast.
  border 1px solid $border-subtle
  border-radius $border-radius-md
  box-shadow $shadow-subtle
  // Preserve default positioning and sizing of the autocomplete menu.  Only
  // set colours and borders; do not adjust margin or scrolling, as doing
  // so can cause the menu to render in the wrong place.
  padding 0

.cdx-menu__listbox
  list-style none
  margin 0
  padding 0

  li.cdx-menu-item
    margin 0
    padding 0

    // The anchor that forms each result entry
    .cdx-menu-item__content
      display flex
      flex-direction row
      align-items center
      color $light
      padding 0.5em 0.75em
      border-radius $border-radius-sm
      text-decoration none

      &:hover
        background-color rgba($arch-blue, 0.1)
        color $secondary-blue

      // Thumbnail (placeholder icon) for search result
      .cdx-thumbnail,
      .cdx-menu-item__thumbnail
        margin-right 0.5em

        .cdx-icon svg
          fill $secondary-blue

      // Label text
      .cdx-menu-item__text__label
        color $lighter

    // Footer item (search for full text)
    &.cdx-typeahead-search__search-footer
      border-top 1px solid $border-subtle
      margin-top 0
      padding-top 0.5em

      .cdx-typeahead-search__search-footer__icon .cdx-icon svg
        fill $secondary-blue

      .cdx-typeahead-search__search-footer__text
        color $lighter

        strong.cdx-typeahead-search__search-footer__query
          color $secondary-blue
