@import '../variables/colors'
@import '../variables/layout'

// Wiki tables
.wikitable
  background-color $base
  color $light
  margin 1em 0
  border none
  border-radius $border-radius-md
  overflow hidden
  box-shadow $shadow-subtle
  border-collapse separate
  border-spacing 0
  width 100% // Ensure full width responsiveness

  > tr > th,
  > * > tr > th
    background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04))
    text-align left // Better readability
    font-weight 600
    letter-spacing 0.02em
    color $lighter
    padding 1em

  > tr > th,
  > tr > td,
  > * > tr > th,
  > * > tr > td
    border 1px solid $border-subtle
    padding 0.75em 1em
    transition background-color $transition-fast

  tr:nth-child(even)
    background-color rgba(255, 255, 255, 0.01) // Zebra striping

  tr:hover td
    background-color rgba($arch-blue, 0.05)
