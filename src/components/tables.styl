@import '../variables/colors'
@import '../variables/layout'

// Wiki tables
.wikitable
  background-color $base
  color $light
  margin 1em 0
  border none
  border-radius $border-radius-md
  overflow hidden
  box-shadow $shadow-subtle
  border-collapse separate
  border-spacing 0
  width 100% // Ensure full width responsiveness
  table-layout auto

  > tr > th
  > * > tr > th
    background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04))
    text-align left // Better readability
    font-weight 600
    font-size 0.9em
    letter-spacing 0.02em
    color $lighter
    padding 0.6em 0.75em

  > tr > th
  > tr > td
  > * > tr > th
  > * > tr > td
    border 1px solid $border-subtle
    padding 0.5em 0.7em
    font-size 0.9em
    transition background-color $transition-fast
    word-break normal
    overflow-wrap normal
    white-space normal

  tr:nth-child(even)
    background-color rgba(255, 255, 255, 0.01) // Zebra striping

  tr:hover td
    background-color rgba($arch-blue, 0.05)

// Infobox tables
.infobox
  background-color $base
  color $light
  margin 1em 0
  border 1px solid $border-subtle
  border-radius $border-radius-md
  overflow hidden
  box-shadow $shadow-subtle
  border-collapse separate
  border-spacing 0
  width 100%
  max-width 100%

  th
    background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04))
    text-align left
    font-weight 600
    font-size 0.9em
    letter-spacing 0.02em
    color $lighter
    padding 0.6em 0.75em

  th
  td
    border 1px solid $border-subtle
    padding 0.5em 0.7em
    font-size 0.9em
    vertical-align top

  caption
    padding 0.5em 0.75em
    font-size 0.9em
    color $lighter
    text-align left

  img
    max-width 100%
    height auto
    display block
    border-radius $border-radius-sm

// Generic tables used by the Arch Linux security tracker
// Use table.styled-table to increase specificity over site defaults
table.styled-table
  background-color $base !important
  color $light !important
  margin 1em 0
  border none !important
  border-radius $border-radius-md
  overflow hidden
  box-shadow $shadow-subtle
  border-collapse separate
  border-spacing 0
  width 100%

  // Header styling
  th
    background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04)) !important
    text-align left
    font-weight 600
    font-size 0.9em
    letter-spacing 0.02em
    color $lighter !important
    padding 0.6em 0.75em

  // Cell styling
  th
  td
    border 1px solid $border-subtle !important
    padding 0.5em 0.7em
    font-size 0.9em
    transition background-color $transition-fast

  // Zebra striping
  tbody tr:nth-child(even)
    background-color rgba(255, 255, 255, 0.01)

  // Row hover effect
  tbody tr:hover td
    background-color rgba($arch-blue, 0.05)

  // Override upstream row backgrounds and hover effects.  The default
  // Arch security stylesheet sets `table tr:hover` to a pale gray and
  // applies alternating row backgrounds via `.styled-table` defaults.
  // These rules apply to all rows, including headers, so use the `tr`
  // element directly and include `!important` to ensure our theme
  // colours prevail.  Header rows will still pick up our gradient via
  // the `th` definition above, but on hover they’ll get a subtle
  // violet tint instead of a white flash.
  tr:nth-child(even)
    background-color rgba(255, 255, 255, 0.01) !important

  tr:nth-child(odd)
    background-color transparent !important

  tr:hover
  tr:hover td
    background-color rgba($arch-blue, 0.06) !important

  // Center alignment helper
  .center
    text-align center

// Colour-coded statuses used on the security tracker
span.purple
  color $arch-blue !important

span.orange
  color $orange !important

span.light_orange
  color lighten($orange, 20%) !important

span.green
  color $green !important

span.red
  color $secondary-red !important

// -----------------------------------------------------------------------------
// AUR (archlinux.org) custom styling
// The Arch User Repository (AUR) web interface uses generic `.box` and `.widget`
// containers for content blocks and sidebars. These default to light
// backgrounds in the upstream CSS, which clashes badly with the dark violet
// palette of the Violet‑Void theme. The rules below re‑theme those boxes,
// headlines and tables to match the rest of the dark ArchWiki skin. A high
// specificity selector (`#content-left-wrapper .box`, etc.) is used alongside
// the base class selectors to ensure our styles override the site defaults. The
// `!important` flags are applied sparingly where the upstream CSS declares
// strong colours.

// General box and widget styling
#content-left-wrapper .box
#content-left .box
#content-right .widget
#content-right .box
.box
.widget
  background-color $base !important
  border 1px solid $border-subtle !important
  border-radius $border-radius-md
  color $light
  box-shadow $shadow-subtle
  padding 0.75em

// Headings within the AUR news sections
#news h3
#news h4
  color $lighter
  font-weight 600

// Article content blocks in the news area
#news .article-content
  margin 0.5em 0
  padding 0.5em 1em
  background-color rgba($arch-blue, 0.02)
  border-left 3px solid $secondary-blue
  border-radius $border-radius-md

// Package search label and input styling
#pkgsearch label
  color $lighter

#pkgsearch input[type="text"]
  background-color $darker
  color $lighter
  border 1px solid $border-subtle
  border-radius $border-radius-md
  padding 0.5em

// Recent updates table styling in the sidebar
#pkg-updates table
  width 100%
  border-collapse collapse

#pkg-updates table tr
  border-bottom 1px solid $border-subtle

#pkg-updates table tr:hover
  background-color rgba($arch-blue, 0.05)

#pkg-updates table td
  padding 0.25em 0.5em
  color $light

#pkg-updates table td.pkg-date
  color $secondary-blue
  text-align right
  white-space nowrap

// Ensure that cells with the `.wrap` class (used on Archweb for long
// descriptions) inherit the row’s background and text colour. Without this,
// these cells default to a light background and dark text.
table.results td.wrap
#pkglist-results table td.wrap
  background-color inherit !important
  color $light !important

// -----------------------------------------------------------------------------
// Arch Packages search page styling (archlinux.org/packages)
// The official Arch package database uses a `table.results` inside the search
// results listing. Without overrides, these tables have a light background and
// borders that clash with our dark violet aesthetic. The rules below re-theme
// the results table and its header/cells to match the Violet‑Void palette. The
// selectors include both `.results` and `#pkglist-results table` to capture
// variations across templates. If additional specificity is needed, feel free
// to duplicate the selector with the page’s parent container.

table.results
#pkglist-results table
  background-color $base !important
  color $light !important
  border none !important
  border-radius $border-radius-md
  overflow hidden
  box-shadow $shadow-subtle
  border-collapse separate
  border-spacing 0
  width 100%

  // Header cells (both <th> and <td> in case the template uses <td> in the header)
  thead
    th
    td
      background linear-gradient(135deg, $darker, rgba($arch-blue, 0.04)) !important
    color $lighter !important
    font-weight 600
    border 1px solid $border-subtle !important
    padding 0.75em 1em

  tbody td
    border 1px solid $border-subtle !important
    padding 0.5em 1em

  tbody tr:nth-child(even)
    // Apply a subtle zebra striping. Use !important on the cell to override
    // upstream .wrap backgrounds defined in Archweb.
    background-color rgba(255, 255, 255, 0.01)

  // Override row striping at the cell level to ensure `.wrap` cells inherit
  // the same background instead of the upstream light colour. Without this,
  // the description column remains light due to its `.wrap` class.
  tbody tr:nth-child(even) td
    background-color rgba(255, 255, 255, 0.01) !important

  tbody tr:nth-child(odd) td
    background-color transparent !important

  tbody tr:hover td
    background-color rgba($arch-blue, 0.05)

  // Override ArchWeb’s row striping and hover rules.  The upstream stylesheet
  // uses `nth-child(even of :not([hidden]))` on `<tr>` elements to apply
  // light backgrounds (#e4eeff/#fff) and `#pkglist-results tr:hover` to
  // highlight rows in yellow.  These rules leak through to our dark theme
  // because they operate at the row level rather than individual cells.  To
  // neutralize them, explicitly set the row background colours here with
  // `!important`, including a fallback without the `of` syntax for older
  // browsers.  Then override the hover background to our subtle blue tint.
  tr:nth-child(even of :not([hidden]))
  tr:nth-child(even)
    background-color rgba(255, 255, 255, 0.01) !important

  tr:nth-child(odd of :not([hidden]))
  tr:nth-child(odd)
    background-color transparent !important

  tr:hover
  tr:hover td
    background-color rgba($arch-blue, 0.05) !important

  // Colour for flagged versions in the package list.  Upstream uses plain red,
  // but we align it with the theme’s secondary red accent.
  .flagged
    color $secondary-red !important

// -----------------------------------------------------------------------------
// Package search form elements (Arch package database)
// The default ArchWeb styles leave the multi-select lists for architecture,
// repository and other criteria with a white background.  When applying our
// dark theme those lists inherit the browser’s dark styling which makes the
// options hard to distinguish.  The rules below explicitly style these
// `<select>` elements and their `<option>` children so they integrate with
// the Violet‑Void palette while maintaining contrast.  A subtle blue tint
// indicates selected options.  Use high specificity selectors tied to
// `#pkglist-search` to avoid affecting other select boxes across the wiki.

#pkglist-search select
#pkglist-search select[multiple]
  background-color $darker !important
  color $lighter !important
  border 1px solid $border-subtle !important
  border-radius $border-radius-md
  padding 0.4em

#pkglist-search select option
  background-color $darker !important
  color $lighter !important

#pkglist-search select option:hover
#pkglist-search select option:checked
  background-color rgba($arch-blue, 0.2) !important
  color $lighter !important

// =============================================================================
// HYPHENATION FOR NARROW COLUMNS
// =============================================================================

// Better text wrapping in infoboxes and narrow table cells
// Browser support: 95%+
.infobox
.wikitable
  th
  td
    // Enable hyphenation with lang attribute support
    hyphens auto
    // Ensure proper word breaking for long content
    overflow-wrap break-word

// Narrow table cells benefit from hyphenation
.wikitable
  td
    max-width 300px
    hyphens auto

// =============================================================================
// FONT-VARIANT-NUMERIC FOR TABLE NUMBERS
// =============================================================================

// Tabular numbers for better alignment in tables
// Browser support: 97%+

// Apply tabular-nums to wikitable and infobox cells
.wikitable
.infobox
  // Numeric columns benefit from fixed-width digits
  td
    font-variant-numeric tabular-nums

  // Header cells also get tabular numbers for consistency
  th
    font-variant-numeric tabular-nums

// Sortable tables - numbers should align
table.sortable
  td
  th
    font-variant-numeric tabular-nums

// Tables with counts, dates, versions - use tabular-nums
.mw-parser-output
  table
    td
      font-variant-numeric tabular-nums

// =============================================================================
// TABLE ENHANCEMENTS
// =============================================================================

// Empty cells visibility control
// Browser support: 97%+
.wikitable
.infobox
  empty-cells show

// Hide empty cells for cleaner tables
.hide-empty-cells
  empty-cells hide

// Caption position control
// Browser support: 97%+
.wikitable
.infobox
  caption
    caption-side top
    text-align left
    padding 0.5em 0.75em
    color $lighter
    font-weight 600

// Bottom caption variant
.caption-bottom
  caption-side bottom
    text-align center
    color $muted
    font-size 0.85em

