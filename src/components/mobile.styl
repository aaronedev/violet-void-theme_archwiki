// Mobile Touch-Friendly Enhancements
// Styling for touch devices and mobile editing interface
// Browser support: 97%+ for touch-action, 44px touch targets

@import '../variables/colors'
@import '../variables/layout'

// =============================================================================
// TOUCH-FRIENDLY EDIT CONTROLS
// =============================================================================

// Minimum touch target size (44x44px as per WCAG guidelines)
$touch-target-min = 44px

// Edit form touch enhancements
.mw-editform
  // Larger touch targets for form elements on mobile
  input
  textarea
  select
    @media (pointer coarse)
      min-height $touch-target-min
      padding 0.75em 1em
      font-size 16px // Prevents iOS zoom on focus

  // Touch-friendly checkboxes and radios
  input[type="checkbox"]
  input[type="radio"]
    @media (pointer coarse)
      width 24px
      height 24px
      margin 0.5em

  // Larger submit buttons
  input[type="submit"]
  input[type="button"]
  button
    @media (pointer coarse)
      min-height $touch-target-min
      padding 0.75em 1.5em
      font-size 1rem

// Edit toolbar - touch-friendly
.mw-editTools
.editToolbar
#toolbar
  @media (pointer coarse)
    padding 0.75em

    button
    .mw-editbutton
      min-width $touch-target-min
      min-height $touch-target-min
      padding 0.5em
      font-size 1rem

// Textarea improvements for touch
#wpTextbox1
.mw-edit textarea
  @media (pointer coarse)
    min-height 300px
    line-height 1.8

// Edit summary - touch-friendly
#wpSummary
.mw-summary
  @media (pointer coarse)
    min-height $touch-target-min
    padding 0.75em 1em
    font-size 16px // Prevents iOS zoom

// =============================================================================
// TOUCH ACTION - PREVENT ACCIDENTAL ZOOM/PAN
// =============================================================================

// Allow manipulation (touch-action) for better touch UX
// Disables double-tap to zoom, allows panning and scrolling
#editform
.mw-editform
.mw-parser-output
  @media (pointer coarse)
    touch-action manipulation

// Form elements - prevent unwanted zoom on iOS
input
select
textarea
  @media (pointer coarse) and (max-width 768px)
    font-size 16px // iOS requires 16px+ to prevent auto-zoom on focus

// =============================================================================
// SWIPE GESTURE INDICATORS
// =============================================================================

// Visual feedback for swipe-capable elements
.swipeable
  position relative

  &::after
    content ''
    position absolute
    bottom 0.5em
    right 0.5em
    width 2em
    height 3px
    background linear-gradient(135deg, $arch-blue, rgba($arch-blue, 0.4))
    border-radius 2px
    opacity 0.6
    pointer-events none

    @media (pointer fine)
      display none // Hide on mouse devices

// Swipe hint for horizontal scroll containers
.horizontal-scroll
  position relative

  &::before
    content ''
    position absolute
    right 0
    top 0
    bottom 0
    width 30px
    background linear-gradient(to right, transparent, rgba($base, 0.8))
    pointer-events none
    opacity 0

    @media (pointer coarse)
      opacity 1

// =============================================================================
// MOBILE EDIT BUTTONS
// =============================================================================

// Mobile-specific edit button styling
#mw-editsection
  @media (pointer coarse)
    // Larger edit section links on touch devices
    a
      min-width $touch-target-min
      min-height $touch-target-min
      padding 0.5em 0.75em
      display inline-flex
      align-items center
      justify-content center

// Edit page buttons
.editButtons
  @media (pointer coarse)
    display flex
    flex-direction column
    gap 0.75em

    .mw-ui-button
      min-height $touch-target-min
      padding 0.75em 1.5em
      font-size 1rem

// =============================================================================
// TOUCH-FRIENDLY NAVIGATION IN EDIT MODE
// =============================================================================

// Page history controls
.mw-history-legend
  @media (pointer coarse)
    .mw-history-compareselectedversions
    .mw-history-suppress
      min-height $touch-target-min
      padding 0.5em 1em

// Diff controls
.diff-navigator
  @media (pointer coarse)
    .diff-next
    .diff-prev
      min-width $touch-target-min
      min-height $touch-target-min
      padding 0.5em

// =============================================================================
// SAFE AREA SUPPORT FOR NOTCHED DEVICES
// =============================================================================

// Safe area inset for modern mobile devices
@supports (padding: unquote("max(0px)"))
  // Respect notched devices
  .mw-body
  #content
  .mw-editform
    @media (max-width 768px)
      padding-left unquote("max(1em, env(safe-area-inset-left))")
      padding-right unquote("max(1em, env(safe-area-inset-right))")

  // Fixed bottom elements need bottom safe area
  .mw-footer
    @media (max-width 768px)
      padding-bottom unquote("max(0.5em, env(safe-area-inset-bottom))")

// =============================================================================
// MOBILE KEYBOARD SUPPORT
// =============================================================================

// Adjust layout when virtual keyboard is visible
@supports (padding: unquote("env(keyboard-inset-bottom)"))
  .mw-editform
    @media (max-width 768px)
      padding-bottom calc(1em + env(keyboard-inset-bottom))

// =============================================================================
// HORIZONTAL SCROLL ON TOUCH DEVICES
// =============================================================================

// Mobile table container - provides horizontal scroll with visual feedback
.table-scroll-wrapper
  @media (max-width 768px)
    overflow-x auto
    -webkit-overflow-scrolling touch
    scroll-behavior smooth
    position relative
    margin 1em 0

    // Fade indicators on scroll edges
    &::before
      content ''
      position absolute
      left 0
      top 0
      bottom 0
      width 15px
      background linear-gradient(to right, rgba($base, 0.7), transparent)
      pointer-events none
      z-index 1
      opacity 0

    &::after
      content ''
      position absolute
      right 0
      top 0
      bottom 0
      width 15px
      background linear-gradient(to left, rgba($base, 0.7), transparent)
      pointer-events none
      z-index 1
      opacity 0

    // Show indicators when there's overflow
    &.scrollable::after
      opacity 1

    @media (pointer coarse)
      // Always show right indicator on touch devices
      &::after
        opacity 1

// Smooth horizontal scrolling for code blocks and tables on touch
pre
code
.mw-code
  @media (pointer coarse)
    overflow-x auto
    -webkit-overflow-scrolling touch
    scroll-behavior smooth

// Tables on mobile - horizontal scroll with enhanced styling
table.wikitable
table.mwMetadata
table.mw-html-magic-mw-data-interface
  @media (max-width 768px)
    display block
    overflow-x auto
    -webkit-overflow-scrolling touch
    scroll-behavior smooth

    // Prevent layout breaks
    max-width 100vw
    width auto
    min-width 100%

// Sticky first column for horizontal scroll tables
// Helps users maintain context while scrolling
@supports (position: sticky)
  table.wikitable
  table.mwMetadata
  table.mw-html-magic-mw-data-interface
    @media (max-width 768px) and (pointer fine)
      // Set up the scroll container
      display block
      overflow-x auto
      scroll-behavior smooth
      position relative

      // Make first column sticky
      thead th:first-child
      tbody th:first-child
      td:first-child
        position sticky
        left 0
        z-index 2
        background $base

        // Add subtle border to separate from scrolling content
        &::after
          content ''
          position absolute
          right 0
          top 0
          bottom 0
          width 2px
          background $border-subtle

      // Header cells need higher z-index
      thead th:first-child
        z-index 3
        background $base-secondary

// Priority-based column hiding for very small screens
// Uses data-priority attribute for column importance
// Priority 1 = always shown, 2 = tablet+, 3 = desktop only
@media (max-width 480px)
  table.wikitable
  table.mwMetadata
  table.mw-html-magic-mw-data-interface
    // Hide priority-3 columns (desktop only)
    th[data-priority="3"]
    td[data-priority="3"]
    .priority-3
      display none

    // Show priority-2 on small screens too
    th[data-priority="2"]
    td[data-priority="2"]
    .priority-2
      // Reduce padding to save space
      padding 0.25em 0.5em
      font-size 0.9em

@media (max-width 360px)
  table.wikitable
  table.mwMetadata
  table.mw-html-magic-mw-data-interface
    // Even more aggressive: hide priority-2 on very small screens
    th[data-priority="2"]
    td[data-priority="2"]
    .priority-2
      display none

    // Keep only priority-1 columns visible
    th:not([data-priority])
    td:not([data-priority])
    th[data-priority="1"]
    td[data-priority="1"]
    .priority-1
      display table-cell

// Card-based mobile table transformation
// For extremely narrow viewports or user preference
@media (max-width 320px), (horizontal-viewport-segments 1)
  table.wikitable
  table.mwMetadata
    @media (pointer coarse)
      display flex
      flex-direction column

      tbody
        display flex
        flex-direction column
        gap 0.5em

      tr
        display flex
        flex-direction column
        border 1px solid $border-subtle
        border-radius 4px
        padding 0.5em
        background $base-secondary

      th
      td
        display flex
        justify-content space-between
        align-items baseline
        padding 0.25em 0.5em
        border none

        // Add label before content
        &::before
          content attr(data-label)
          font-weight 600
          color $text-muted
          margin-right 0.5em
          font-size 0.85em

// Scroll position indicator - shows current scroll position
.table-scroll-indicator
  @media (max-width 768px)
    display flex
    justify-content space-between
    padding 0.25em 0.5em
    font-size 0.75em
    color $text-muted
    background $base-secondary
    border-radius 4px 4px 0 0

    .scroll-position
      font-variant-numeric tabular-nums

// =============================================================================
// TOUCH CURSOR INDICATORS
// =============================================================================

// Change cursor to indicate interactivity on touch
@media (pointer coarse)
  a
  button
  .mw-ui-button
  input[type="checkbox"]
  input[type="radio"]
  input[type="submit"]
  input[type="button"]
    cursor pointer

// =============================================================================
// REDUCED MOTION FOR TOUCH ANIMATIONS
// =============================================================================

@media (prefers-reduced-motion reduce)
  .swipeable::after
  .horizontal-scroll::before
    display none

  pre
  code
  .mw-code
    @media (pointer coarse)
      scroll-behavior auto
      overflow-x auto
