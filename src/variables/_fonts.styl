// =============================================================================
// @FONT-FACE DESCRIPTORS - Font Loading Performance
// =============================================================================
// Browser support: 97%+
// These descriptors improve font loading performance and reduce layout shift
// - font-display: swap - prevents FOIT (Flash of Invisible Text)
// - size-adjust: adjusts glyph metrics for better fallback matching
// - ascent-override: controls ascender height
// - descent-override: controls descender height
// - line-gap-override: controls line gap

// FONT-DISPLAY VALUES
// font-display: swap - shows fallback immediately, swaps when loaded
// Best for body text where readability is key
$font-display-swap = swap

// font-display: block - shows invisible text briefly, then fallback
// Use sparingly - can harm readability
$font-display-block = block

// font-display: fallback - shows fallback, gradually reveals
// Good for headings
$font-display-fallback = fallback

// font-display: optional - browser may not download if bandwidth is low
// Good for decorative fonts
$font-display-optional = optional

// SIZE-ADJUST VALUES (for metric matching)
// Adjust fallback font metrics to match web font
// Reduces layout shift when font swaps
$size-adjust-normal = 100%
$size-adjust-reduced = 95%

// FONT OVERRIDE DESCRIPTORS
// Ascent override - controls how tall uppercase letters can be
// Values: normal, <percentage>
$ascent-override = 90%

// Descent override - controls how far descenders extend
// Values: normal, <percentage>
$descent-override = 22%

// Line gap override - controls additional space between lines
// Values: normal, <percentage>
$line-gap-override = 0%

// UTILITY CLASSES
// Font display swap utility
.font-display-swap
  font-display swap

.font-display-block
  font-display block

.font-display-fallback
  font-display fallback

.font-display-optional
  font-display optional

// @FONT-FACE RULE EXAMPLES
// Example usage:
// @font-face
//   font-family: 'Custom Font'
//   src: url('fonts/custom-font.woff2') format('woff2')
//   font-weight: 100 900
//   font-style: normal
//   font-display swap
//   size-adjust 95%
//   ascent-override 90%
//   descent-override 22%
//   line-gap-override 0%
// For variable fonts, include full weight range:
// @font-face
//   font-family: 'Variable Font'
//   src: url('fonts/variable-font.woff2') format('woff2-variations')
//   font-weight 100 900
//   font-stretch 75% 125%
//   font-display swap
//   size-adjust 95%

// FONT PRELOADING HELPERS
// Preload critical fonts for better performance
// Use in HTML: <link rel="preload" href="/fonts/font.woff2" as="font" type="font/woff2" crossorigin>

// Font loading strategy classes
.preload-font
  &::before
    content ''
    display block
    width 0
    height 0
    overflow hidden

// FONT VARIATION SETTINGS
// Variable font axes commonly used
$font-weight-axis = wght
$font-width-axis = wdth
$font-slant-axis = slnt
$font-optical-size-axis = opsz

// Optical sizing for variable fonts
// Automatically adjusts font based on size
.optical-sizing-auto
  font-optical-sizing auto

// FONT-SYNTHESIS CONTROL
// Control automatic font synthesis (bold/italic when missing)

// Disable synthetic bold/italic - use proper font files
.font-synthesis-none
  font-synthesis none

.font-synthesis-weight
  font-synthesis weight

.font-synthesis-style
  font-synthesis style

// LEGACY FONT STACKS WITH METRIC OVERRIDES
// System font stack with fallbacks optimized for metric matching
$system-font-stack = "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif

// Monospace font stack with fallbacks
$monospace-font-stack = "JetBrains Mono", "Fira Code", "Source Code Pro", Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace
